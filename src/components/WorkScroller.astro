---
import { getCollection } from "astro:content";
const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<section class="work-section">
  <p class="section-label wrap">selected work</p>
  <div class="scroller">
    {work.map((item) => (
      <a href={`/work/${item.slug}/`} class="card" style={`--accent: var(${item.data.accentVar})`}>
        <div class="preview">
          <span class="kicker">{item.data.kicker}</span>
          <span class="title">{item.data.title}</span>
          <span class="status">{item.data.status}</span>
        </div>
        <p class="highlight">{item.data.highlight}</p>
      </a>
    ))}
    <div class="scroller-pad" aria-hidden="true"></div>
  </div>
</section>

<style>
  .work-section {
    padding-top: var(--space-8);
  }
  .scroller {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 4px var(--space-3) var(--space-2);
    margin: 0 calc(var(--space-3) * -1);
    scrollbar-width: thin;
  }
  .scroller-pad {
    flex: 0 0 1px;
  }
  .card {
    flex: 0 0 300px;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .preview {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    border-radius: 10px;
    padding: var(--space-4) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 210px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover .preview {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .title {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }
  .status {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .highlight {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: 1.5;
  }
</style>
