---
/* A phone for the hero board: graphite frame, side keys, dynamic island
   and a drawn status bar, with a real screen inside. Everything scales
   with the frame's width. */
interface Props {
  src: string;
  alt?: string;
}
const { src, alt = "" } = Astro.props;
---

<span class="ps" aria-hidden={alt ? undefined : "true"}>
  <span class="ps-k ps-k1"></span><span class="ps-k ps-k2"></span><span class="ps-k ps-k3"></span>
  <span class="ps-scr">
    <span class="ps-sb">
      <b>9:41</b>
      <span class="ps-isl"></span>
      <span class="ps-sys">
        <svg viewBox="0 0 17 11"><path d="M1 8.5h2v2H1zM5 6.5h2v4H5zM9 4h2v6.5H9zM13 1.5h2v9h-2z" /></svg>
        <svg viewBox="0 0 15 11"><path d="M7.5 2.2c2.2 0 4.2.9 5.6 2.3l1-1A9.3 9.3 0 0 0 7.5.8 9.3 9.3 0 0 0 .9 3.5l1 1a7.9 7.9 0 0 1 5.6-2.3Zm0 3c1.4 0 2.6.5 3.5 1.4l1-1A6.3 6.3 0 0 0 7.5 3.8c-1.7 0-3.3.7-4.5 1.8l1 1c.9-.9 2.1-1.4 3.5-1.4Zm0 3c-.6 0-1.1.2-1.5.6l1.5 1.5L9 8.8c-.4-.4-.9-.6-1.5-.6Z" /></svg>
        <i class="ps-bt"><i></i></i>
      </span>
    </span>
    <img src={src} alt={alt} loading="eager" decoding="async" />
  </span>
</span>

<style>
  .ps {
    container-type: inline-size;
    position: relative;
    display: block;
    width: 100%;
    padding: 3.6%;
    border-radius: 17% / 8%;
    background: linear-gradient(145deg, #3a3a3c, #1c1c1e 40%, #29292b);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 0 0 3px #0e0e0f,
      0 0 0 1px rgb(0 0 0 / 0.35),
      0 30px 60px -28px rgb(20 18 12 / 0.45),
      0 10px 20px -12px rgb(20 18 12 / 0.25);
  }
  /* Side keys. */
  .ps-k {
    position: absolute;
    width: 1.6%;
    border-radius: 2px;
    background: linear-gradient(90deg, #2a2a2c, #48484a);
  }
  .ps-k1 {
    left: -1.2%;
    top: 17%;
    height: 7%;
  }
  .ps-k2 {
    left: -1.2%;
    top: 26%;
    height: 7%;
  }
  .ps-k3 {
    right: -1.2%;
    top: 22%;
    height: 11%;
    background: linear-gradient(270deg, #2a2a2c, #48484a);
  }
  .ps-scr {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 13.5% / 6.4%;
    background: #fff;
  }
  .ps-sb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 12cqi;
    padding: 1cqi 8cqi 0 10cqi;
    color: #111;
    font: 600 4.9cqi/1 -apple-system, "SF Pro Text", var(--font-sans);
    letter-spacing: -0.01em;
  }
  .ps-isl {
    position: absolute;
    left: 50%;
    top: 3.2cqi;
    width: 26cqi;
    height: 7.6cqi;
    border-radius: 99px;
    background: #050505;
    transform: translateX(-50%);
  }
  .ps-sys {
    display: inline-flex;
    align-items: center;
    gap: 1.6cqi;
  }
  .ps-sys svg {
    width: 5.4cqi;
    height: auto;
    fill: #111;
  }
  .ps-bt {
    position: relative;
    display: block;
    width: 7.4cqi;
    height: 3.6cqi;
    padding: 0.5cqi;
    border: 0.5cqi solid rgb(0 0 0 / 0.4);
    border-radius: 1.2cqi;
  }
  .ps-bt i {
    display: block;
    width: 78%;
    height: 100%;
    border-radius: 0.5cqi;
    background: #111;
  }
  .ps img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
