---
/* Clicker, reduced to what the aging view says: how much is owed, how old
   it is, and the bills behind it. Figures from the product's demo data.
   Sized in em off the container width, so it reads the same at any size. */
const kpis = [
  ["Outstanding", "311"],
  ["Overdue", "278"],
  ["Collected this month", "1.4"],
];
// Rs crore per age bucket, youngest first.
const buckets = [
  ["Not due", 34.2],
  ["0–30", 21.2],
  ["31–60", 20.6],
  ["61–90", 8.5],
  ["91–180", 55.4],
  ["180+", 174],
] as const;
const rows = [
  ["BILL-2026-00092", "Federal Steel Corp.", "4,68,44,034"],
  ["BILL-2026-00041", "National Archives", "3,25,84,205"],
  ["BILL-2026-00008", "Federal Railways", "2,77,84,277"],
  ["BILL-2026-00027", "Federal Revenue Co.", "4,63,11,697"],
  ["BILL-2026-00009", "Federal Housing Auth.", "2,64,99,638"],
];
---

<span class="ck" aria-hidden="true">
  <span class="ck-in">
    <span class="ck-rail">
      <i class="ck-logo"></i>
      <i></i><i class="on"></i><i></i><i></i>
    </span>
    <span class="ck-main">
      <span class="ck-head">
        <span>
          <small>Billing / Bills</small>
          <b>Aging <em>1,444 bills</em></b>
        </span>
        <span class="ck-btn">+ New bill</span>
      </span>
      <span class="ck-kpis">
        {kpis.map(([k, v], i) => (
          <span class:list={["ck-kpi", { warn: i === 1 }]}>
            <small>{k}</small>
            <b><em>Rs</em> {v} <em>crore</em></b>
          </span>
        ))}
      </span>
      <span class="ck-age">
        <span class="ck-bar">
          {buckets.map(([, v], i) => <i style={`flex:${v};--k:${i}`}></i>)}
        </span>
        <span class="ck-keys">
          {buckets.map(([k, v], i) => (
            <span style={`--k:${i}`}><i></i>{k}<b>{v}</b></span>
          ))}
        </span>
      </span>
      <span class="ck-rows">
        {rows.map(([n, c, a]) => (
          <span class="ck-row"><code>{n}</code><span>{c}</span><b>Rs {a}</b><em>Overdue</em></span>
        ))}
      </span>
    </span>
  </span>
</span>

<style>
  .ck {
    container-type: inline-size;
    display: block;
    background: #fff;
    color: #1c1b22;
  }
  .ck-in {
    display: flex;
    font-size: calc(100cqi / 58);
    font-family: var(--font-sans);
    line-height: 1.3;
  }
  .ck-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1em;
    width: 4em;
    padding: 1.4em 0;
    border-right: 1px solid #efeef3;
    background: #fbfbfc;
  }
  .ck-rail i {
    width: 1.3em;
    height: 1.3em;
    border-radius: 0.35em;
    background: #e9e8ee;
  }
  .ck-rail .on {
    background: #ded9fb;
    box-shadow: 0 0 0 0.35em #f0edfe;
  }
  .ck-rail .ck-logo {
    margin-bottom: 0.6em;
    border-radius: 0.45em;
    background: #5b4fd6;
  }
  .ck-main {
    flex: 1;
    min-width: 0;
    padding: 1.6em 2em 0;
  }
  .ck-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .ck-head small {
    display: block;
    margin-bottom: 0.3em;
    font-size: 0.85em;
    color: #8d8b96;
  }
  .ck-head b {
    font-size: 1.7em;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .ck-head em {
    margin-left: 0.3em;
    font-size: 0.5em;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0;
    color: #8d8b96;
  }
  .ck-btn {
    padding: 0.55em 0.9em;
    border-radius: 0.5em;
    background: #5b4fd6;
    color: #fff;
    font-size: 0.9em;
    font-weight: 600;
  }
  .ck-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1.4em;
    border: 1px solid #ecebf0;
    border-radius: 0.7em;
  }
  .ck-kpi {
    display: grid;
    gap: 0.35em;
    padding: 0.9em 1.1em;
  }
  .ck-kpi + .ck-kpi {
    border-left: 1px solid #ecebf0;
  }
  .ck-kpi small {
    font-size: 0.85em;
    color: #8d8b96;
  }
  .ck-kpi b {
    font-size: 1.35em;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
  }
  .ck-kpi em {
    font-size: 0.62em;
    font-style: normal;
    font-weight: 500;
    color: #8d8b96;
  }
  .ck-kpi.warn b {
    color: #b42318;
  }
  .ck-age {
    display: block;
    margin-top: 1.5em;
  }
  .ck-bar {
    display: flex;
    gap: 0.2em;
    height: 0.75em;
  }
  .ck-bar i,
  .ck-keys i {
    border-radius: 0.2em;
    background: color-mix(in srgb, #5b4fd6 calc(18% + var(--k) * 16%), #efedfb);
  }
  .ck-keys {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.4em;
    margin-top: 0.8em;
  }
  .ck-keys span {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 0.4em;
    font-size: 0.8em;
    color: #8d8b96;
    white-space: nowrap;
  }
  .ck-keys i {
    width: 0.65em;
    height: 0.65em;
  }
  .ck-keys b {
    grid-column: 2;
    font-size: 1.15em;
    font-weight: 600;
    color: #1c1b22;
    font-variant-numeric: tabular-nums;
  }
  .ck-rows {
    display: block;
    margin-top: 1.5em;
    border-top: 1px solid #ecebf0;
  }
  .ck-row {
    display: grid;
    grid-template-columns: 9.5em 1fr auto auto;
    align-items: center;
    gap: 1.2em;
    height: 2.7em;
    border-bottom: 1px solid #f2f1f5;
    font-size: 0.92em;
  }
  .ck-row code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: #55535e;
  }
  .ck-row span {
    color: #55535e;
  }
  .ck-row b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .ck-row em {
    padding: 0.15em 0.55em;
    border-radius: 99px;
    background: #fef0ee;
    color: #b42318;
    font-size: 0.85em;
    font-style: normal;
    font-weight: 500;
  }
</style>
