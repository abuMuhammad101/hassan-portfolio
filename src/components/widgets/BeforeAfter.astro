---
/* Before: the generic car-rental template an agent produced.
   After: the same backend reshaped into a pilgrim transport service.
   Re-created with stand-in brands, illustrated stand-ins for photos and
   sample content. */
import BrowserFrame from "../BrowserFrame.astro";
import Icon from "../Icon.astro";
import Vehicle from "./pilgrim/Vehicle.astro";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/cormorant-garamond/latin-700.css";
// Three ways people ride; each sets the booking card.
const routes = [
  { k: "airport", t: "Airport", from: "Jeddah Airport (JED)", to: "Hotel in Makkah", when: "Fri 14 Mar, 02:40", fare: 260, time: "about 1 h 20 min" },
  { k: "cities", t: "Between cities", from: "Hotel in Makkah", to: "Hotel in Madinah", when: "Sun 16 Mar, 09:00", fare: 520, time: "about 4 h 30 min" },
  { k: "ziyarat", t: "Ziyarat", from: "Hotel in Madinah", to: "Quba, Uhud, Qiblatayn", when: "Mon 17 Mar, 07:30", fare: 300, time: "half a day, driver waits" },
];
const fleet = [
  { n: "Sedan", v: "sedan", p: 3, b: 2, f: 180 },
  { n: "Family MPV", v: "mpv", p: 7, b: 5, f: 260 },
  { n: "Full-size SUV", v: "suv", p: 7, b: 6, f: 320 },
  { n: "Group van", v: "van", p: 10, b: 10, f: 380 },
];
const reasons = [
  { i: "seal-check", t: "Registered for pilgrim travel", d: "Every vehicle and driver is licensed for Umrah and Hajj transport." },
  { i: "airplane-landing", t: "We watch your flight", d: "Late landing? The driver waits, and the first hour is free." },
  { i: "whatsapp-logo", t: "Updates on WhatsApp", d: "Driver, car and plate the night before. No app to install." },
];
---


<div class="ba" data-ba>
  <div class="switch" role="group" aria-label="Show the site before or after the redesign" data-chips>
    <button type="button" data-show="before" aria-pressed="false">Before</button>
    <button type="button" data-show="after" aria-pressed="true">After</button>
  </div>

  <BrowserFrame address="pilgrimdrivers.example" label="Re-created pilgrim transport site">
    <div class="fit">
      <!-- BEFORE: generic rental template -->
      <div class="pg before" data-before hidden>
        <nav class="b-nav">
          <span class="b-logo"><Icon name="car-profile" size={20} weight="fill" />RENT<b>CAR</b>PRO</span>
          <span class="b-links"><b>Home</b><span>Fleet</span><span>About</span><span>Contact</span></span>
          <span class="b-end"><span>Sign In</span><span class="b-btn">Get Started</span></span>
        </nav>
        <div class="b-hero">
          <div>
            <span class="b-chip"><Icon name="lightning" size={12} />Premium Car Rental Experience</span>
            <h5>Drive Your <em>Dreams</em></h5>
            <p>Experience luxury and reliability with our premium fleet. From business meetings to weekend adventures, find the perfect vehicle for every journey.</p>
            <div class="b-ctas"><span class="b-btn"><Icon name="arrow-right" size={13} />Browse Fleet</span><span class="b-ghost">Learn More</span></div>
            <div class="b-stats"><span><b>1000+</b>Happy Customers</span><span><b>150+</b>Premium Cars</span><span><b>24/7</b>Support</span></div>
          </div>
          <div class="b-iso" aria-hidden="true"><div class="lot">{Array.from({ length: 8 }).map((_, i) => <i style={`--h:${[8, 220, 0, 210, 40, 0, 215, 30][i]}`}></i>)}</div></div>
        </div>
        <div class="b-fleet">
          <aside><span class="b-in"><Icon name="magnifying-glass" size={12} />Search by make, model…</span><span class="b-btn wide">Search Fleet</span><small>Vehicle make</small><span class="b-in">All Makes</span><small>Fuel type</small><span class="b-in">All Fuel Types</span><small>Daily rate</small><span class="b-in">$ Min — $ Max</span></aside>
          <div class="b-cards">
            <div class="b-card"><span class="b-price">$75/day</span><div class="art a-car"><Vehicle kind="sedan" paint="#9aa3ad" /></div><b>Sedan 2021</b><small><Icon name="gas-pump" size={11} />Gasoline · GPS included</small></div>
            <div class="b-card"><span class="b-price">$85/day</span><div class="art a-car"><Vehicle kind="suv" paint="#b8452f" /></div><b>SUV 2020</b><small><Icon name="gas-pump" size={11} />Gasoline · Insurance included</small></div>
          </div>
        </div>
        <p class="note"><Icon name="info" size={14} />A generic rental template: daily rates, fuel type, model year, "Drive Your Dreams". None of it helps a pilgrim choose a ride from the airport to the Haram.</p>
      </div>

      <!-- AFTER: pilgrim transport, kept to what a family needs -->
      <div class="pg after" data-after>
        <nav class="a-nav">
          <span class="a-logo"><i aria-hidden="true"></i>Pilgrim Drivers</span>
          <span class="a-links"><b>Book</b><span>Fleet</span><span>Ziyarat</span><span>Help</span></span>
          <span class="a-end"><span class="lang">EN</span><span class="a-btn">My booking</span></span>
        </nav>

        <section class="a-hero">
          <div class="a-copy">
            <h5>From the airport to the Haram, booked in a minute.</h5>
            <p>A fixed fare, a driver who knows the way, and updates on WhatsApp. For families on Umrah and Hajj.</p>
            <ul class="a-trust">
              <li><Icon name="seal-check" size={13} />Licensed for Umrah and Hajj</li>
              <li><Icon name="translate" size={13} />Arabic, English, Urdu</li>
            </ul>
          </div>

          <div class="bk" data-book data-route="airport">
            <div class="bk-tabs" role="tablist" aria-label="Kind of ride">
              {routes.map((r, i) => <button type="button" role="tab" data-route-btn={r.k} aria-selected={i === 0 ? "true" : "false"}>{r.t}</button>)}
            </div>
            {routes.map((r, i) => (
              <div class="bk-body" data-route-pane={r.k} hidden={i !== 0}>
                <div class="bk-path">
                  <span class="dot" aria-hidden="true"></span>
                  <label><small>From</small><b>{r.from}</b></label>
                  <span class="dot end" aria-hidden="true"></span>
                  <label><small>To</small><b>{r.to}</b></label>
                </div>
                <div class="bk-two">
                  <label><small>When</small><b>{r.when}</b></label>
                  <label><small>Travellers</small><b>7 people, 6 bags</b></label>
                </div>
                <div class="bk-fare">
                  <span><small>Fixed fare, Family MPV</small><b>SAR {r.fare}</b></span>
                  <span class="bk-time">{r.time}</span>
                </div>
              </div>
            ))}
            <button type="button" class="bk-go" data-next>Continue</button>
          </div>
        </section>

        <section class="sec">
          <div class="sec-h"><h6>Choose by people and bags</h6><span class="link">All vehicles</span></div>
          <div class="cars">
            {fleet.map((f, i) => (
              <article class:list={["car", { pick: i === 1 }]}>
                <div class="art"><Vehicle kind={f.v as any} /></div>
                <span class="car-n"><b>{f.n}</b><span>SAR {f.f}</span></span>
                <span class="cap"><span><Icon name="user" size={12} />{f.p}</span><span><Icon name="suitcase-rolling" size={12} />{f.b}</span></span>
              </article>
            ))}
          </div>
        </section>

        <section class="sec why">
          <ol class="reasons">
            {reasons.map((r, i) => (
              <li data-reason={i} class={i === 0 ? "open" : ""}>
                <button type="button" data-open={i} aria-expanded={i === 0 ? "true" : "false"}>
                  <span class="ri"><Icon name={r.i} size={16} /></span><b>{r.t}</b>
                </button>
                <p>{r.d}</p>
              </li>
            ))}
          </ol>
          <div class="wa" aria-hidden="true">
            <p class="wa-h"><span class="wa-av"><i></i></span><span><b>Pilgrim Drivers</b><small>WhatsApp</small></span></p>
            <p class="bub">Assalamu alaikum. Your driver <b>Yusuf</b> will meet you at <b>Gate 3</b> with your name on a sign.</p>
            <p class="bub">White Hiace, plate <b>4721 KSA</b>.</p>
            <p class="bub me">JazakAllah khair</p>
          </div>
        </section>

        <section class="sec quote">
          <p class="q">“Our flight landed at 3 am and the driver was already at the gate with our name.”</p>
          <p class="q-who">Family of six, Umrah · <span>sample review</span></p>
        </section>

        <p class="note ok"><Icon name="check-circle" size={14} />Same backend and data. Rides by route, vehicles by people and bags, a fixed fare up front, and updates where pilgrims already are.</p>
      </div>
    </div>
  </BrowserFrame>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ba]").forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const before = q("[data-before]"), after = q("[data-after]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-show]")];
    buttons.forEach((b) => b.addEventListener("click", () => {
      const showBefore = b.dataset.show === "before";
      before.hidden = !showBefore; after.hidden = showBefore;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    }));

    // Booking card: the kind of ride sets the route and the fare.
    const book = q("[data-book]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-route-btn]")];
    const panes = [...root.querySelectorAll<HTMLElement>("[data-route-pane]")];
    const setRoute = (k: string) => {
      book.dataset.route = k;
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.routeBtn === k)));
      panes.forEach((p) => (p.hidden = p.dataset.routePane !== k));
    };
    tabs.forEach((t) => t.addEventListener("click", () => setRoute(t.dataset.routeBtn!)));
    // "Continue" walks through the kinds of ride, so the story can show each.
    q("[data-next]").addEventListener("click", () => {
      const i = tabs.findIndex((t) => t.dataset.routeBtn === book.dataset.route);
      setRoute(tabs[(i + 1) % tabs.length].dataset.routeBtn!);
    });

    // Reasons accordion
    const items = [...root.querySelectorAll<HTMLElement>("[data-reason]")];
    root.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((b, i) => b.addEventListener("click", () => {
      items.forEach((it, j) => { it.classList.toggle("open", j === i); it.querySelector("button")!.setAttribute("aria-expanded", String(j === i)); });
    }));

  });
</script>

<style>
  .switch { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--bg-sunk); border: 1px solid var(--rule); margin-bottom: 14px; }
  .switch button { border: 0; background: none; font: inherit; font-weight: 600; font-size: var(--text-sm); padding: 6px 16px; border-radius: 999px; color: var(--ink-muted); cursor: pointer; }
  .switch [aria-pressed="true"] { background: var(--bg-raised); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
  .ba { container-type: inline-size; }
  .fit { width: 100%; }
  .pg { font: 13px/1.5 var(--font-sans); background: #fff; }
  .pg[hidden] { display: none; }
  .note { display: flex; align-items: center; gap: 8px; margin: 0; padding: 12px 26px; background: #fff4e5; color: #7a4a0c; font-size: 12.5px; }
  .note.ok { background: #e7f2ed; color: #0b4a2c; }

  /* Illustrated stand-ins for photography */
  .art { position: relative; overflow: hidden; }
  .a-car { display: grid; align-items: end; padding: 14px 12px 8px; background: linear-gradient(180deg, #f4f2ec 0%, #ebe7de 70%, #ddd7ca 100%); }
  .a-car :global(svg) { max-width: 92%; margin: 0 auto; }

  /* BEFORE */
  .before { --or: #f2610d; color: #1c2230; font-family: Poppins, Inter, system-ui, sans-serif; }
  .b-nav { display: flex; align-items: center; gap: 30px; padding: 12px 26px; border-bottom: 1px solid #eee; }
  .b-logo { display: flex; align-items: center; gap: 6px; font-weight: 800; letter-spacing: 0.02em; }
  .b-logo b { color: var(--or); }
  .b-links { display: flex; gap: 22px; margin: 0 auto; color: #444; } .b-links b { color: var(--or); font-weight: 500; }
  .b-end { display: flex; align-items: center; gap: 18px; }
  .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 8px; background: linear-gradient(180deg, #ff7a1f, #e85a06); color: #fff; font-weight: 600; box-shadow: 0 6px 14px -6px #e85a06; }
  .b-btn.wide { justify-content: center; }
  .b-ghost { padding: 8px 14px; border-radius: 8px; border: 1px solid #ccd; }
  .b-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 34px 26px 26px; background: radial-gradient(60% 80% at 80% 50%, #ffe8d9, #fff 70%); }
  .b-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 11px; border-radius: 999px; border: 1px solid #fbc9a8; background: #fff3ea; color: #b04a0a; font-size: 11.5px; }
  .b-hero h5 { margin: 16px 0 10px; font-size: 40px; line-height: 1.05; font-weight: 700; letter-spacing: -0.02em; }
  .b-hero em { font-style: normal; color: var(--or); }
  .b-hero p { margin: 0 0 18px; color: #555; max-width: 400px; }
  .b-ctas { display: flex; gap: 10px; }
  .b-stats { display: flex; gap: 46px; margin-top: 22px; padding-top: 16px; border-top: 1px solid #eee; }
  .b-stats span { display: grid; text-align: center; color: #555; font-size: 11px; } .b-stats b { font-size: 24px; color: var(--or); }
  .b-iso { display: grid; place-items: center; }
  .lot { display: grid; grid-template-columns: repeat(4, 40px); gap: 12px 14px; padding: 26px; background: #2b2b2e; border-bottom: 10px solid var(--or); transform: rotateX(55deg) rotateZ(-40deg); box-shadow: 30px 30px 0 -10px #1d1d1f; }
  .lot i { height: 62px; border-radius: 10px; background: hsl(var(--h) 25% 62%); box-shadow: inset 0 -8px 0 rgb(0 0 0 / 0.2), 0 0 0 3px #e35c0b; }
  .b-fleet { display: grid; grid-template-columns: 200px 1fr; gap: 16px; padding: 18px 26px; background: #f5f6f8; }
  .b-fleet aside { display: grid; gap: 7px; align-content: start; padding: 12px; border-radius: 12px; background: #fff; box-shadow: 0 1px 4px rgb(0 0 0 / 0.08); }
  .b-fleet small { color: #555; margin-top: 4px; }
  .b-in { display: flex; align-items: center; gap: 6px; padding: 6px 9px; border-radius: 7px; border: 1px solid #ddd; color: #777; font-size: 11.5px; }
  .b-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .b-card { position: relative; display: grid; align-content: start; gap: 4px; padding-bottom: 12px; border-radius: 12px; background: #fff; overflow: hidden; box-shadow: 0 1px 4px rgb(0 0 0 / 0.08); }
  .b-card .art { height: 120px; padding: 16px 22px 8px; display: grid; align-items: end; }
  .b-cards { align-items: start; } .b-card b, .b-card small { padding: 0 12px; } .b-card b { font-size: 15px; }
  .b-card small { display: flex; align-items: center; gap: 4px; color: #777; }
  .b-price { position: absolute; top: 10px; right: 10px; z-index: 2; padding: 4px 9px; border-radius: 7px; background: var(--or); color: #fff; font-weight: 700; font-size: 12px; }

  /* AFTER: one green, one warm neutral, hairlines, nothing decorative. */
  .after { --g9: #0f3d2a; --g6: #2d7a55; --g1: #edf4ef; --sand: #f7f5f0; --ink: #1c1d1b; --ink3: #55574f; --ink4: #8a8c84; --line: #e8e6df; --disp: "Cormorant Garamond", Georgia, serif; color: var(--ink); }
  .a-nav { display: flex; align-items: center; gap: 16px; height: 52px; padding: 0 28px; border-bottom: 1px solid var(--line); }
  .a-logo { display: flex; align-items: center; gap: 8px; font: 700 18px var(--disp); color: var(--g9); }
  .a-logo i { width: 18px; height: 18px; border-radius: 5px; background: var(--g9); box-shadow: inset 0 0 0 5px var(--g9), inset 0 0 0 9px #fff; }
  .a-links { display: flex; gap: 24px; margin: 0 auto; color: var(--ink3); font-size: 12.5px; }
  .a-links b { color: var(--ink); font-weight: 600; }
  .a-end { display: flex; align-items: center; gap: 16px; font-size: 12.5px; color: var(--ink3); }
  .a-btn { display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border-radius: 8px; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); font-weight: 550; }

  .a-hero { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: center; padding: 44px 28px 40px; }
  h5 { margin: 0; font: 600 36px/1.05 var(--disp); letter-spacing: -0.01em; color: var(--g9); max-width: 16ch; }
  .a-copy p { max-width: 38ch; margin: 14px 0 0; color: var(--ink3); font-size: 14px; line-height: 1.55; }
  .a-trust { display: flex; gap: 18px; margin: 22px 0 0; padding: 0; list-style: none; font-size: 12px; color: var(--ink4); }
  .a-trust li { display: inline-flex; align-items: center; gap: 5px; }
  .a-trust :global(svg) { color: var(--g6); }

  .bk { display: grid; gap: 10px; padding: 12px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 24px 40px -28px rgb(15 61 42 / 0.35); }
  .bk-tabs { display: grid; grid-template-columns: repeat(3, 1fr); padding: 3px; border-radius: 10px; background: var(--sand); }
  .bk-tabs button { height: 28px; border: 0; border-radius: 8px; background: none; font: inherit; font-size: 12px; color: var(--ink3); cursor: pointer; }
  .bk-tabs [aria-selected="true"] { background: #fff; color: var(--ink); font-weight: 600; box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
  .bk-body { display: grid; gap: 8px; animation: fade 0.35s ease; }
  .bk-body[hidden] { display: none; }
  .bk label { display: grid; gap: 1px; min-width: 0; }
  .bk small { font-size: 11px; color: var(--ink4); }
  .bk label b { font-weight: 550; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bk-path { position: relative; display: grid; grid-template-columns: 14px 1fr; gap: 8px 10px; align-items: center; padding: 10px 12px; border-radius: 12px; box-shadow: inset 0 0 0 1px var(--line); }
  .bk-path::before { content: ""; position: absolute; left: 18px; top: 28px; bottom: 28px; border-left: 1px dashed #c9c7bf; }
  .dot { width: 8px; height: 8px; margin-left: 3px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--g9); background: #fff; }
  .dot.end { background: var(--g9); }
  .bk-two { display: grid; grid-template-columns: 1fr 1fr; }
  .bk-two label { padding: 10px 12px; box-shadow: inset 0 0 0 1px var(--line); }
  .bk-two label:first-child { border-radius: 12px 0 0 12px; }
  .bk-two label:last-child { border-radius: 0 12px 12px 0; margin-left: -1px; }
  .bk-fare { display: flex; align-items: end; justify-content: space-between; padding: 4px 2px 0; }
  .bk-fare span:first-child { display: grid; }
  .bk-fare b { font-size: 20px; font-weight: 650; letter-spacing: -0.01em; color: var(--g9); }
  .bk-time { font-size: 11.5px; color: var(--ink4); }
  .bk-go { height: 40px; border: 0; border-radius: 10px; background: var(--g9); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .bk-go:focus-visible, .bk-tabs button:focus-visible, .why button:focus-visible { outline: 2px solid var(--g6); outline-offset: 2px; }
  @keyframes fade { from { opacity: 0; transform: translateY(3px); } }

  .sec { padding: 28px 28px 30px; border-top: 1px solid var(--line); }
  .sec-h { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16px; }
  h6 { margin: 0; font: 600 24px/1.1 var(--disp); color: var(--g9); }
  .link { font-size: 12.5px; color: var(--ink3); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .cars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .car { display: grid; gap: 8px; padding: 8px 8px 10px; border-radius: 14px; box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow 0.2s; }
  .car:hover, .car.pick { box-shadow: inset 0 0 0 1.5px var(--g9); }
  .car .art { display: grid; align-items: end; height: 84px; padding: 10px 14px 6px; border-radius: 9px; background: var(--sand); }
  .car .art :global(svg) { max-width: 100%; }
  .car-n { display: flex; justify-content: space-between; align-items: baseline; padding: 0 4px; }
  .car-n b { font-weight: 600; }
  .car-n span { font-size: 12px; color: var(--ink3); }
  .cap { display: flex; gap: 12px; padding: 0 4px; font-size: 11.5px; color: var(--ink4); }
  .cap span { display: inline-flex; align-items: center; gap: 4px; }

  .why { display: grid; grid-template-columns: 1fr 260px; gap: 32px; align-items: center; background: var(--sand); }
  .reasons { list-style: none; display: grid; margin: 0; padding: 0; }
  .reasons li { border-bottom: 1px solid var(--line); }
  .reasons li:first-child { border-top: 1px solid var(--line); }
  .why button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 0; border: 0; background: none; font: inherit; text-align: left; color: var(--ink3); cursor: pointer; }
  .why button b { font-weight: 550; }
  .ri { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: #fff; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink4); }
  .reasons li.open button { color: var(--ink); }
  .reasons li.open .ri { background: var(--g9); color: #fff; box-shadow: none; }
  .reasons p { display: none; margin: -4px 0 12px 38px; color: var(--ink3); max-width: 44ch; }
  .reasons li.open p { display: block; animation: fade 0.35s ease; }
  .wa { display: grid; gap: 5px; padding: 12px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px var(--line); font-size: 12px; }
  .wa p { margin: 0; }
  .wa-h { display: flex; align-items: center; gap: 8px; padding-bottom: 8px; margin-bottom: 2px; border-bottom: 1px solid var(--line); }
  .wa-h span:last-child { display: grid; line-height: 1.25; } .wa-h small { color: var(--ink4); font-size: 11px; }
  .wa-av { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--g9); }
