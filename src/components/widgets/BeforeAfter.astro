---
/* Before/after of one page: same content, different shape. Illustrative re-creation. */
import BrowserFrame from "../BrowserFrame.astro";
const sections = ["Where to?", "Choose a vehicle", "Why travel with us", "What travellers say", "Questions"];
---

<div class="ba" data-ba>
  <BrowserFrame address="pilgrim-transport.example" label="Re-created booking page, before and after">
    <div class="stage">
      <div class="pane after" aria-label="After">
        <span class="badge">After</span>
        <p class="a-kicker">Private drivers for your pilgrimage</p>
        <p class="a-title">Where would you like to go?</p>
        <div class="a-search">
          <span>Destination</span><span>Date</span><span>Vehicle</span><b>Check availability</b>
        </div>
        <div class="a-grid">
          <div><i></i>By destination</div>
          <div><i></i>By vehicle</div>
          <div><i></i>Why travel with us</div>
        </div>
        <p class="a-faq">What travellers say ›</p>
        <p class="a-faq">Questions and answers ›</p>
      </div>
      <div class="pane before" aria-label="Before" data-before hidden>
        <span class="badge">Before</span>
        {sections.map((s) => (
          <div class="b-block">
            <p>{s}</p>
            <i></i><i></i>
          </div>
        ))}
      </div>
    </div>
  </BrowserFrame>
  <div class="control" role="group" aria-label="Show before or after">
    <button type="button" data-show="before" aria-pressed="false">Before</button>
    <button type="button" data-show="after" aria-pressed="true">After</button>
    <span>Same content, different shape</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ba]").forEach((root) => {
    const before = root.querySelector<HTMLElement>("[data-before]")!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-show]")];
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        before.hidden = b.dataset.show !== "before";
        buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      })
    );
  });
</script>

<style>
  .stage {
    position: relative;
    height: 340px;
    overflow: hidden;
    font-size: var(--text-sm);
  }
  .pane {
    position: absolute;
    inset: 0;
    padding: 20px;
    background: var(--bg-raised);
  }
  .before {
    background: var(--bg-raised);
    z-index: 1;
  }
  .badge {
    position: absolute;
    top: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1px 6px;
    z-index: 1;
  }
  .badge { right: 10px; }
  .b-block {
    text-align: center;
    margin: 14px auto 0;
    max-width: 300px;
  }
  .b-block p {
    margin: 0 0 6px;
    font-weight: 600;
    color: var(--ink);
  }
  .b-block i {
    display: block;
    height: 6px;
    margin: 4px auto;
    width: 80%;
    border-radius: 3px;
    background: var(--rule);
  }
  .a-kicker {
    margin: 18px 0 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
  }
  .a-title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    color: var(--ink);
  }
  .a-search {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .a-search span,
  .a-search b {
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 6px 10px;
    color: var(--ink-secondary);
    font-weight: 400;
  }
  .a-search b {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .a-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }
  .a-grid div {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 8px;
    color: var(--ink);
    font-size: 12px;
  }
  .a-grid i {
    display: block;
    height: 34px;
    border-radius: 5px;
    background: var(--rule);
    margin-bottom: 6px;
  }
  .a-quote {
    margin: 0 0 6px;
    color: var(--ink);
  }
  .a-quote span,
  .a-faq {
    color: var(--ink-muted);
    font-size: 12px;
  }
  .a-faq {
    margin: 0;
  }
  .control {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }
  .control button {
    font: inherit;
    font-size: var(--text-sm);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-raised);
    color: var(--ink);
    cursor: pointer;
  }
  .control button[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .control span {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  @media (max-width: 480px) {
    .a-grid {
      grid-template-columns: 1fr 1fr;
    }
    .a-grid div:last-child {
      display: none;
    }
  }
</style>
