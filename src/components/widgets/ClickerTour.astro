---
/* Clicker on a quiet canvas: the real app in a window, and the few lines of
   model code that drew each screen typed into an editor beside it. The
   window's tabs are the chapters. Screens are captured from the running
   product with its demo seed. */
import Icon from "../Icon.astro";
import "../../styles/story.css";

type Ch = { tab: string; title: string; note: string; path: string[]; code: string[]; shot: string; dark?: boolean };

const chapters: Ch[] = [
  {
    tab: "Aging",
    title: "The schema draws the list",
    note: "A few lines declare the Aging view. Nobody drew this screen.",
    path: ["billing", "models.py", "Bill.Schema"],
    code: [
      "views = [{",
      "    'key': 'aging',",
      "    'filters': ['state:in:posted',",
      "                'balance:gte:0.01'],",
      "    'group_by': 'days_overdue',",
      "    'ordering': '-balance',",
      "}]",
    ],
    shot: "w-aging",
  },
  {
    tab: "Bill",
    title: "Peek, don't navigate",
    note: "A row opens beside the list. The same form renderer, unaware it's in a drawer.",
    path: ["records", "open.ts"],
    code: [
      "openRecord('billing.bill', id, {",
      "  surface: 'peek',",
      "})",
      "",
      "// a new container is one registration",
      "registerSurface('peek', PeekDrawer)",
    ],
    shot: "w-bill-peek",
  },
  {
    tab: "Recovery",
    title: "Workflow, declared",
    note: "The recovery path and the money owed are declarations too.",
    path: ["water", "models.py", "RecoveryCase.Schema"],
    code: [
      "workflow = {",
      "    'field': 'state',",
      "    'path': ['open', 'notice_1',",
      "             'notice_2', 'legal',",
      "             'instalment', 'settled'],",
      "}",
    ],
    shot: "w-recovery",
  },
  {
    tab: "Jobs",
    title: "Another business, same engine",
    note: "A port clearing agency on the same renderers, with no frontend changes.",
    path: ["clearance", "models.py", "Job.Schema"],
    code: [
      "views = [{",
      "    'key': 'by_stage',",
      "    'group_by': 'state',",
      "    # money and risk stay open",
      "    'collapsed': ['booked', 'gate_out'],",
      "}]",
    ],
    shot: "c-stages",
  },
  {
    tab: "At risk",
    title: "Risk rises to the top",
    note: "Containers costing money by the day, ordered by the next deadline.",
    path: ["clearance", "models.py", "Job.Schema"],
    code: [
      "{",
      "    'key': 'at_risk',",
      "    'filters': ['demurrage_status:in:",
      "                 soon,urgent,accruing'],",
      "    'ordering': 'demurrage_next_deadline',",
      "}",
    ],
    shot: "c-risk",
  },
  {
    tab: "Job",
    title: "Light and dark, one file",
    note: "Every colour is a token, so dark mode costs nothing per screen.",
    path: ["tokens.css"],
    code: [
      ":root {",
      "  --accent: #4a3fcf;",
      "}",
      ":root[data-theme='dark'] {",
      "  --accent: #8991ff;",
      "}",
    ],
    shot: "c-job",
    dark: true,
  },
];

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const hl = (line: string) => {
  if (!line.trim()) return "&nbsp;";
  const m = line.match(/^(\s*)(#|\/\/)(.*)$/);
  if (m) return `${m[1]}<span class="c">${esc(m[2] + m[3])}</span>`;
  return esc(line).replace(
    /('[^']*')|(#[0-9a-fA-F]{6})|(--[a-z-]+)|\b(openRecord|registerSurface)\b/g,
    (t, s, n, v) => `<span class="${s ? "s" : n ? "n" : v ? "v" : "f"}">${t}</span>`,
  );
};
---

<div class="ck" data-ck data-mode="light" data-playing="false">
  <div class="canvas">
    <span class="h tl" aria-hidden="true"></span><span class="h tr" aria-hidden="true"></span>
    <span class="h bl" aria-hidden="true"></span><span class="h br" aria-hidden="true"></span>

    <div class="win app">
      <div class="bar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <ol class="tabs" aria-label="Chapters">
          {chapters.map((c, i) => (
            <li data-ch class:list={[{ on: i === 0 }]}>
              <button type="button"><Icon name="file" size={13} />{c.tab}</button>
            </li>
          ))}
        </ol>
        <button type="button" class="mode" data-mode aria-pressed="false" aria-label="Dark mode">
          <span class="i-moon"><Icon name="moon" size={14} /></span><span class="i-sun"><Icon name="sun" size={14} /></span>
        </button>
      </div>
      <div class="screen">
        {chapters.map((c, i) => (
          <figure class:list={["shot", { on: i === 0, auto: c.dark }]} data-shot={i}>
            <img class="lt" src={`/media/clicker/${c.shot}-light.webp`} alt={`Clicker, ${c.title}`} width="1600" height="1000" loading={i < 2 ? "eager" : "lazy"} decoding="async" />
            <img class="dk" src={`/media/clicker/${c.shot}-dark.webp`} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </div>

    <div class="win code" aria-label="The code behind the screen">
      <div class="bar small">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="crumbs">
        {chapters.map((c, i) => (
          <p class:list={["path", { on: i === 0 }]} data-shot={i}>{c.path.map((p, k) => <>{k > 0 && <span class="sep">›</span>}<span>{p}</span></>)}</p>
        ))}
      </div>
      <div class="body">
        {chapters.map((c, i) => (
          <pre class:list={["src", { on: i === 0 }]} data-shot={i}><code>{c.code.map((l, li) => (
            <span class="ln" style={`--l:${li}`}><em>{li + 1}</em><span set:html={hl(l)} /></span>
          ))}</code></pre>
        ))}
      </div>
    </div>
  </div>

  <div class="foot">
    <button type="button" class="s-play" data-play aria-label="Play the story">
      <span class="knob">
        <svg viewBox="0 0 42 42" aria-hidden="true"><circle class="track" cx="21" cy="21" r="19" /><circle class="prog" cx="21" cy="21" r="19" pathLength="100" /></svg>
        <span class="icon" aria-hidden="true"><i></i><i></i></span>
      </span>
    </button>
    <div class="caps" aria-live="polite">
      {chapters.map((c, i) => <p class:list={["cap", { on: i === 0 }]} data-shot={i}><b>{c.title}.</b> {c.note}</p>)}
    </div>
  </div>
</div>

<script>
  import { initStory } from "../../scripts/story";
  document.querySelectorAll<HTMLElement>("[data-ck]").forEach((root) => {
    initStory(root, { dur: 6000 });
    const mode = root.querySelector<HTMLButtonElement>("[data-mode]")!;
    mode.addEventListener("click", () => {
      const dark = root.dataset.mode !== "dark";
      root.dataset.mode = dark ? "dark" : "light";
      mode.setAttribute("aria-pressed", String(dark));
    });
  });
</script>

<style>
  .ck {
    container-type: inline-size;
    --story-accent: #4a3fcf;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --paper: #f6f5f0;
    --line: #e6e4dc;
  }

  /* A quiet canvas, like a frame on a design tool's board. */
  .canvas {
    position: relative;
    padding: 24px 14px 18px;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .h {
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1px solid #c9c6bb;
    background: #fff;
  }
  .tl {
    top: -4px;
    left: -4px;
  }
  .tr {
    top: -4px;
    right: -4px;
  }
  .bl {
    bottom: -4px;
    left: -4px;
  }
  .br {
    bottom: -4px;
    right: -4px;
  }

  .win {
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.08),
      0 18px 40px -24px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 38px;
    padding: 0 8px 0 14px;
    background: #f3f2ef;
    border-bottom: 1px solid #e7e5e0;
  }
  .bar.small {
    height: 26px;
    background: #fff;
    border-bottom: 0;
  }
  .lights {
    display: inline-flex;
    gap: 7px;
    flex: none;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #d5d3ce;
  }
  .small .lights i {
    width: 9px;
    height: 9px;
  }

  /* The window's tabs are the chapters. */
  .tabs {
    display: flex;
    flex: 1;
    align-self: stretch;
    align-items: flex-end;
    gap: 2px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tabs li {
    position: relative;
    flex: none;
  }
  .tabs button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px 8px 0 0;
    background: none;
    font: inherit;
    font-size: 12.5px;
    color: #8a8780;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .tabs button:hover {
    color: #3a3934;
  }
  .tabs li.on button {
    background: #fff;
    color: #1d1c19;
    box-shadow: 0 0 0 1px #e7e5e0;
  }
  /* A hairline under the open tab fills as its chapter plays. */
  .tabs li::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--story-accent);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
  }
  .ck.tick[data-playing="true"] .tabs li.on::after {
    opacity: 0.7;
    animation: grow var(--dur) linear forwards;
  }
  @keyframes grow {
    to {
      transform: scaleX(1);
    }
  }
  .tabs button:focus-visible,
  .mode:focus-visible {
    outline: 2px solid var(--story-accent);
    outline-offset: -2px;
  }
  .mode {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: #8a8780;
    cursor: pointer;
  }
  .mode:hover {
    background: #e9e7e2;
    color: #1d1c19;
  }
  .ck[data-mode="light"] .i-sun,
  .ck[data-mode="dark"] .i-moon {
    display: none;
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #f8f8fb;
    overflow: hidden;
  }
  .ck[data-mode="dark"] .screen {
    background: #111015;
  }
  .shot {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }
  .shot.on {
    opacity: 1;
  }
  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .shot .dk {
    opacity: 0;
    transition: opacity 0.5s;
  }
  .ck[data-mode="dark"] .shot .dk {
    opacity: 1;
  }
  /* The tokens chapter turns the lights off by itself. */
  .ck.tick .shot.auto.on .dk {
    animation: lights-out 1.2s 1.8s var(--ease) forwards;
  }
  @keyframes lights-out {
    to {
      opacity: 1;
    }
  }

  /* The editor: light and small, floating over the app's corner. */
  .code {
    position: relative;
    z-index: 2;
    width: min(92%, 360px);
    margin: -22px auto 0 10px;
  }
  @container (max-width: 520px) {
    .tabs button :global(svg) {
      display: none;
    }
    .tabs button {
      padding: 0 10px;
    }
  }
  .crumbs {
    display: grid;
    padding: 0 14px 8px;
    border-bottom: 1px solid #efede8;
  }
  .path {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: #6f6c64;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .path.on {
    opacity: 1;
  }
  .sep {
    color: #b9b6ad;
  }
  .body {
    display: grid;
    padding: 10px 0 14px;
  }
  .src {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.75;
    color: #2b2a26;
    visibility: hidden;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .src.on {
    visibility: visible;
  }
  .src code {
    display: grid;
    min-width: max-content;
  }
  .ln {
    display: block;
    padding: 0 16px 0 8px;
    white-space: pre;
  }
  .ln em {
    display: inline-block;
    width: 22px;
    margin-right: 12px;
    font-style: normal;
    text-align: right;
    color: #b3b0a7;
  }
  /* Typed in, line by line, each time a chapter opens. */
  .src.on .ln {
    animation: type 0.4s steps(16, end) both;
    animation-delay: calc(0.25s + var(--l) * 0.17s);
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .src :global(.c) {
    color: #9a978e;
    font-style: italic;
  }
  .src :global(.s) {
    color: #b0373e;
  }
  .src :global(.n) {
    color: #a35a00;
  }
  .src :global(.v) {
    color: #2563c4;
  }
  .src :global(.f) {
    color: #7a3fb0;
  }

  /* Under the canvas: one control and one line. */
  .foot {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 600px;
    margin: 22px auto 0;
  }
  .caps {
    display: grid;
    flex: 1;
  }
  .cap {
    grid-area: 1 / 1;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-secondary);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .cap.on {
    opacity: 1;
    transition: opacity 0.4s 0.15s;
  }
  .cap b {
    color: var(--ink);
    font-weight: 600;
  }

  /* Wide: the app sits right, the editor overlaps its lower-left corner. */
  @container (min-width: 720px) {
    .canvas {
      padding: 44px 40px 48px;
    }
    .app {
      width: 84%;
      margin-left: auto;
    }
    .code {
      position: absolute;
      left: 40px;
      bottom: 34px;
      width: 44%;
      max-width: 390px;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .src.on .ln,
    .ck.tick .shot.auto.on .dk {
      animation: none;
    }
  }
</style>
