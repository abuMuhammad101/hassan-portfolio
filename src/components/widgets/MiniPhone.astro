---
/* A plain phone body for re-drawn mobile screens: bezel, island and status
   bar. The screen's own background and type come from the slot. */
import Icon from "../Icon.astro";
interface Props {
  label: string;
  bg?: string;
  dark?: boolean;
  class?: string;
}
const { label, bg = "#fbfaf8", dark = false, class: cls = "" } = Astro.props;
---

<figure class={`mp ${cls}`} aria-label={label} style={`--scr:${bg}`} data-dark={dark ? "" : undefined}>
  <div class="scr">
    <div class="sb" aria-hidden="true"><b>9:41</b><span class="isl"></span><span class="sys"><Icon name="cell-signal-full" size={11} weight="fill" /><Icon name="wifi-high" size={11} weight="bold" /><i class="bt"></i></span></div>
    <slot />
  </div>
</figure>

<style>
  .mp {
    flex: none;
    margin: 0;
    width: 230px;
    position: relative;
    padding: 6px;
    border-radius: 38px;
    background: linear-gradient(145deg, #3a3a3c, #1c1c1e 40%, #29292b);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 0 0 3px #0e0e0f,
      0 0 0 1px rgb(0 0 0 / 0.3),
      0 1px 2px rgb(0 0 0 / 0.1),
      0 34px 60px -30px rgb(20 18 12 / 0.45);
  }
  .scr {
    position: relative;
    height: 470px;
    border-radius: 32px;
    background: var(--scr);
    color: #1c1b1a;
    font: 11.5px/1.4 var(--font-sans);
    overflow: hidden;
  }
  [data-dark] .scr {
    color: #fff;
  }
  .sb {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    padding: 0 18px 0 22px;
    font-size: 11px;
  }
  .isl {
    width: 66px;
    height: 19px;
    border-radius: 12px;
    background: #111;
  }
  .sys {
    display: flex;
    gap: 3px;
    align-items: center;
  }
  .bt {
    width: 18px;
    height: 9px;
    margin-left: 2px;
    border-radius: 2.5px;
    border: 1.2px solid currentColor;
    background: linear-gradient(90deg, currentColor 70%, transparent 70%) content-box;
    padding: 1px;
  }
  /* Side keys. */
  .mp::before,
  .mp::after {
    content: "";
    position: absolute;
    top: 110px;
    width: 3px;
    border-radius: 2px;
    background: #3a3a3c;
  }
  .mp::before {
    left: -2px;
    height: 46px;
  }
  .mp::after {
    right: -2px;
    top: 124px;
    height: 64px;
  }
  @container (max-width: 640px) {
    .mp {
      width: 200px;
      padding: 5px;
      border-radius: 33px;
    }
    .scr {
      height: 410px;
      border-radius: 28px;
      font-size: 10.5px;
    }
  }
</style>
