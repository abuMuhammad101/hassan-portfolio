---
/* Exam prep platform, re-drawn from the design with real-looking content in
   place of the placeholder copy: a timed test, and the review after it. */
import Icon from "../Icon.astro";
import "../../styles/story.css";

const qs = Array.from({ length: 20 }, (_, i) => (i < 6 ? "done" : i === 6 ? "now" : i === 9 || i === 13 ? "flag" : ""));
const options = [
  ["A", "It is the average of the data values", ""],
  ["B", "It shows how spread out values are around the mean", "pick"],
  ["C", "It is the middle value when the data is ordered", ""],
  ["D", "It is the value that appears most often", ""],
];
const review = [
  ["Standard deviation", 92, "ok"],
  ["Variance", 78, "ok"],
  ["Normal distribution", 54, "warn"],
  ["Z-scores", 38, "bad"],
] as const;
---

<div class="ex" data-ex data-tab="test">
  <div class="s-canvas">
    <span class="s-h tl" aria-hidden="true"></span><span class="s-h tr" aria-hidden="true"></span>
    <span class="s-h bl" aria-hidden="true"></span><span class="s-h br" aria-hidden="true"></span>
    <div class="s-win">
      <div class="s-bar">
        <span class="s-lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <ol class="s-tabs" aria-label="Screens">
          <li class="on" data-tab-btn="test"><button type="button"><Icon name="timer" weight="duotone" size={16} /><span class="lbl">Timed test</span></button></li>
          <li data-tab-btn="review"><button type="button"><Icon name="chart-bar" weight="duotone" size={16} /><span class="lbl">Review</span></button></li>
        </ol>
        <span class="s-addr">app.prepwell.example</span>
      </div>

      <section class="pane test" data-pane="test" aria-label="Timed test">
        <header class="top">
          <span class="back"><Icon name="arrow-left" size={15} /></span>
          <div><b>Statistics · Mock test 3</b><small>Grade 8 · 20 questions</small></div>
          <span class="time"><Icon name="clock" size={14} /><b>18:42</b> left</span>
          <span class="btn ghost">Submit test</span>
        </header>
        <div class="body">
          <div class="q">
            <p class="qn">Question 7 of 20 <em>Multiple choice</em></p>
            <h5>What does the standard deviation of a data set tell you?</h5>
            <ul class="opts">
              {options.map(([k, t, s]) => (
                <li class={s}><b>{k}</b><span>{t}</span>{s && <Icon name="check-circle" size={16} weight="fill" />}</li>
              ))}
            </ul>
            <div class="nav"><span class="btn ghost"><Icon name="flag" size={13} />Flag for review</span><span class="btn dark">Next question<Icon name="arrow-right" size={13} /></span></div>
          </div>
          <aside class="grid" aria-label="Questions">
            <p>Questions</p>
            <ol>{qs.map((s, i) => <li class={s}>{i + 1}</li>)}</ol>
            <div class="key"><span><i class="done"></i>Answered</span><span><i class="flag"></i>Flagged</span></div>
            <span class="bar"><i style="width: 30%"></i></span>
            <small>6 of 20 answered</small>
          </aside>
        </div>
      </section>

      <section class="pane review" data-pane="review" aria-label="Review" hidden>
        <header class="top">
          <span class="back"><Icon name="arrow-left" size={15} /></span>
          <div><b>Mock test 3 · results</b><small>Submitted 10:24 · 41 min</small></div>
        </header>
        <div class="rv">
          <div class="score">
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15.5" class="trk" /><circle cx="18" cy="18" r="15.5" class="val" pathLength="100" /></svg>
            <b>15<small>/20</small></b>
            <span>Up from 12 on mock test 2</span>
          </div>
          <div class="topics">
            <p>By topic</p>
            {review.map(([t, v, s]) => (
              <div class="tp"><span>{t}</span><span class="tb"><i class={s} style={`width:${v}%`}></i></span><b>{v}%</b></div>
            ))}
            <div class="next"><Icon name="target" size={16} weight="duotone" /><span><b>Study next: Z-scores</b><small>12 practice questions, about 15 minutes</small></span><span class="btn dark">Start</span></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <p class="cap">Re-drawn from the design, with sample questions in place of the placeholder copy.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ex]").forEach((root) => {
    const show = (k: string) => {
      root.dataset.tab = k;
      root.querySelectorAll<HTMLElement>("[data-tab-btn]").forEach((b) => b.classList.toggle("on", b.dataset.tabBtn === k));
      root.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== k));
    };
    root.querySelectorAll<HTMLElement>("[data-tab-btn]").forEach((b) => b.querySelector("button")!.addEventListener("click", () => show(b.dataset.tabBtn!)));
  });
</script>

<style>
  .ex {
    container-type: inline-size;
    --story-accent: #a23e6b;
    --ink: #18181b;
    --ink2: #52525b;
    --mute: #8b8b93;
    --line: #ececef;
    --soft: #f7f7f9;
    --acc: #3b4fd8;
    --acc-soft: #eef0fd;
  }
  .pane {
    min-height: 400px;
    background: #fff;
    color: var(--ink);
    font: 13px/1.45 var(--font-sans);
  }
  .pane[hidden] {
    display: none;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
  }
  .top div {
    display: grid;
    flex: 1;
  }
  .top b {
    font-weight: 600;
  }
  .top small {
    color: var(--mute);
  }
  .back {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--soft);
    color: var(--ink2);
  }
  .time b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 13px;
    border-radius: 8px;
    font-weight: 550;
    white-space: nowrap;
  }
  .btn.dark {
    background: var(--ink);
    color: #fff;
  }
  .btn.ghost {
    box-shadow: 0 0 0 1px var(--line);
  }
  .body {
    display: grid;
    grid-template-columns: 1fr 210px;
  }
  .q {
    padding: 22px 26px;
  }
  .qn {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 8px;
    color: var(--mute);
  }
  .qn em {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--soft);
    font-style: normal;
    font-size: 11.5px;
  }
  h5 {
    margin: 0 0 16px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .opts {
    list-style: none;
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .opts li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .opts li b {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--soft);
    font-size: 12px;
  }
  .opts li span {
    flex: 1;
  }
  .opts .pick {
    background: var(--acc-soft);
    box-shadow: 0 0 0 1.5px var(--acc);
    color: var(--acc);
  }
  .opts .pick b {
    background: var(--acc);
    color: #fff;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
  }
  .grid {
    padding: 18px;
    border-left: 1px solid var(--line);
    background: var(--soft);
  }
  .grid p {
    margin: 0 0 10px;
    font-weight: 600;
  }
  .grid ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin: 0;
    padding: 0;
  }
  .grid li {
    display: grid;
    place-items: center;
    height: 28px;
    border-radius: 7px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    font-size: 12px;
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
  }
  .grid li.done {
    background: var(--ink);
    color: #fff;
    box-shadow: none;
  }
  .grid li.now {
    box-shadow: 0 0 0 1.5px var(--acc);
    color: var(--acc);
    font-weight: 600;
  }
  .grid li.flag {
    background: #fdf3e1;
    color: #9a6412;
    box-shadow: none;
  }
  .key {
    display: flex;
    gap: 12px;
    margin: 12px 0;
    font-size: 11.5px;
    color: var(--mute);
  }
  .key span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .key i {
    width: 9px;
    height: 9px;
    border-radius: 3px;
  }
  .key .done {
    background: var(--ink);
  }
  .key .flag {
    background: #f2c46b;
  }
  .bar,
  .tb {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: #e9e9ee;
    overflow: hidden;
  }
  .bar i,
  .tb i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--acc);
  }
  .grid small {
    display: block;
    margin-top: 6px;
    color: var(--mute);
  }

  .rv {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 26px;
    padding: 24px 26px;
  }
  .score {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 8px;
    text-align: center;
  }
  .score svg {
    width: 150px;
    transform: rotate(-90deg);
  }
  .trk,
  .val {
    fill: none;
    stroke-width: 3;
  }
  .trk {
    stroke: #ececf1;
  }
  .val {
    stroke: var(--acc);
    stroke-linecap: round;
    stroke-dasharray: 75 100;
  }
  .score b {
    position: absolute;
    top: 52px;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .score b small {
    font-size: 15px;
    color: var(--mute);
  }
  .score span {
    color: #1f7a45;
    font-size: 12.5px;
  }
  .topics p {
    margin: 0 0 12px;
    font-weight: 600;
  }
  .tp {
    display: grid;
    grid-template-columns: 150px 1fr 40px;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
  }
  .tp b {
    text-align: right;
    font-weight: 550;
    font-variant-numeric: tabular-nums;
  }
  .tb i.ok {
    background: #2f9e5b;
  }
  .tb i.warn {
    background: #e0a526;
  }
  .tb i.bad {
    background: #d0453f;
  }
  .next {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--acc-soft);
    color: var(--acc);
  }
  .next span:nth-child(2) {
    display: grid;
    flex: 1;
  }
  .next b {
    color: var(--ink);
  }
  .next small {
    color: var(--ink2);
  }
  .cap {
    margin: 12px 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-align: center;
  }
  @container (max-width: 700px) {
    .body,
    .rv {
      grid-template-columns: 1fr;
    }
    .grid {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .top .btn,
    .s-addr {
      display: none;
    }
    .q {
      padding: 16px;
    }
    .rv {
      padding: 16px;
    }
    .tp {
      grid-template-columns: 110px 1fr 38px;
    }
    .nav .ghost {
      display: none;
    }
  }
</style>
