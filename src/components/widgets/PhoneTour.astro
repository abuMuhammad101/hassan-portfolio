---
/* isTyme told as two short stories, using the real screens exported from the
   design file. The brand's one motif, proximity rings, sits behind the phone,
   and its saffron arc doubles as the chapter timer. In Urdu the whole stage
   mirrors, as the app does. */
import Icon from "../Icon.astro";

const sides = [
  {
    id: "hire",
    tab: "Hire",
    kicker: "Ayesha's kitchen sink is leaking.",
    chapters: [
      { key: "welcome", title: "A promise in one line", note: "The right person for the job, close by. The rings mean people near you, and they only appear at moments like this.", ur: "کام کا بندہ، آپ کے قریب" },
      { key: "home", title: "She asks in her own words", note: "Search, or pick one of four plain categories. The offers already waiting for her rise to the top.", ur: "آج کیا کام کروانا ہے؟" },
      { key: "price", title: "She knows what's fair", note: "She sets a price or asks for offers. Plumbers nearby charge Rs 900 to 1,400, so Rs 1,100 is in range.", ur: "ریٹ آپ بتائیں یا آفرز منگوائیں" },
      { key: "offers", title: "She picks with confidence", note: "Best match first, with rating, jobs done and distance. One clear button to hire Imran.", ur: "پیسے محفوظ ہیں، ٹینشن نہ لیں" },
      { key: "rate", title: "She pays when it's done", note: "isTyme held the money. Confirming the job releases Rs 1,100 to Imran and asks for a quick rating.", ur: "کام ہو گیا؟ پیمنٹ ریلیز کریں" },
    ],
  },
  {
    id: "work",
    tab: "Work",
    kicker: "Imran, a plumber, wants to find work.",
    chapters: [
      { key: "cnic", title: "He shows who he is", note: "Verification can't be skipped. His card goes in the frame, encrypted and never shown to customers.", ur: "شناختی کارڈ کا سامنے والا حصہ فریم میں رکھیں" },
      { key: "glare", title: "He's told how to fix it", note: "Not a generic error. The frame turns red and names the problem, too much light on the card, in his language.", ur: "روشنی زیادہ ہے، کارڈ تھوڑا ترچھا کریں" },
      { key: "thumb", title: "He confirms with his thumb", note: "A thumbprint check through a NADRA partner links the card to his profile.", ur: "انگوٹھا لگا کر کنفرم کریں" },
      { key: "verified", title: "Mubarak ho, Imran", note: "The Verified badge lands on his profile, and jobs that match his skills are waiting.", ur: "مبارک ہو! آپ ویریفائیڈ ہیں" },
      { key: "match", title: "Work that fits him", note: "Three jobs picked for his skills, each tagged with why: close by, good pay, quick job.", ur: "آپ کے لیے بہترین کام" },
    ],
  },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@500&display=swap" />

<div class="st" data-st data-lang="en" data-side="hire" data-playing="false">
  {sides.map((s, si) => (
    <div class="side" data-panel data-side-panel={s.id} hidden={si !== 0}>
      <div class="layout">
        <div class="story">
          <p class="kicker">{s.kicker}</p>
          <div class="bars" aria-hidden="true">
            {s.chapters.map(() => <span><i></i></span>)}
          </div>
          <ol class="chapters">
            {s.chapters.map((c, ci) => (
              <li data-ch class:list={[{ on: ci === 0 }]}>
                <button type="button" aria-current={ci === 0 ? "step" : undefined}>
                  <span class="num tabular-nums">{String(ci + 1).padStart(2, "0")}</span>
                  <span class="title">{c.title}</span>
                </button>
                <div class="more"><div>
                  <p class="note">{c.note}</p>
                  <p class="ur" lang="ur" dir="rtl">{c.ur}</p>
                </div></div>
                <span class="timer" aria-hidden="true"><i></i></span>
              </li>
            ))}
          </ol>
        </div>

        <div class="stage">
          <svg class="rings" viewBox="-300 -300 600 600" aria-hidden="true">
            <defs>
              <radialGradient id={`glow-${s.id}`}>
                <stop offset="0" stop-color="#ff9f1c" stop-opacity="0.22" />
                <stop offset="1" stop-color="#ff9f1c" stop-opacity="0" />
              </radialGradient>
            </defs>
            <circle r="210" fill={`url(#glow-${s.id})`} />
            <circle r="150" class="hair" />
            <circle r="215" class="hair" />
            <circle r="280" class="dots" />
            <circle r="215" class="arc" pathLength="100" />
          </svg>
          <div class="phone">
            {s.chapters.map((c, ci) => (
              <>
                <img class:list={["shot en", { on: ci === 0 }]} data-shot={ci} src={`/media/istyme/en-${c.key}.webp`} alt={`isTyme, ${c.title}, in English`} width="482" height="954" loading={si === 0 && ci === 0 ? "eager" : "lazy"} decoding="async" />
                <img class:list={["shot ur", { on: ci === 0 }]} data-shot={ci} src={`/media/istyme/ur-${c.key}.webp`} alt={`isTyme, ${c.title}, in Urdu`} width="482" height="954" loading="lazy" decoding="async" />
              </>
            ))}
            <button type="button" class="tap prev" data-go="-1" aria-label="Previous chapter"></button>
            <button type="button" class="tap next" data-go="1" aria-label="Next chapter"></button>
          </div>
        </div>
      </div>
    </div>
  ))}

  <div class="dock" role="toolbar" aria-label="Story controls">
    <div class="seg" role="group" aria-label="Side of the marketplace">
      {sides.map((s, i) => <button type="button" data-side-btn={s.id} aria-pressed={i === 0 ? "true" : "false"}>{s.tab}</button>)}
    </div>
    <span class="div" aria-hidden="true"></span>
    <div class="seg" role="group" aria-label="Language">
      <button type="button" data-lang-btn="en" aria-pressed="true">EN</button>
      <button type="button" data-lang-btn="ur" aria-pressed="false" lang="ur" class="urb">اردو</button>
    </div>
    <span class="div" aria-hidden="true"></span>
    <button type="button" class="play" data-play aria-label="Play the story">
      <span class="i-play"><Icon name="play" weight="fill" size={14} /></span>
      <span class="i-pause"><Icon name="pause" weight="fill" size={14} /></span>
    </button>
  </div>
</div>

<script>
  import { initStory } from "../../scripts/story";
  document.querySelectorAll<HTMLElement>("[data-st]").forEach((root) => {
    const story = initStory(root, { mirrored: () => root.dataset.lang === "ur" });
    root.querySelectorAll<HTMLButtonElement>("[data-side-btn]").forEach((b) =>
      b.addEventListener("click", () => {
        root.dataset.side = b.dataset.sideBtn;
        root.querySelectorAll("[data-side-btn]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        root.querySelectorAll<HTMLElement>("[data-side-panel]").forEach((p) => (p.hidden = p.dataset.sidePanel !== root.dataset.side));
        story.show(0);
      }),
    );
    root.querySelectorAll<HTMLButtonElement>("[data-lang-btn]").forEach((b) =>
      b.addEventListener("click", () => {
        root.dataset.lang = b.dataset.langBtn;
        root.querySelectorAll("[data-lang-btn]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        story.show(story.index);
      }),
    );
  });
</script>

<style>
  .st {
    container-type: inline-size;
    --saffron: #ff9f1c;
    --green: #1a5c3a;
    --dur: 5.2s;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
  }
  .side[hidden] {
    display: none;
  }

  /* Mobile first: phone, then the story under it. */
  .layout {
    display: grid;
    gap: 22px;
  }
  .stage {
    order: -1;
    position: relative;
    display: grid;
    place-items: center;
    padding: 18px 0 8px;
    overflow: hidden;
    border-radius: 28px;
  }
  .rings {
    position: absolute;
    width: max(150%, 520px);
    max-width: 600px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .hair {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 9%, transparent);
    stroke-width: 1;
  }
  .dots {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 20%, transparent);
    stroke-width: 1.4;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
  }
  .arc {
    fill: none;
    stroke: var(--saffron);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0 100;
    transform: rotate(-90deg);
  }
  .st[data-lang="ur"] .arc {
    transform: rotate(-90deg) scaleY(-1);
  }
  .st.tick[data-playing="true"] .arc {
    animation: arc var(--dur) linear forwards;
  }
  .st[data-playing="false"] .arc {
    stroke-dasharray: 22 100;
    transition: stroke-dasharray 0.6s var(--ease);
  }
  @keyframes arc {
    from {
      stroke-dasharray: 0 100;
    }
    to {
      stroke-dasharray: 100 100;
    }
  }

  .phone {
    position: relative;
    width: min(270px, 70vw);
    aspect-ratio: 482 / 954;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(14px) scale(0.975);
    transition:
      opacity 0.55s var(--ease),
      filter 0.55s var(--ease),
      transform 0.7s var(--ease);
  }
  .shot.ur {
    display: none;
  }
  .st[data-lang="ur"] .shot.ur {
    display: block;
  }
  .st[data-lang="ur"] .shot.en {
    display: none;
  }
  .shot.on {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .tap {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .tap.prev {
    left: 0;
    cursor: w-resize;
  }
  .tap.next {
    right: 0;
    cursor: e-resize;
  }
  .tap:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: -6px;
    border-radius: 36px;
  }

  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.6vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .bars {
    display: grid;
    grid-auto-flow: column;
    gap: 5px;
    margin-bottom: 16px;
  }
  .bars span {
    height: 3px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    overflow: hidden;
  }
  .bars i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ink);
  }
  .bars .done i {
    width: 100%;
  }
  .bars .on i {
    width: 100%;
  }
  .st.tick[data-playing="true"] .bars .on i {
    animation: fill var(--dur) linear forwards;
  }
  .st[data-lang="ur"] .bars {
    direction: rtl;
  }
  @keyframes fill {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* On a phone only the current chapter is shown; the bars carry the rest. */
  .chapters li:not(.on) {
    display: none;
  }
  .chapters button {
    display: flex;
    align-items: baseline;
    gap: 10px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
  }
  .num {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .title {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .more {
    display: grid;
    grid-template-rows: 1fr;
  }
  .more > div {
    overflow: hidden;
    padding-left: 28px;
  }
  .note {
    margin: 6px 0 0;
    color: var(--ink-secondary);
    line-height: 1.55;
    font-size: var(--text-sm);
  }
  .ur {
    margin: 8px 0 2px;
    font-family: "Noto Nastaliq Urdu", serif;
    font-size: 15px;
    line-height: 2;
    color: var(--ink-muted);
    text-align: left;
  }
  .timer {
    display: none;
  }

  /* Floating dock, centred under the stage. */
  .dock {
    display: flex;
    align-items: center;
    gap: 4px;
    width: max-content;
    max-width: 100%;
    margin: 22px auto 0;
    padding: 5px;
    border-radius: 999px;
    background: #141414;
    color: #fff;
    box-shadow:
      0 12px 30px -12px rgb(0 0 0 / 0.45),
      inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .seg {
    display: inline-flex;
  }
  .seg button,
  .play {
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.62);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .seg [aria-pressed="true"] {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }
  .urb {
    font-family: "Noto Nastaliq Urdu", serif;
    font-weight: 500;
    line-height: 1;
    padding-block: 4px 9px !important;
  }
  .div {
    width: 1px;
    height: 18px;
    background: rgb(255 255 255 / 0.14);
  }
  .play {
    display: grid;
    place-items: center;
    width: 34px;
    height: 32px;
    padding: 0;
    color: var(--saffron);
  }
  .st[data-playing="true"] .i-play,
  .st[data-playing="false"] .i-pause {
    display: none;
  }
  :is(.seg button, .play, .chapters button):focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: 2px;
  }

  /* Wider screens: the chapters become a list beside the phone. */
  @container (min-width: 720px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 48px;
    }
    .stage {
      order: 0;
      padding: 40px 0;
    }
    .phone {
      width: 286px;
    }
    .st[data-lang="ur"] .layout {
      direction: rtl;
    }
    .st[data-lang="ur"] .story {
      direction: ltr;
    }
    .bars {
      display: none;
    }
    .chapters li,
    .chapters li:not(.on) {
      display: block;
      position: relative;
      padding: 14px 0;
      border-top: 1px solid var(--rule);
    }
    .chapters li:last-child {
      border-bottom: 1px solid var(--rule);
    }
    .chapters li:not(.on) .title {
      color: var(--ink-muted);
      font-weight: 500;
    }
    .chapters li:not(.on) button:hover .title {
      color: var(--ink);
    }
    .more {
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.5s var(--ease);
    }
    .on .more {
      grid-template-rows: 1fr;
    }
    .timer {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
    }
    .timer i {
      display: block;
      height: 100%;
      width: 0;
      background: var(--saffron);
    }
    .st.tick[data-playing="true"] .on .timer i {
      animation: fill var(--dur) linear forwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot,
    .more {
      transition: none;
      filter: none;
      transform: none;
    }
    .st .arc,
    .st .bars i,
    .st .timer i {
      animation: none !important;
    }
  }
</style>
