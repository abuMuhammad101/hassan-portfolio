---
/* isTyme told as two connected stories, using the real screens exported from
   the design file: Ayesha hires a plumber, then Imran, the plumber, gets
   verified and finds work. The reader moves the story by tapping where the
   person would tap. The brand's proximity rings sit behind the phone. */
import Icon from "../Icon.astro";
import "../../styles/story.css";

type Ch = { key: string; title: string; note: string; hot: [number, number]; call: [number, number, "left" | "right", string] };
const sides: { id: string; role: string; icon: string; kicker: string; chapters: Ch[] }[] = [
  {
    id: "hire",
    role: "Customer",
    icon: "house",
    kicker: "Ayesha's kitchen sink is leaking.",
    chapters: [
      { key: "welcome", title: "A promise in one line", note: "The right person for the job, close by. The rings mean people near you, and they only appear at moments like this.", hot: [70, 81.1], call: [62, 26, "left", "Rings mean people near you"] },
      { key: "home", title: "She asks in her own words", note: "Search, or pick one of four plain categories. The offers already waiting for her rise to the top.", hot: [69.3, 46.4], call: [50, 70.4, "left", "Waiting offers rise to the top"] },
      { key: "price", title: "She knows what's fair", note: "She sets a price or asks for offers. Plumbers nearby charge Rs 900 to 1,400, so Rs 1,100 is in range.", hot: [72, 87.3], call: [36, 43.3, "left", "Rs 900 to 1,400 nearby: she's in range"] },
      { key: "offers", title: "She picks with confidence", note: "Best match first, with rating, jobs done and distance. One clear button to hire Imran.", hot: [80, 37.3], call: [66, 30.1, "right", "Best match first"] },
      { key: "rate", title: "She pays when it's done", note: "isTyme held the money. Confirming the job releases Rs 1,100 to Imran and asks for a quick rating.", hot: [78, 80.3], call: [50, 58.3, "left", "Held until the job is done"] },
    ],
  },
  {
    id: "work",
    role: "Worker",
    icon: "briefcase",
    kicker: "Imran, the plumber, wants more work.",
    chapters: [
      { key: "cnic", title: "He shows who he is", note: "Verification can't be skipped. His card goes in the frame, encrypted and never shown to customers.", hot: [50, 79.7], call: [50, 39.8, "right", "Encrypted, never shown to customers"] },
      { key: "glare", title: "He's told how to fix it", note: "Not a generic error. The frame turns red and names the problem: too much light on the card.", hot: [50, 79.7], call: [39.4, 66.8, "right", "The fix is named, not just the error"] },
      { key: "thumb", title: "He confirms with his thumb", note: "A thumbprint check through a NADRA partner links the card to his profile.", hot: [50, 47.7], call: [37.3, 18.1, "right", "Checked with a NADRA partner"] },
      { key: "verified", title: "Mubarak ho, Imran", note: "The Verified badge lands on his profile, and jobs that match his skills are waiting.", hot: [68, 88], call: [50, 30.4, "right", "The badge goes on his profile"] },
      { key: "match", title: "Work that fits him", note: "Three jobs picked for his skills, each tagged with why: close by, good pay, quick job.", hot: [50, 30.9], call: [37.3, 34, "right", "Each job says why it fits"] },
    ],
  },
];
---

<div class="st" data-st data-side="hire" data-playing="false">
  <div class="roles" role="group" aria-label="Whose story">
    {sides.map((s, i) => (
      <button type="button" data-side-btn={s.id} aria-pressed={i === 0 ? "true" : "false"}>
        <Icon name={s.icon} weight="fill" size={15} />{s.role}
      </button>
    ))}
  </div>

  {sides.map((s, si) => (
    <div class="side" data-panel data-side-panel={s.id} hidden={si !== 0}>
      <div class="layout">
        <div class="story">
          <p class="kicker">{s.kicker}</p>
          <div class="bars" aria-hidden="true">
            {s.chapters.map(() => <span><i></i></span>)}
          </div>
          <ol class="chapters">
            {s.chapters.map((c, ci) => (
              <li data-ch class:list={[{ on: ci === 0 }]}>
                <button type="button">
                  <span class="num tabular-nums">{String(ci + 1).padStart(2, "0")}</span>
                  <span class="title">{c.title}</span>
                </button>
                <div class="more"><div><p class="note">{c.note}</p></div></div>
                <span class="timer" aria-hidden="true"><i></i></span>
              </li>
            ))}
          </ol>
        </div>

        <div class="stage">
          <svg class="rings" viewBox="-300 -300 600 600" aria-hidden="true">
            <defs>
              <radialGradient id={`glow-${s.id}`}>
                <stop offset="0" stop-color="#ff9f1c" stop-opacity="0.22" />
                <stop offset="1" stop-color="#ff9f1c" stop-opacity="0" />
              </radialGradient>
            </defs>
            <circle r="210" fill={`url(#glow-${s.id})`} />
            <circle r="150" class="hair" />
            <circle r="215" class="hair" />
            <circle r="280" class="dots" />
            <circle r="215" class="arc" pathLength="100" />
          </svg>
          <div class="phone">
            {s.chapters.map((c, ci) => (
              <img class:list={["shot", { on: ci === 0 }]} data-shot={ci} src={`/media/istyme/en-${c.key}.webp`} alt={`isTyme, ${c.title}`} width="482" height="954" loading={si === 0 && ci < 2 ? "eager" : "lazy"} decoding="async" />
            ))}
            <button type="button" class="tap prev" data-go="-1" aria-label="Previous chapter"></button>
            <button type="button" class="tap next" data-go="1" aria-label="Next chapter"></button>
            {s.chapters.map((c, ci) => (
              <>
                <button type="button" class:list={["s-hot", { on: ci === 0 }]} data-shot={ci} data-hot style={`--x:${c.hot[0]}%;--y:${c.hot[1]}%`} aria-label="Tap to continue the story"><b></b></button>
                <p class:list={["s-call", c.call[2], { on: ci === 0 }]} data-shot={ci} style={`--x:${c.call[0]}%;--y:${c.call[1]}%`}><i></i><span>{c.call[3]}</span></p>
              </>
            ))}
          </div>
        </div>
      </div>
    </div>
  ))}

  <div class="controls">
    <button type="button" class="s-play" data-play aria-label="Play the story">
      <span class="knob">
        <svg viewBox="0 0 42 42" aria-hidden="true"><circle class="track" cx="21" cy="21" r="19" /><circle class="prog" cx="21" cy="21" r="19" pathLength="100" /></svg>
        <span class="icon" aria-hidden="true"><i></i><i></i></span>
      </span>
      <span class="count" data-count>01 / 05</span>
    </button>
    <p class="hint"><span class="dot" aria-hidden="true"></span>Tap the glowing spot to move the story on</p>
  </div>
</div>

<script>
  import { initStory } from "../../scripts/story";
  document.querySelectorAll<HTMLElement>("[data-st]").forEach((root) => {
    const setSide = (id: string) => {
      root.dataset.side = id;
      root.querySelectorAll<HTMLElement>("[data-side-btn]").forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.sideBtn === id)));
      root.querySelectorAll<HTMLElement>("[data-side-panel]").forEach((p) => (p.hidden = p.dataset.sidePanel !== id));
    };
    // The two stories are one: when Ayesha's ends, Imran's begins, and back.
    const story = initStory(root, {
      onEnd: () => {
        setSide(root.dataset.side === "hire" ? "work" : "hire");
        story.show(0);
        return true;
      },
    });
    root.querySelectorAll<HTMLButtonElement>("[data-side-btn]").forEach((b) =>
      b.addEventListener("click", () => {
        setSide(b.dataset.sideBtn!);
        story.show(0);
      }),
    );
  });
</script>

<style>
  .st {
    container-type: inline-size;
    --story-accent: #ff9f1c;
    --saffron: #ff9f1c;
    --green: #1a5c3a;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
  }
  .side[hidden] {
    display: none;
  }

  /* Role switch, in the app's own Hire / Work style. */
  .roles {
    display: flex;
    width: max-content;
    margin: 0 auto 6px;
    padding: 4px;
    border-radius: 999px;
    background: var(--bg-sunk);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .roles button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 18px;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      box-shadow 0.25s;
  }
  .roles button :global(svg) {
    opacity: 0.6;
  }
  .roles [aria-pressed="true"] {
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }
  .roles [aria-pressed="true"] :global(svg) {
    color: var(--green);
    opacity: 1;
  }
  .roles button:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: 2px;
  }

  /* Mobile first: phone, then the story under it. */
  .layout {
    display: grid;
    gap: 18px;
  }
  .stage {
    order: -1;
    position: relative;
    display: grid;
    place-items: center;
    padding: 18px 0 10px;
    overflow: hidden;
  }
  .rings {
    position: absolute;
    width: max(150%, 520px);
    max-width: 600px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .hair {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 9%, transparent);
  }
  .dots {
    fill: none;
    stroke: color-mix(in srgb, var(--ink) 20%, transparent);
    stroke-width: 1.4;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
  }
  .arc {
    fill: none;
    stroke: var(--saffron);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 22 100;
    transform: rotate(-90deg);
    transition: stroke-dasharray 0.6s var(--ease);
  }
  .st.tick[data-playing="true"] .arc {
    animation: arc var(--dur) linear forwards;
  }
  @keyframes arc {
    from {
      stroke-dasharray: 0 100;
    }
    to {
      stroke-dasharray: 100 100;
    }
  }

  .phone {
    position: relative;
    width: min(270px, 70vw);
    aspect-ratio: 482 / 954;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    filter: blur(10px);
    transform: translateY(14px) scale(0.975);
    transition:
      opacity 0.55s var(--ease),
      filter 0.55s var(--ease),
      transform 0.7s var(--ease);
  }
  .shot.on {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .tap {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 50%;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .tap.prev {
    left: 0;
  }
  .tap.next {
    right: 0;
  }
  .tap:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: -6px;
    border-radius: 36px;
  }
  .s-call {
    margin: 0;
  }

  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.6vw, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .bars {
    display: grid;
    grid-auto-flow: column;
    gap: 5px;
    margin-bottom: 16px;
  }
  .bars span {
    height: 3px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    overflow: hidden;
  }
  .bars i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ink);
  }
  .bars .done i,
  .bars .on i {
    width: 100%;
  }
  .st.tick[data-playing="true"] .bars .on i {
    animation: fill var(--dur) linear forwards;
  }
  @keyframes fill {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chapters li:not(.on) {
    display: none;
  }
  .chapters button {
    display: flex;
    align-items: baseline;
    gap: 10px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
  }
  .num {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .title {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .more {
    display: grid;
    grid-template-rows: 1fr;
  }
  .more > div {
    overflow: hidden;
    padding-left: 28px;
  }
  .note {
    margin: 6px 0 0;
    color: var(--ink-secondary);
    line-height: 1.55;
    font-size: var(--text-sm);
  }
  .timer {
    display: none;
  }
  .chapters button:focus-visible {
    outline: 2px solid var(--saffron);
    outline-offset: 2px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 20px;
    margin-top: 22px;
  }
  .hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .hint .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--saffron);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--saffron) 25%, transparent);
  }

  /* Wider: the chapters become a list beside the phone. */
  @container (min-width: 720px) {
    .roles {
      margin: 0 0 4px;
    }
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 48px;
    }
    .stage {
      order: 0;
      padding: 40px 0;
    }
    .phone {
      width: 286px;
    }
    .bars {
      display: none;
    }
    .chapters li,
    .chapters li:not(.on) {
      display: block;
      position: relative;
      padding: 14px 0;
      border-top: 1px solid var(--rule);
    }
    .chapters li:last-child {
      border-bottom: 1px solid var(--rule);
    }
    .chapters li:not(.on) .title {
      color: var(--ink-muted);
      font-weight: 500;
    }
    .chapters li:not(.on) button:hover .title {
      color: var(--ink);
    }
    .more {
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.5s var(--ease);
    }
    .on .more {
      grid-template-rows: 1fr;
    }
    .timer {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
    }
    .timer i {
      display: block;
      height: 100%;
      width: 0;
      background: var(--saffron);
    }
    .st.tick[data-playing="true"] .on .timer i {
      animation: fill var(--dur) linear forwards;
    }
    .controls {
      justify-content: flex-start;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot,
    .more {
      transition: none;
      filter: none;
      transform: none;
    }
    .st .arc,
    .st .bars i,
    .st .timer i {
      animation: none !important;
    }
  }
</style>
