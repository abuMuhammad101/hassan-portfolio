---
/* isTyme on a quiet canvas: the real screens exported from the design file,
   in a window whose tabs are the chapters. Two connected stories: Ayesha
   hires a plumber, then Imran, the plumber, gets verified and finds work.
   A named cursor taps what the person would tap next; the brand's
   proximity rings sit quietly behind the phone. */
import Icon from "../Icon.astro";
import "../../styles/story.css";

type Ch = { key: string; tab: string; icon: string; title: string; note: string; hot: [number, number] };
const sides: { id: string; role: string; icon: string; chapters: Ch[] }[] = [
  {
    id: "hire",
    role: "Customer",
    icon: "house",
    chapters: [
      { key: "welcome", tab: "Welcome", icon: "hand-waving", title: "A promise in one line", note: "The right person for the job, close by. The rings mean people near you.", hot: [70, 81.1] },
      { key: "home", tab: "Home", icon: "house", title: "She asks in her own words", note: "Four plain categories, and the offers already waiting for her rise to the top.", hot: [69.3, 46.4] },
      { key: "price", tab: "Price", icon: "coins", title: "She knows what's fair", note: "Plumbers nearby charge Rs 900 to 1,400, so Rs 1,100 is in range.", hot: [72, 87.3] },
      { key: "offers", tab: "Offers", icon: "users-three", title: "She picks with confidence", note: "Best match first, with rating, jobs done and distance. One clear way to hire.", hot: [80, 37.3] },
      { key: "rate", tab: "Pay", icon: "wallet", title: "She pays when it's done", note: "isTyme held the money. Confirming releases it to Imran and asks for a rating.", hot: [78, 80.3] },
    ],
  },
  {
    id: "work",
    role: "Worker",
    icon: "briefcase",
    chapters: [
      { key: "cnic", tab: "Card", icon: "identification-card", title: "He shows who he is", note: "Verification can't be skipped. The card is encrypted and never shown to customers.", hot: [50, 79.7] },
      { key: "glare", tab: "Retake", icon: "sun", title: "He's told how to fix it", note: "Not a generic error: the frame turns red and names the problem, too much light.", hot: [50, 79.7] },
      { key: "thumb", tab: "Thumb", icon: "fingerprint", title: "He confirms with his thumb", note: "A thumbprint check through a NADRA partner links the card to his profile.", hot: [50, 47.7] },
      { key: "verified", tab: "Verified", icon: "seal-check", title: "Mubarak ho, Imran", note: "The badge lands on his profile, and matching jobs are waiting.", hot: [68, 88] },
      { key: "match", tab: "Jobs", icon: "briefcase", title: "Work that fits him", note: "Three jobs picked for his skills, each tagged with why it fits.", hot: [50, 30.9] },
    ],
  },
];
---

<div class="st" data-st data-side="hire" data-playing="false">
  {sides.map((s, si) => (
    <div class="side" data-panel data-side-panel={s.id} hidden={si !== 0}>
      <div class="s-canvas">
        <span class="s-h tl" aria-hidden="true"></span><span class="s-h tr" aria-hidden="true"></span>
        <span class="s-h bl" aria-hidden="true"></span><span class="s-h br" aria-hidden="true"></span>
        <div class="s-win">
          <div class="s-bar">
            <span class="s-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <ol class="s-tabs" aria-label={`${s.role} chapters`}>
              {s.chapters.map((c, ci) => (
                <li data-ch class:list={[{ on: ci === 0 }]}>
                  <button type="button" title={c.title}><Icon name={c.icon} weight="duotone" size={16} /><span class="lbl">{c.tab}</span><span class="fill"></span></button>
                </li>
              ))}
            </ol>
            <div class="roles s-tool" role="group" aria-label="Whose story">
              {sides.map((r) => (
                <button type="button" data-side-btn={r.id} aria-pressed={r.id === s.id ? "true" : "false"} title={r.role}>
                  <Icon name={r.icon} weight={r.id === s.id ? "fill" : "regular"} size={14} /><span>{r.role}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="stage">
            <svg class="rings" viewBox="-300 -300 600 600" aria-hidden="true">
              <circle r="150" class="hair" />
              <circle r="215" class="hair" />
              <circle r="280" class="dots" />
            </svg>
            <div class="phone">
              {s.chapters.map((c, ci) => (
                <img class:list={["shot", { on: ci === 0 }]} data-shot={ci} src={`/media/istyme/en-${c.key}.webp`} alt={`isTyme, ${c.title}`} width="482" height="954" loading={si === 0 && ci < 2 ? "eager" : "lazy"} decoding="async" />
              ))}
              <button type="button" class="tap prev" data-go="-1" aria-label="Previous chapter"></button>
              <button type="button" class="tap next" data-go="1" aria-label="Next chapter"></button>
              {s.chapters.map((c, ci) => (
                <button type="button" class:list={["s-hot", { on: ci === 0 }]} data-shot={ci} data-hot style={`--x:${c.hot[0]}%;--y:${c.hot[1]}%`} aria-label="Tap to continue the story"><b></b></button>
              ))}
            </div>
            <span class="s-ghost" data-ghost aria-hidden="true">
              <svg viewBox="0 0 18 20"><path d="M2 1.6 15.4 8.5 9.6 10.2 6.9 16.2Z" /></svg>
              <b><i>H</i>Hassan</b>
              <span class="s-burst"></span>
            </span>
          </div>
        </div>
      </div>

      <div class="s-foot">
        <button type="button" class="s-play" data-play aria-label="Play the story">
          <span class="knob">
            <svg viewBox="0 0 42 42" aria-hidden="true"><circle class="track" cx="21" cy="21" r="19" /><circle class="prog" cx="21" cy="21" r="19" pathLength="100" /></svg>
            <span class="icon" aria-hidden="true"><i></i><i></i></span>
          </span>
        </button>
        <div class="s-caps" aria-live="polite">
          {s.chapters.map((c, ci) => <p class:list={["s-cap", { on: ci === 0 }]} data-shot={ci}><b>{c.title}.</b> {c.note}</p>)}
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  import { initStory } from "../../scripts/story";
  document.querySelectorAll<HTMLElement>("[data-st]").forEach((root) => {
    const setSide = (id: string) => {
      root.dataset.side = id;
      root.querySelectorAll<HTMLElement>("[data-side-panel]").forEach((p) => (p.hidden = p.dataset.sidePanel !== id));
    };
    // The two stories are one: when Ayesha's ends, Imran's begins, and back.
    const story = initStory(root, {
      onEnd: () => {
        setSide(root.dataset.side === "hire" ? "work" : "hire");
        story.show(0);
        return true;
      },
    });
    root.querySelectorAll<HTMLButtonElement>("[data-side-btn]").forEach((b) =>
      b.addEventListener("click", () => {
        if (b.dataset.sideBtn === root.dataset.side) return;
        setSide(b.dataset.sideBtn!);
        story.show(0);
      }),
    );
  });
</script>

<style>
  .st {
    container-type: inline-size;
    --story-accent: #e08a00;
    --saffron: #ff9f1c;
    --green: #1a5c3a;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }
  .side[hidden] {
    display: none;
  }

  /* Role switch, at the right of the window bar. */
  .roles {
    display: inline-flex;
    padding: 3px;
    border-radius: 9px;
    background: #e6e4de;
  }
  .roles button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border: 0;
    border-radius: 7px;
    background: none;
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    color: #77746c;
    cursor: pointer;
  }
  .roles [aria-pressed="true"] {
    background: #fff;
    color: #1d1c19;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }
  .roles [aria-pressed="true"] :global(svg) {
    color: var(--green);
  }
  .roles button:focus-visible {
    outline: 2px solid var(--story-accent);
    outline-offset: 1px;
  }
  @container (max-width: 640px) {
    .roles span {
      display: none;
    }
    .roles button {
      padding: 0 8px;
    }
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    padding: 30px 0 34px;
    background: #faf9f6;
    overflow: hidden;
  }
  .rings {
    position: absolute;
    width: 600px;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .hair {
    fill: none;
    stroke: rgb(0 0 0 / 0.06);
  }
  .dots {
    fill: none;
    stroke: rgb(0 0 0 / 0.14);
    stroke-width: 1.4;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
  }

  .phone {
    position: relative;
    width: min(250px, 66vw);
    aspect-ratio: 482 / 954;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transition:
      opacity 0.5s var(--ease),
      transform 0.7s var(--ease);
  }
  .shot.on {
    opacity: 1;
    transform: none;
  }
  .tap {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 50%;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .tap.prev {
    left: 0;
  }
  .tap.next {
    right: 0;
  }
  .tap:focus-visible {
    outline: 2px solid var(--story-accent);
    outline-offset: -6px;
    border-radius: 36px;
  }
  /* While the cursor shows the way, the tap spot stays quiet. */
  .st[data-playing="true"] .s-hot b,
  .st[data-playing="true"] .s-hot::before {
    opacity: 0;
  }

  @container (min-width: 720px) {
    .stage {
      padding: 44px 0 48px;
    }
    .phone {
      width: 270px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
      transform: none;
    }
  }
</style>
