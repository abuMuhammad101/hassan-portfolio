---
/* HH Global, the live site: screens captured from hhglobalcompany.com, plus a
   recorded walkthrough and the phone view. */
import BrowserFrame from "../BrowserFrame.astro";
import PhoneFrame from "../PhoneFrame.astro";
const screens = [
  { key: "home", title: "Home", src: "/media/hh/home.webp", note: "One promise, one way in: view the collection or ask for a quote." },
  { key: "walk", title: "Walkthrough", src: "/media/hh-global-walkthrough.gif", note: "A real recording of the live site: hero, category browse, product detail with variants." },
  { key: "catalogue", title: "Catalogue", src: "/media/hh/catalogue.webp", note: "Products by catalogue number, with style counts and material, read like a trade catalogue." },
  { key: "about", title: "Proof", src: "/media/hh/about.webp", note: "The numbers a wholesale buyer checks first, on the home page instead of a buried about page." },
  { key: "process", title: "How it works", src: "/media/hh/process.webp", note: "Spec to shipped in four steps, so a first-time buyer knows what happens after they ask." },
  { key: "quote", title: "Quote form", src: "/media/hh/quote.webp", note: "Several products in one request, each with category, type, colour, quantity and a reference photo." },
];
---

<div class="st" data-st>
  <div class="chips" role="group" aria-label="Screens">
    {screens.map((s, i) => <button type="button" data-k={s.key} aria-pressed={i === 0 ? "true" : "false"}>{s.title}</button>)}
  </div>
  <div class="row">
    <div class="desk">
      <BrowserFrame address="hhglobalcompany.com" label="HH Global, live site">
        {screens.map((s, i) => (
          <img data-shot={s.key} hidden={i !== 0} src={s.src} alt={`HH Global, ${s.title}`} width="800" height="500" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
        ))}
      </BrowserFrame>
      {screens.map((s, i) => <p class="note" data-note={s.key} hidden={i !== 0}><b>{s.title}.</b> {s.note}</p>)}
    </div>
    <div class="phone">
      <PhoneFrame label="HH Global on a phone">
        <img src="/media/hh/mobile.webp" alt="HH Global home page on a phone" width="375" height="812" loading="lazy" decoding="async" />
      </PhoneFrame>
    </div>
  </div>
  <a class="live" href="https://www.hhglobalcompany.com" target="_blank" rel="noopener">Visit the live site ↗</a>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-st]").forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-k]")];
    chips.forEach((c) => c.addEventListener("click", () => {
      chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
      root.querySelectorAll<HTMLElement>("[data-shot]").forEach((s) => (s.hidden = s.dataset.shot !== c.dataset.k));
      root.querySelectorAll<HTMLElement>("[data-note]").forEach((s) => (s.hidden = s.dataset.note !== c.dataset.k));
    }));
  });
</script>

<style>
  .st { container-type: inline-size; }
  .chips { display: flex; gap: 6px; margin-bottom: 12px; overflow-x: auto; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chips button { flex: none; border: 1px solid var(--rule); background: transparent; font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 999px; color: var(--ink-secondary); cursor: pointer; }
  .chips [aria-pressed="true"] { border-color: #b8913a; color: var(--ink); background: color-mix(in srgb, #c9a24a 14%, transparent); }
  .chips button:focus-visible { outline: 2px solid #b8913a; outline-offset: 2px; }
  .row { display: grid; grid-template-columns: 1fr 210px; gap: 20px; align-items: start; }
  .desk img { display: block; width: 100%; height: auto; }
  [hidden] { display: none !important; }
  .phone img { display: block; width: 100%; height: auto; }
  .note { margin: 12px 0 0; color: var(--ink-secondary); font-size: var(--text-sm); }
  .note b { color: var(--ink); font-weight: 600; }
  .live { display: inline-block; margin-top: 10px; font-size: var(--text-sm); font-weight: 500; color: var(--ink); }
  @container (max-width: 640px) {
    .row { grid-template-columns: 1fr; }
    .phone { width: 62%; margin: 0 auto; }
  }
</style>
