---
/* The audit's central finding, re-created with a stand-in brand and menu:
   decide the channel when the app opens, not when someone adds to cart. */
import PhoneFrame from "../PhoneFrame.astro";
import Icon from "../Icon.astro";
---

<div class="ra" data-ra data-view="after" data-km="1.8">
  <div class="controls">
    <div class="switch" role="group" aria-label="Before or after the audit">
      <button type="button" data-view-btn="before" aria-pressed="false">Before</button>
      <button type="button" data-view-btn="after" aria-pressed="true">After</button>
    </div>
    <label class="dist">
      <span>Distance from the nearest branch <b data-km-out>1.8 km</b></span>
      <input type="range" min="0.4" max="6" step="0.2" value="1.8" data-km-in aria-label="Distance from the nearest branch in kilometres" />
      <span class="marks" aria-hidden="true"><i style="--at:10.7%">1 km</i><i style="--at:46.4%">3 km</i></span>
    </label>
    <p class="explain" data-explain></p>
  </div>

  <div class="phone-wrap">
    <PhoneFrame label="Re-created ordering app">
      <div class="app">
        <!-- after: channel decided on open -->
        <div class="top only-after">
          <div class="seg" role="group" aria-label="Order type">
            <button type="button" data-mode="delivery">Delivery</button>
            <button type="button" data-mode="pickup">Pickup</button>
          </div>
          <p class="status" data-status></p>
        </div>
        <!-- before: an address and nothing else -->
        <div class="top only-before">
          <p class="addr"><small>Deliver to</small><b>Home · Villa 4</b></p>
        </div>

        <div class="hero">
          <span class="tag">Most loved</span>
          <div class="plate" aria-hidden="true"><i></i></div>
          <b>Crispy chicken, 4 pcs</b>
          <small>With fries, bun and garlic sauce</small>
          <div class="row"><span class="price">SAR 26</span><button type="button" class="add" data-add>Add to cart</button></div>
        </div>
        <div class="mini" aria-hidden="true"><span>Spiced tea</span><span>Wraps</span><span>Deals</span></div>

        <div class="toast" data-toast hidden></div>

        <div class="sheet" data-sheet hidden>
          <div class="before-sheet only-before">
            <span class="sad"><Icon name="x-circle" size={22} /></span>
            <b>Sorry, we don't deliver to your area</b>
            <small>Order from us on:</small>
            <span class="eq">Partner app A</span><span class="eq">Partner app B</span><span class="eq">Partner app C</span><span class="eq">Partner app D</span>
            <em>No ranking, no reason to pick one, no way back.</em>
          </div>
          <div class="after-sheet only-after">
            <b>We can't deliver this far yet</b>
            <small>Your cart is saved.</small>
            <button type="button" class="opt rec" data-pick-pickup><Icon name="storefront" size={16} /><span><b>Pick up at Gate Branch</b><small>Ready in about 15 min · points earned</small></span><em>Recommended</em></button>
            <span class="opt"><Icon name="arrow-square-out" size={16} /><span><b>Order on a partner app</b><small>Prices may differ · no points there</small></span></span>
            <span class="opt"><Icon name="bell-ringing" size={16} /><span><b>Tell me when you deliver here</b><small>We'll remember this address</small></span></span>
          </div>
          <button type="button" class="close" data-close>Close</button>
        </div>
      </div>
    </PhoneFrame>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ra]").forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const sheet = q("[data-sheet]"), toast = q("[data-toast]");
    let mode = "pickup", t: number | undefined;
    const km = () => parseFloat(root.dataset.km!);
    const say = (msg: string) => { toast.textContent = msg; toast.hidden = false; clearTimeout(t); t = window.setTimeout(() => (toast.hidden = true), 2600); };
    const render = () => {
      const d = km(), view = root.dataset.view;
      q("[data-km-out]").textContent = `${d.toFixed(1)} km`;
      const band = d <= 1 ? "in" : d <= 3 ? "near" : "far";
      root.dataset.band = band;
      if (view === "after") {
        const canDeliver = band === "in";
        root.querySelector<HTMLButtonElement>('[data-mode="delivery"]')!.disabled = !canDeliver;
        if (!canDeliver && mode === "delivery") mode = "pickup";
        root.querySelectorAll<HTMLElement>("[data-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
        q("[data-status]").innerHTML =
          band === "in" ? (mode === "delivery" ? '<i class="ok"></i>Delivers here · 25–35 min' : '<i class="ok"></i>Pickup at Gate Branch · ready in 15 min')
          : band === "near" ? `<i class="warn"></i>Outside the delivery zone · Pickup at Gate Branch, ${d.toFixed(1)} km`
          : `<i class="bad"></i>${d.toFixed(1)} km from the nearest branch · see your options`;
        q("[data-explain]").textContent =
          band === "in" ? "Within 1 km the app defaults to its own delivery, with pickup one tap away."
          : band === "near" ? "Between 1 and 3 km the app says so on open and defaults to pickup, so nothing is refused later."
          : "Beyond 3 km the customer sees the honest options up front, and adding to cart opens a guided choice that keeps the cart.";
      } else {
        q("[data-explain]").textContent = d <= 1
          ? "Inside 1 km, the original app works well."
          : "Outside 1 km, the original app lets you browse and choose, then refuses at Add to cart, at peak intent.";
      }
    };
    root.querySelectorAll<HTMLButtonElement>("[data-view-btn]").forEach((b) => b.addEventListener("click", () => {
      root.dataset.view = b.dataset.viewBtn!;
      root.querySelectorAll("[data-view-btn]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      sheet.hidden = true; toast.hidden = true; render();
    }));
    q<HTMLInputElement>("[data-km-in]").addEventListener("input", (e) => { root.dataset.km = (e.target as HTMLInputElement).value; sheet.hidden = true; render(); });
    root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b) => b.addEventListener("click", () => { mode = b.dataset.mode!; render(); }));
    q("[data-add]").addEventListener("click", () => {
      const d = km(), view = root.dataset.view;
      if (d <= 1) return say(view === "after" && mode === "pickup" ? "Added · pickup in about 15 min" : "Added · delivers in 25–35 min");
      if (view === "after" && d <= 3) return say("Added for pickup at Gate Branch");
      sheet.hidden = false;
    });
    q("[data-close]").addEventListener("click", () => (sheet.hidden = true));
    q("[data-pick-pickup]").addEventListener("click", () => { sheet.hidden = true; mode = "pickup"; render(); say("Switched to pickup · cart kept"); });
    render();
  });
</script>

<style>
  .ra {
    container-type: inline-size;
    --plum: #4b2a5e;
    --coral: #ff6b4a;
    --cream: #fbf6ef;
    display: grid;
    grid-template-columns: 1fr 270px;
    gap: 28px;
    align-items: center;
  }
  @media (max-width: 760px) {
    .ra { grid-template-columns: 1fr; }
    .phone-wrap { width: min(280px, 80%); margin: 0 auto; }
  }
  .switch { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--bg-sunk); border: 1px solid var(--rule); }
  .switch button { border: 0; background: none; font: inherit; font-weight: 600; font-size: var(--text-sm); padding: 6px 16px; border-radius: 999px; color: var(--ink-muted); cursor: pointer; }
  .switch [aria-pressed="true"] { background: var(--bg-raised); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
  .dist { display: grid; gap: 8px; margin-top: 20px; font-size: var(--text-sm); color: var(--ink-secondary); }
  .dist b { color: var(--ink); font-variant-numeric: tabular-nums; margin-left: 6px; }
  .dist input { width: 100%; accent-color: var(--plum); }
  .marks { position: relative; height: 14px; }
  .marks i { position: absolute; left: var(--at); transform: translateX(-50%); font-style: normal; font-size: 11px; color: var(--ink-muted); }
  .explain { margin: 16px 0 0; padding: 14px 16px; border-radius: 14px; background: var(--bg-sunk); color: var(--ink); font-size: var(--text-sm); line-height: 1.5; min-height: 4.5em; }
  :is(.switch button, .seg button, .add, .opt, .close, input):focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }

  .app { position: relative; height: 520px; overflow: hidden; background: var(--cream); color: #2a1d33; font: 12.5px/1.4 Inter, var(--font-body, system-ui), sans-serif; padding: 14px 12px; display: flex; flex-direction: column; gap: 10px; }
  .only-before, .only-after { display: none; }
  .ra[data-view="before"] .only-before, .ra[data-view="after"] .only-after { display: revert; }
  .ra[data-view="before"] .top.only-before, .ra[data-view="after"] .top.only-after { display: grid; }
  .top { gap: 8px; }
  .seg { display: grid; grid-template-columns: 1fr 1fr; padding: 3px; border-radius: 12px; background: #efe6dc; }
  .seg button { border: 0; background: none; font: inherit; font-weight: 600; padding: 7px; border-radius: 9px; color: #6e5d77; cursor: pointer; }
  .seg [aria-pressed="true"] { background: #fff; color: var(--plum); box-shadow: 0 1px 3px rgb(0 0 0 / 0.1); }
  .seg button:disabled { opacity: 0.4; cursor: not-allowed; }
  .status { margin: 0; display: flex; align-items: center; gap: 7px; font-size: 11.5px; font-weight: 500; }
  .status :global(i) { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .status :global(.ok) { background: #1f9254; } .status :global(.warn) { background: #e3a008; } .status :global(.bad) { background: #d64545; }
  .addr { margin: 0; display: grid; } .addr small { color: #8a7a92; } .addr b { font-size: 13px; }

  .hero { display: grid; gap: 3px; padding: 10px; border-radius: 18px; background: #fff; box-shadow: 0 10px 24px -16px rgb(75 42 94 / 0.45); position: relative; }
  .tag { position: absolute; top: 14px; left: 14px; z-index: 1; padding: 2px 8px; border-radius: 999px; background: #fff; font-size: 10px; font-weight: 600; color: var(--plum); }
  .plate { height: 150px; border-radius: 14px; background: radial-gradient(circle at 50% 60%, #fff 0 34%, #f2ebe2 35% 100%); display: grid; place-items: center; margin-bottom: 6px; }
  .plate i { width: 92px; height: 60px; border-radius: 46% 54% 50% 50%; background: radial-gradient(circle at 35% 35%, #f2b45a, #c46a1c); box-shadow: 30px 6px 0 -8px #e7a04a, -26px 10px 0 -12px #d98a33, 0 14px 14px -8px rgb(0 0 0 / 0.25); }
  .hero b { font-size: 14px; } .hero small { color: #8a7a92; }
  .row { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
  .price { font-weight: 700; font-variant-numeric: tabular-nums; }
  .add { border: 0; border-radius: 999px; padding: 8px 14px; background: var(--coral); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .mini { display: flex; gap: 6px; } .mini span { flex: 1; padding: 10px 6px; border-radius: 12px; background: #fff; text-align: center; font-weight: 600; color: #6e5d77; }

  .toast { position: absolute; z-index: 4; left: 12px; right: 12px; bottom: 14px; padding: 10px 12px; border-radius: 12px; background: var(--plum); color: #fff; font-weight: 600; animation: up 0.25s ease-out; }
  .toast[hidden], .sheet[hidden] { display: none; }
  .sheet { position: absolute; z-index: 3; inset: auto 0 0 0; display: grid; gap: 8px; padding: 16px 14px 14px; border-radius: 22px 22px 0 0; background: #fff; box-shadow: 0 -20px 40px -20px rgb(0 0 0 / 0.35); animation: up 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .ra[data-view="before"] .sheet { inset: 0; border-radius: 0; align-content: center; }
  @keyframes up { from { transform: translateY(16px); opacity: 0; } }
  .before-sheet, .after-sheet { gap: 7px; }
  .ra[data-view="before"] .before-sheet, .ra[data-view="after"] .after-sheet { display: grid; }
  .sheet b { font-size: 14px; } .sheet small { color: #8a7a92; }
  .sad { color: #d64545; }
  .eq { padding: 10px; border-radius: 10px; border: 1px solid #e6dce6; text-align: center; font-weight: 600; color: #6e5d77; }
  .before-sheet em { font-style: normal; font-size: 11px; color: #d64545; }
  .opt { display: grid; grid-template-columns: 18px 1fr auto; gap: 10px; align-items: center; text-align: left; padding: 10px; border: 1px solid #ece4ec; border-radius: 12px; background: #fff; font: inherit; color: inherit; }
  .opt span { display: grid; } .opt b { font-size: 12.5px; }
  .opt em { font-style: normal; font-size: 10px; font-weight: 700; color: var(--coral); }
  .rec { border-color: var(--plum); background: #f7f1fa; cursor: pointer; }
  .close { justify-self: center; border: 0; background: none; font: inherit; color: #8a7a92; cursor: pointer; padding: 4px 10px; }
  @media (prefers-reduced-motion: reduce) { .toast, .sheet { animation: none; } }
</style>
