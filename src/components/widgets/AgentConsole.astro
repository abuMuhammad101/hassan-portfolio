---
/* Claims control room, re-created with a stand-in brand, payers and data.
   Five agents move claims through a pipeline; when a claim loops, the console
   raises it and a person decides. */
import BrowserFrame from "../BrowserFrame.astro";
import Icon from "../Icon.astro";
const kpis = [
  { k: "Claims in flight", v: "1,284", s: "across all 5 agent stages", d: "M0 22 L10 16 L20 18 L30 8 L40 12 L50 6 L60 20 L70 18 L80 24 L90 14 L100 16" },
  { k: "First-pass approval", v: "82%", s: "vs last 7 days", d: "M0 20 L12 18 L24 19 L36 14 L48 15 L60 10 L72 12 L84 8 L100 9" },
  { k: "Recovered · 7d", v: "AED 412,860", s: "denials reversed", d: "M0 24 L14 20 L28 22 L42 14 L56 16 L70 10 L84 12 L100 6" },
];
const stages = [
  { n: "Intake", i: "tray-arrow-down", c: 214 },
  { n: "Coding", i: "code", c: 386 },
  { n: "Eligibility", i: "shield-check", c: 301 },
  { n: "Submission", i: "paper-plane-tilt", c: 248 },
  { n: "Denials", i: "arrows-counter-clockwise", c: 135, loop: true },
];
const queue = [
  { s: 87, p: "Crescent Health", why: "Medical necessity · awaiting docs", t: "6h left", ref: "Pre-auth PA-77102" },
  { s: 81, p: "Harbour Mutual", why: "Authorisation · expired referral", t: "1d left", ref: "Appeal AP-33410" },
  { s: 74, p: "Oasis Care TPA", why: "Authorisation · expired referral", t: "1d 6h", ref: "Denial DN-90045" },
];
---

<div class="ac" data-console data-state="loop">
  <BrowserFrame address="app.relayclaims.example/control-room" label="Re-created claims control room">
    <div class="app">
      <nav class="rail" aria-hidden="true">
        <span class="logo"><i></i></span>
        <span class="on"><Icon name="house" size={17} weight="fill" /></span>
        <span><Icon name="pulse" size={17} /></span>
        <span><Icon name="magnifying-glass" size={17} /></span>
        <span><Icon name="users" size={17} /></span>
        <span><Icon name="bell" size={17} /></span>
        <span class="me">LA</span>
      </nav>

      <main class="main">
        <header class="top">
          <div><b>Control room</b><small>Agents, deadlines, denials, and what needs you now.</small></div>
          <span class="seg" aria-hidden="true"><span>Today</span><b>This week</b><span>This month</span></span>
        </header>
        <div class="hello">
          <div><small>Tuesday, 13 July</small><h4>Good evening, Dr. Lina</h4></div>
          <span class="cta" aria-hidden="true"><Icon name="plus-circle" size={15} />New encounter</span>
        </div>

        <div class="kpis">
          {kpis.map((k) => (
            <div class="kpi">
              <span class="k">{k.k}</span>
              <b>{k.v}</b>
              <svg viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d={k.d + " L100 28 L0 28 Z"} class="area" /><path d={k.d} class="ln" /></svg>
              <small>{k.s}</small>
            </div>
          ))}
        </div>

        <div class="grid">
          <section class="pipe">
            <p class="h"><b>Live agent pipeline</b><i class="live" aria-hidden="true"></i><span>sample data</span></p>
            <ol class="stages">
              {stages.map((s, i) => (
                <li class={s.loop ? "loop" : ""}>
                  <span class="st-ic"><Icon name={s.i} size={15} /></span>
                  <span class="st-n">{s.n}</span>
                  <b class="st-c tabular-nums" data-count={s.loop ? "loop" : undefined}>{s.c}</b>
                  <span class="flow" aria-hidden="true"><i style={`--d:${i * 0.35}s`}></i><i style={`--d:${i * 0.35 + 1.1}s`}></i></span>
                  {s.loop && <em class="flag sw-loop">Loop</em>}
                </li>
              ))}
            </ol>

            <div class="alert sw-loop" role="status">
              <span class="a-ic"><Icon name="arrows-counter-clockwise" size={15} weight="bold" /></span>
              <p><b>Denial loop on CL-2041</b><span>Crescent Health · AED 6,250 · denied 3 times. The agents stopped retrying.</span></p>
              <button type="button" class="btn dark" data-open>Review</button>
            </div>
            <div class="alert ok sw-fixed" role="status">
              <span class="a-ic"><Icon name="check" size={15} weight="bold" /></span>
              <p><b>Resubmitted with your fix</b><span>CL-2041 is back in Submission, logged under your name.</span></p>
              <button type="button" class="btn ghost" data-undo>Undo</button>
            </div>
            <div class="alert mine sw-mine" role="status">
              <span class="a-ic"><Icon name="user" size={15} weight="bold" /></span>
              <p><b>CL-2041 is yours now</b><span>The agents won't touch it until you hand it back.</span></p>
              <button type="button" class="btn ghost" data-undo>Hand back</button>
            </div>
          </section>

          <section class="queue">
            <p class="qh"><b>Priority queue</b><span>by urgency <Icon name="caret-down" size={11} /></span></p>
            <div class="top-item">
              <span class="score">94</span><span class="chip">Denial DN-88213</span>
              <b class="amt">AED 18,400 <em>● 3h left</em></b>
              <span class="who">Northgate TPA</span>
              <small>Coding · procedure and diagnosis mismatch</small>
              <span class="go" aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
            </div>
            <ul class="items">
              {queue.map((q) => (
                <li><span class="score sm">{q.s}</span><span class="it"><b>{q.p} <em>● {q.t}</em></b><small>{q.why}</small></span><span class="chip sm">{q.ref}</span></li>
              ))}
            </ul>
          </section>
        </div>
      </main>

      <div class="scrim" data-scrim hidden></div>
      <aside class="sheet" data-sheet hidden role="dialog" aria-label="Claim CL-2041">
        <header class="s-head">
          <div><small>Claim CL-2041 · Crescent Health</small><b>AED 6,250 · physiotherapy session</b></div>
          <button type="button" class="x" data-close aria-label="Close"><Icon name="x" size={16} /></button>
        </header>
        <p class="s-lbl">What the agents tried</p>
        <ol class="tries">
          <li><b>Coding agent</b> sent procedure 97110 with the visit's diagnosis.<span class="den">Denied: not covered for this diagnosis</span></li>
          <li><b>Denials agent</b> added a modifier and resubmitted.<span class="den">Denied: same reason</span></li>
          <li><b>Denials agent</b> attached the treatment notes.<span class="den">Denied: same reason · retries stopped</span></li>
        </ol>
        <div class="fix">
          <p class="s-lbl">Suggested fix <span class="conf">Confidence 64%</span></p>
          <p>Code the session as 97112, which matches the balance work in the notes, and link it to the same diagnosis.</p>
          <span class="bar" aria-hidden="true"><i></i></span>
        </div>
        <div class="s-acts">
          <button type="button" class="btn dark" data-approve>Approve fix and resubmit</button>
          <button type="button" class="btn ghost" data-take>Take it over</button>
        </div>
        <p class="s-note"><Icon name="info" size={12} />Sample codes and data. Nothing is sent without a person approving it.</p>
      </aside>
    </div>
  </BrowserFrame>
  <button type="button" class="reset" data-reset><Icon name="arrow-counter-clockwise" size={12} />Reset</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-console]").forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const sheet = q("[data-sheet]"), scrim = q("[data-scrim]"), count = q('[data-count="loop"]');
    const open = (v: boolean) => { sheet.hidden = !v; scrim.hidden = !v; if (v) q<HTMLButtonElement>("[data-approve]").focus(); };
    const set = (s: string) => { root.dataset.state = s; count.textContent = s === "loop" ? "135" : "134"; };
    q("[data-open]").addEventListener("click", () => open(true));
    q("[data-close]").addEventListener("click", () => open(false));
    scrim.addEventListener("click", () => open(false));
    q("[data-approve]").addEventListener("click", () => { open(false); set("fixed"); });
    q("[data-take]").addEventListener("click", () => { open(false); set("mine"); });
    root.querySelectorAll("[data-undo]").forEach((b) => b.addEventListener("click", () => set("loop")));
    q("[data-reset]").addEventListener("click", () => { open(false); set("loop"); });
    sheet.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Escape") open(false); });
  });
</script>

<style>
  .ac {
    container-type: inline-size;
    --bg: #eef3f1;
    --panel: #fff;
    --ink: #121826;
    --ink2: #4b5563;
    --mute: #8a93a0;
    --line: #e4e8ea;
    --acc: #0f766e;
    --acc-soft: #dff3ef;
    --navy: #0d1424;
    --red: #d64545;
    --red-soft: #fdecec;
    --amber: #e3a008;
  }
  .app {
    position: relative;
    display: grid;
    grid-template-columns: 60px 1fr;
    min-height: 600px;
    overflow: hidden;
    background: radial-gradient(70% 60% at 85% 0%, #e7e9fb, transparent 60%), radial-gradient(60% 50% at 10% 100%, #e5f5ee, transparent 60%), var(--bg);
    color: var(--ink);
    font: 13px/1.4 Inter, var(--font-body, system-ui), sans-serif;
  }
  button { font: inherit; }
  :is(.btn, .x, .reset):focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }

  .rail { display: flex; flex-direction: column; align-items: center; gap: 8px; margin: 12px 0 12px 10px; padding: 12px 0; border-radius: 18px; background: rgb(255 255 255 / 0.6); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.8) inset; color: #4b5563; }
  .rail span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; }
  .rail .on { background: var(--acc); color: #fff; box-shadow: 0 6px 14px -6px var(--acc); }
  .logo i { width: 22px; height: 16px; background: linear-gradient(135deg, var(--acc), #4f46e5); clip-path: polygon(0 100%, 30% 0, 50% 60%, 70% 0, 100% 100%, 80% 100%, 70% 50%, 50% 100%, 30% 50%, 20% 100%); }
  .rail .logo { margin-bottom: 10px; }
  .rail .me { margin-top: auto; border-radius: 50%; background: #f1e3c8; color: #6b4a10; font-size: 10px; font-weight: 700; }

  .main { padding: 16px 18px 18px; min-width: 0; }
  .top { display: flex; align-items: flex-start; gap: 12px; }
  .top > div { display: grid; }
  .top b { font-size: 14px; color: #1e2a6e; }
  .top small { color: var(--ink2); }
  .seg { margin-left: auto; display: inline-flex; padding: 3px; border-radius: 10px; background: rgb(255 255 255 / 0.7); color: var(--ink2); font-size: 12px; }
  .seg > * { padding: 4px 10px; border-radius: 7px; } .seg b { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgb(0 0 0 / 0.08); }
  .hello { display: flex; align-items: flex-end; gap: 12px; margin: 14px 0 12px; }
  .hello small { color: var(--mute); }
  h4 { margin: 2px 0 0; font-size: 24px; font-weight: 450; letter-spacing: -0.02em; }
  .cta { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 999px; background: var(--acc); color: #fff; font-weight: 600; white-space: nowrap; }

  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .kpi { display: grid; gap: 4px; padding: 11px 13px; border-radius: 16px; background: rgb(255 255 255 / 0.85); box-shadow: 0 0 0 1px #fff inset, 0 8px 20px -16px rgb(15 30 60 / 0.4); }
  .k { color: var(--ink2); font-size: 12px; }
  .kpi b { font-size: 21px; font-weight: 650; letter-spacing: -0.02em; }
  .kpi svg { width: 100%; height: 30px; }
  .ln { fill: none; stroke: #4f46e5; stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .area { fill: rgb(79 70 229 / 0.1); }
  .kpi small { color: var(--mute); font-size: 11.5px; }

  .grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 12px; margin-top: 12px; align-items: start; }
  .pipe { padding: 13px; border-radius: 18px; background: #fff; box-shadow: 0 8px 22px -18px rgb(15 30 60 / 0.45); }
  .h { display: flex; align-items: center; gap: 7px; margin: 0 0 12px; }
  .h b { color: #1e2a6e; }
  .h span { margin-left: auto; color: var(--mute); font-size: 11px; }
  .live { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgb(34 197 94 / 0.5); animation: live 1.8s infinite; }
  @keyframes live { 70% { box-shadow: 0 0 0 6px rgb(34 197 94 / 0); } }

  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .stages li { position: relative; display: grid; justify-items: start; gap: 3px; padding: 10px 9px; border-radius: 12px; background: #f6f8f9; }
  .st-ic { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: #fff; color: var(--acc); box-shadow: 0 0 0 1px var(--line); }
  .st-n { color: var(--ink2); font-size: 11.5px; }
  .st-c { font-size: 17px; }
  .flow { position: relative; width: 100%; height: 3px; margin-top: 4px; border-radius: 2px; background: #e5eaec; overflow: hidden; }
  .flow i { position: absolute; top: 0; left: -20%; width: 20%; height: 100%; border-radius: 2px; background: var(--acc); animation: run 2.2s linear infinite; animation-delay: var(--d); }
  @keyframes run { to { left: 100%; } }
  .loop { background: var(--red-soft); }
  .loop .st-ic { color: var(--red); }
  .loop .flow i { background: var(--red); animation-duration: 1.1s; }
  .flag { position: absolute; top: 8px; right: 8px; padding: 1px 7px; border-radius: 999px; background: var(--red); color: #fff; font-size: 10px; font-style: normal; font-weight: 700; }
  .ac:not([data-state="loop"]) .loop { background: #f6f8f9; }
  .ac:not([data-state="loop"]) .loop .st-ic { color: var(--acc); }
  .ac:not([data-state="loop"]) .loop .flow i { background: var(--acc); animation-duration: 2.2s; }

  .alert { display: flex; align-items: center; gap: 10px; margin-top: 10px; padding: 10px 10px 10px 11px; border-radius: 13px; background: var(--red-soft); box-shadow: 0 0 0 1px #f7cfcf inset; animation: rise 0.35s ease-out; }
  .alert p { margin: 0; flex: 1; display: grid; min-width: 0; }
  .alert p span { color: var(--ink2); font-size: 12px; }
  .a-ic { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--red); color: #fff; }
  .alert.ok { background: var(--acc-soft); box-shadow: 0 0 0 1px #bfe6de inset; } .ok .a-ic { background: var(--acc); }
  .alert.mine { background: #eef0fd; box-shadow: 0 0 0 1px #d6daf8 inset; } .mine .a-ic { background: #4f46e5; }
  @keyframes rise { from { opacity: 0; transform: translateY(4px); } }
  .sw-fixed, .sw-mine { display: none !important; }
  .ac:not([data-state="loop"]) .sw-loop { display: none !important; }
  .ac[data-state="fixed"] .sw-fixed, .ac[data-state="mine"] .sw-mine { display: flex !important; }

  .btn { border: 0; cursor: pointer; padding: 8px 13px; border-radius: 10px; font-weight: 600; white-space: nowrap; }
  .btn.dark { background: var(--navy); color: #fff; box-shadow: 0 6px 14px -8px var(--navy); }
  .btn.ghost { background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--line); }

  .queue { padding: 13px; border-radius: 18px; background: linear-gradient(170deg, #121b31, var(--navy)); color: #fff; box-shadow: 0 16px 30px -20px rgb(13 20 36 / 0.8); }
  .qh { display: flex; align-items: center; margin: 0 0 10px; }
  .qh span { margin-left: auto; display: inline-flex; gap: 4px; align-items: center; color: rgb(255 255 255 / 0.55); font-size: 12px; }
  .top-item { position: relative; display: grid; gap: 3px; padding: 12px; border-radius: 14px; background: radial-gradient(90% 120% at 100% 100%, rgb(15 118 110 / 0.45), transparent 60%), rgb(255 255 255 / 0.05); }
  .score { display: inline-grid; place-items: center; width: 30px; height: 22px; border-radius: 6px; background: rgb(255 255 255 / 0.12); font-size: 11.5px; font-weight: 700; }
  .score.sm { width: 28px; flex: none; }
  .chip { position: absolute; top: 12px; right: 12px; padding: 2px 8px; border-radius: 6px; background: #fff; color: var(--ink); font-size: 11px; }
  .chip.sm { position: static; flex: none; font-size: 10.5px; }
  .amt { margin-top: 8px; font-size: 24px; letter-spacing: -0.02em; }
  .amt em { font-style: normal; font-size: 12px; font-weight: 500; color: #fca5a5; margin-left: 6px; }
  .who { font-weight: 600; } .top-item small { color: rgb(255 255 255 / 0.6); }
  .go { position: absolute; right: 12px; bottom: 12px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.6); }
  .items { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px; }
  .items li { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 12px; background: rgb(255 255 255 / 0.06); }
  .it { display: grid; flex: 1; min-width: 0; }
  .it b { font-weight: 600; font-size: 12.5px; } .it em { font-style: normal; font-weight: 500; color: #fcd34d; font-size: 11px; }
  .it small { color: rgb(255 255 255 / 0.55); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .scrim { position: absolute; inset: 0; background: rgb(13 20 36 / 0.28); backdrop-filter: blur(2px); animation: fade 0.25s; }
  .sheet { position: absolute; top: 10px; right: 10px; bottom: 10px; width: 360px; overflow: auto; padding: 16px; border-radius: 18px; background: #fff; box-shadow: 0 30px 60px -20px rgb(13 20 36 / 0.5); animation: slide 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  .scrim[hidden], .sheet[hidden] { display: none; }
  @keyframes slide { from { transform: translateX(24px); opacity: 0; } }
  @keyframes fade { from { opacity: 0; } }
  .s-head { display: flex; align-items: flex-start; gap: 10px; }
  .s-head div { display: grid; flex: 1; } .s-head small { color: var(--mute); } .s-head b { font-size: 15px; }
  .x { display: grid; place-items: center; width: 30px; height: 30px; border: 0; border-radius: 50%; background: #f1f4f5; cursor: pointer; color: var(--ink); }
  .s-lbl { display: flex; align-items: center; margin: 16px 0 8px; font-size: 11.5px; font-weight: 600; color: var(--mute); }
  .tries { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid #f3c4c4; display: grid; gap: 10px; }
  .tries li { position: relative; color: var(--ink2); font-size: 12.5px; }
  .tries li::before { content: ""; position: absolute; left: -20px; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 2px var(--red); }
  .tries b { color: var(--ink); font-weight: 600; }
  .den { display: block; margin-top: 2px; color: var(--red); font-size: 11.5px; font-weight: 600; }
  .fix { margin-top: 6px; padding: 2px 12px 12px; border-radius: 14px; background: var(--acc-soft); }
  .fix p:not(.s-lbl) { margin: 0; color: #134e48; }
  .conf { margin-left: auto; color: var(--acc); }
  .bar { display: block; height: 4px; margin-top: 10px; border-radius: 4px; background: rgb(15 118 110 / 0.15); }
  .bar i { display: block; width: 64%; height: 100%; border-radius: 4px; background: var(--acc); }
  .s-acts { display: grid; gap: 8px; margin-top: 14px; }
  .s-acts .btn { padding: 11px; }
  .s-note { display: flex; align-items: center; gap: 6px; margin: 12px 0 0; color: var(--mute); font-size: 11px; }
  .reset { display: inline-flex; align-items: center; gap: 5px; margin-top: 8px; border: 0; background: none; color: var(--ink-muted); font-size: var(--text-sm); cursor: pointer; }

  @container (max-width: 760px) {
    .app { grid-template-columns: 1fr; min-height: 0; }
    .rail { display: none; }
    .main { padding: 14px 12px 14px; }
    .seg { display: none; }
    h4 { font-size: 20px; }
    .cta { padding: 7px 11px; }
    .kpis { grid-template-columns: repeat(3, 72%); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 4px; }
    .kpi { scroll-snap-align: start; }
    .grid { grid-template-columns: 1fr; }
    .stages { grid-template-columns: 1fr; gap: 5px; }
    .stages li { grid-template-columns: 26px 1fr auto; align-items: center; gap: 4px 10px; padding: 8px 10px; }
    .flow { grid-column: 1 / -1; margin-top: 2px; }
    .flag { position: static; grid-column: 3; grid-row: 1; justify-self: end; }
    .loop .st-c { grid-column: 3; grid-row: 1; margin-right: 46px; }
    .alert { flex-wrap: wrap; } .alert p { flex-basis: calc(100% - 44px); } .alert .btn { width: 100%; }
    .sheet { top: auto; left: 8px; right: 8px; bottom: 8px; width: auto; max-height: 86%; border-radius: 20px; animation-name: up; }
    @keyframes up { from { transform: translateY(30px); opacity: 0; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow i, .live, .alert, .sheet, .scrim { animation: none; }
  }
</style>
