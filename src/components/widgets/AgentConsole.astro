---
/* Claims control room, re-created with a stand-in brand, payers and data.
   Five agents move claims through a pipeline; when a claim loops, the console
   raises it and a person decides. */
import BrowserFrame from "../BrowserFrame.astro";
import Icon from "../Icon.astro";
const stages = [
  { n: "Intake", a: "Intake agent", i: "tray-arrow-down", c: 214, w: 62 },
  { n: "Coding", a: "Coding agent", i: "code", c: 386, w: 88 },
  { n: "Eligibility", a: "Eligibility agent", i: "shield-check", c: 301, w: 74 },
  { n: "Submission", a: "Submission agent", i: "paper-plane-tilt", c: 248, w: 66 },
  { n: "Denials", a: "Denials agent", i: "arrows-counter-clockwise", c: 135, w: 40, loop: true },
];
const queue = [
  { s: 94, id: "DN-88213", p: "Northgate TPA", why: "Procedure and diagnosis mismatch", amt: "18,400", t: "3h", hot: true },
  { s: 87, id: "PA-77102", p: "Crescent Health", why: "Medical necessity, awaiting notes", amt: "9,120", t: "6h", hot: true },
  { s: 81, id: "AP-33410", p: "Harbour Mutual", why: "Expired referral", amt: "7,800", t: "1d" },
  { s: 74, id: "DN-90045", p: "Oasis Care TPA", why: "Expired referral", amt: "4,350", t: "1d 6h" },
  { s: 69, id: "EL-12087", p: "Gulf Shield", why: "Member ID not found", amt: "2,980", t: "2d" },
];
---

<div class="ac" data-console data-state="loop">
  <BrowserFrame address="app.relayclaims.example/control-room" label="Re-created claims control room">
    <div class="app">
      <nav class="side" aria-hidden="true">
        <div class="ws"><span class="logo"><i></i></span><span><b>Relay</b><small>Northgate Clinics</small></span><Icon name="caret-up-down" size={13} /></div>
        <div class="find"><Icon name="magnifying-glass" size={13} /><span>Search claims</span><kbd>⌘K</kbd></div>
        <ul class="nav">
          <li class="on"><Icon name="squares-four" size={15} weight="fill" />Control room</li>
          <li><Icon name="files" size={15} />Claims</li>
          <li><Icon name="arrows-counter-clockwise" size={15} />Denials<em class="sw-loop">1</em></li>
          <li><Icon name="robot" size={15} />Agents</li>
          <li><Icon name="chart-line-up" size={15} />Reports</li>
        </ul>
        <p class="grp">Views</p>
        <ul class="nav views">
          <li><i class="vd r"></i>Needs a person<em class="sw-loop">1</em></li>
          <li><i class="vd a"></i>Due in 24 hours<em>5</em></li>
          <li><i class="vd g"></i>Over AED 10k<em>12</em></li>
        </ul>
        <div class="me"><span class="av">LA</span><span><b>Lina Aziz</b><small>Billing lead</small></span></div>
      </nav>

      <main class="main">
        <header class="top">
          <p class="crumb"><span>Northgate Clinics</span><Icon name="caret-right" size={11} /><b>Control room</b></p>
          <span class="seg"><span>Today</span><b>This week</b><span>Month</span></span>
        </header>

        <section class="pipe">
          <p class="h"><b>Agent pipeline</b><span class="live"><i></i>All five agents running</span><small>Claims at each stage, this week · sample data</small></p>
          <ol class="stages">
            {stages.map((st, i) => (
              <li class:list={[{ loop: st.loop }]}>
                <span class="st-top"><span class="st-ic"><Icon name={st.i} size={14} /></span><span class="st-n">{st.n}</span>{i < 4 && <Icon name="caret-right" size={11} class="st-arrow" />}</span>
                <b class="st-c tabular-nums" data-count={st.loop ? "loop" : undefined}>{st.c}</b>
                <span class="st-bar" aria-hidden="true"><i style={`--w:${st.w}%`}></i></span>
                <small>{st.loop ? <span class="sw-loop flagtxt">1 loop stopped</span> : st.a}</small>
              </li>
            ))}
          </ol>
        </section>

        <section class="queue">
          <p class="qh"><b>Priority queue</b><span class="sort">Ranked by value and time left <Icon name="caret-down" size={11} /></span></p>
          <div class="tbl">
            <div class="row head" aria-hidden="true"><span>Score</span><span>Claim</span><span>Why it's here</span><span class="r">AED</span><span class="r">Due</span></div>

            <div class="row alert sw-loop" role="status">
              <span class="score loopsc"><Icon name="arrows-counter-clockwise" size={13} weight="bold" /></span>
              <span class="cl"><b>CL-2041 · Crescent Health</b><small>Denied 3 times. The agents stopped retrying.</small></span>
              <span class="why"><em class="tag red">Denial loop</em></span>
              <span class="r tabular-nums">6,250</span>
              <span class="r"><button type="button" class="btn dark" data-open>Review</button></span>
            </div>
            <div class="row alert ok sw-fixed" role="status">
              <span class="score oksc"><Icon name="check" size={13} weight="bold" /></span>
              <span class="cl"><b>CL-2041 · resubmitted</b><small>Back in Submission, logged under your name.</small></span>
              <span class="why"><em class="tag green">Your fix</em></span>
              <span class="r tabular-nums">6,250</span>
              <span class="r"><button type="button" class="btn ghost" data-undo>Undo</button></span>
            </div>
            <div class="row alert mine sw-mine" role="status">
              <span class="score minesc">LA</span>
              <span class="cl"><b>CL-2041 · assigned to you</b><small>The agents won't touch it until you hand it back.</small></span>
              <span class="why"><em class="tag blue">Agents paused</em></span>
              <span class="r tabular-nums">6,250</span>
              <span class="r"><button type="button" class="btn ghost" data-undo>Hand back</button></span>
            </div>

            {queue.map((q) => (
              <div class="row">
                <span class="score tabular-nums">{q.s}</span>
                <span class="cl"><b>{q.id} · {q.p}</b></span>
                <span class="why"><small>{q.why}</small></span>
                <span class="r tabular-nums">{q.amt}</span>
                <span class:list={["r due", { hot: q.hot }]}>{q.t}</span>
              </div>
            ))}
          </div>
        </section>
      </main>

      <div class="scrim" data-scrim hidden></div>
      <aside class="sheet" data-sheet hidden role="dialog" aria-label="Claim CL-2041">
        <header class="s-head">
          <div><small>CL-2041 · Crescent Health</small><b>AED 6,250 · physiotherapy session</b></div>
          <button type="button" class="x" data-close aria-label="Close"><Icon name="x" size={15} /></button>
        </header>
        <p class="s-lbl">What the agents tried</p>
        <ol class="tries">
          <li><b>Coding agent</b> sent procedure 97110 with the visit's diagnosis.<span class="den">Denied: not covered for this diagnosis</span></li>
          <li><b>Denials agent</b> added a modifier and resubmitted.<span class="den">Denied: same reason</span></li>
          <li><b>Denials agent</b> attached the treatment notes.<span class="den">Denied: same reason · retries stopped</span></li>
        </ol>
        <div class="fix">
          <p class="s-lbl">Suggested fix <span class="conf">Confidence 64%</span></p>
          <p>Code the session as 97112, which matches the balance work in the notes, and link it to the same diagnosis.</p>
          <span class="bar" aria-hidden="true"><i></i></span>
        </div>
        <div class="s-acts">
          <button type="button" class="btn dark" data-approve>Approve fix and resubmit</button>
          <button type="button" class="btn ghost" data-take>Take it over</button>
        </div>
        <p class="s-note"><Icon name="info" size={12} />Sample codes and data. Nothing is sent without a person approving it.</p>
      </aside>
    </div>
  </BrowserFrame>
  <button type="button" class="reset" data-reset><Icon name="arrow-counter-clockwise" size={12} />Reset</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-console]").forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const sheet = q("[data-sheet]"), scrim = q("[data-scrim]"), count = q('[data-count="loop"]');
    const open = (v: boolean) => { sheet.hidden = !v; scrim.hidden = !v; if (v) q<HTMLButtonElement>("[data-approve]").focus({ preventScroll: true }); };
    const set = (s: string) => { root.dataset.state = s; count.textContent = s === "loop" ? "135" : "134"; };
    q("[data-open]").addEventListener("click", () => open(true));
    q("[data-close]").addEventListener("click", () => open(false));
    scrim.addEventListener("click", () => open(false));
    q("[data-approve]").addEventListener("click", () => { open(false); set("fixed"); });
    q("[data-take]").addEventListener("click", () => { open(false); set("mine"); });
    root.querySelectorAll("[data-undo]").forEach((b) => b.addEventListener("click", () => set("loop")));
    q("[data-reset]").addEventListener("click", () => { open(false); set("loop"); });
    sheet.addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Escape") open(false); });
  });
</script>

<style>
  .ac {
    container-type: inline-size;
    --ink: #16181d;
    --ink2: #4d535c;
    --mute: #8b919a;
    --line: #ebecee;
    --soft: #f7f7f8;
    --acc: #0f7a6a;
    --acc-soft: #e2f3ef;
    --red: #cf3f3f;
    --red-soft: #fcecec;
    --amber: #b7791f;
    --blue: #3b5bdb;
  }
  .app {
    position: relative;
    display: grid;
    grid-template-columns: 196px 1fr;
    min-height: 560px;
    overflow: hidden;
    background: #fff;
    color: var(--ink);
    font: 13px/1.4 var(--font-sans);
  }
  button {
    font: inherit;
  }
  :is(.btn, .x, .reset):focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }

  /* Sidebar */
  .side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 10px;
    background: var(--soft);
    border-right: 1px solid var(--line);
    color: var(--ink2);
  }
  .ws {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 4px 6px 10px;
  }
  .ws > span:nth-child(2) {
    display: grid;
    flex: 1;
    line-height: 1.2;
  }
  .ws b {
    color: var(--ink);
    font-weight: 600;
  }
  .ws small {
    font-size: 11.5px;
    color: var(--mute);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: var(--acc);
  }
  .logo i {
    width: 12px;
    height: 12px;
    border: 2.5px solid #fff;
    border-radius: 50% 50% 50% 0;
  }
  .find {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    margin-bottom: 8px;
    padding: 0 8px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    color: var(--mute);
    font-size: 12.5px;
  }
  .find kbd {
    margin-left: auto;
    font: 11px var(--font-sans);
    color: var(--mute);
  }
  .nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav li {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 30px;
    padding: 0 8px;
    border-radius: 7px;
  }
  .nav .on {
    background: #fff;
    color: var(--ink);
    font-weight: 550;
    box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgb(0 0 0 / 0.04);
  }
  .nav em {
    margin-left: auto;
    font-style: normal;
    font-size: 11.5px;
    color: var(--mute);
  }
  .nav em.sw-loop {
    min-width: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    text-align: center;
    font-weight: 600;
  }
  .grp {
    margin: 14px 8px 4px;
    font-size: 11.5px;
    font-weight: 550;
    color: var(--mute);
  }
  .vd {
    width: 8px;
    height: 8px;
    margin: 0 3px;
    border-radius: 2px;
  }
  .vd.r { background: var(--red); }
  .vd.a { background: #c9c8c3; }
  .vd.g { background: #c9c8c3; }
  .me {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: auto;
    padding: 8px 6px 0;
  }
  .me span:last-child {
    display: grid;
    line-height: 1.25;
  }
  .me b {
    color: var(--ink);
    font-weight: 550;
  }
  .me small {
    font-size: 11.5px;
    color: var(--mute);
  }
  .av {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f1e3c8;
    color: #6b4a10;
    font-size: 10.5px;
    font-weight: 650;
  }

  /* Main */
  .main {
    min-width: 0;
    padding: 0 0 18px;
  }
  .top {
    display: flex;
    align-items: center;
    height: 46px;
    padding: 0 20px;
    border-bottom: 1px solid var(--line);
  }
  .crumb {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--mute);
  }
  .crumb b {
    color: var(--ink);
    font-weight: 550;
  }
  .seg {
    display: inline-flex;
    margin-left: auto;
    padding: 2px;
    border-radius: 8px;
    background: var(--soft);
    box-shadow: 0 0 0 1px var(--line);
    font-size: 12px;
    color: var(--ink2);
  }
  .seg > * {
    padding: 3px 10px;
    border-radius: 6px;
  }
  .seg b {
    background: #fff;
    color: var(--ink);
    font-weight: 550;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .pipe,
  .queue {
    padding: 16px 20px 0;
  }
  .h,
  .qh {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0 0 10px;
  }
  .h b,
  .qh b {
    font-size: 14px;
    font-weight: 600;
  }
  .h small {
    margin-left: auto;
    color: var(--mute);
    font-size: 12px;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--acc);
  }
  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--acc);
    box-shadow: 0 0 0 3px var(--acc-soft);
    animation: beat 2s ease-in-out infinite;
  }
  @keyframes beat {
    50% {
      box-shadow: 0 0 0 5px transparent;
    }
  }
  .stages {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .stages li {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
  }
  .stages li + li {
    border-left: 1px solid var(--line);
  }
  .st-top {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--ink2);
  }
  .st-ic {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--soft);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink2);
  }
  .st-top :global(.st-arrow) {
    margin-left: auto;
    color: #c2c6cc;
  }
  .st-c {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .st-bar {
    height: 4px;
    border-radius: 2px;
    background: #f0f1f3;
    overflow: hidden;
  }
  .st-bar i {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 2px;
    background: var(--acc);
  }
  .stages small {
    font-size: 11.5px;
    color: var(--mute);
  }
  .stages .loop {
    background: #fff;
  }
  .ac:not([data-state="loop"]) .stages .loop {
    background: none;
  }
  .stages .loop .st-ic {
    background: #fff;
    color: var(--red);
  }
  .stages .loop .st-bar i {
    background: var(--red);
  }
  .ac:not([data-state="loop"]) .stages .loop .st-bar i {
    background: var(--acc);
  }
  .flagtxt {
    color: var(--red);
    font-weight: 550;
  }

  .qh .sort {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    font-size: 12px;
    color: var(--mute);
  }
  .tbl {
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1.3fr) minmax(0, 1.2fr) 74px 86px;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 6px 14px;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  .row.head {
    min-height: 32px;
    background: var(--soft);
    font-size: 11.5px;
    font-weight: 550;
    color: var(--mute);
  }
  .r {
    justify-self: end;
    text-align: right;
  }
  .score {
    display: grid;
    place-items: center;
    width: 30px;
    height: 24px;
    border-radius: 6px;
    background: var(--soft);
    box-shadow: 0 0 0 1px var(--line);
    font-size: 12px;
    font-weight: 600;
  }
  .cl {
    display: grid;
    min-width: 0;
  }
  .cl b {
    font-weight: 550;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cl small,
  .why small {
    color: var(--mute);
    font-size: 12px;
  }
  .why small {
    color: var(--ink2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }
  .due {
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
  }
  .due.hot {
    color: var(--red);
    font-weight: 550;
  }
  .tag {
    display: inline-flex;
    padding: 2px 8px;
    border-radius: 999px;
    font-style: normal;
    font-size: 11.5px;
    font-weight: 550;
  }
  .tag.red { background: var(--red-soft); color: var(--red); }
  .tag.green { background: var(--acc-soft); color: var(--acc); }
  .tag.blue { background: #e8edfd; color: var(--blue); }
  .alert {
    background: color-mix(in srgb, var(--red-soft) 60%, #fff);
  }
  .alert.ok {
    background: color-mix(in srgb, var(--acc-soft) 55%, #fff);
  }
  .alert.mine {
    background: #f4f6fe;
  }
  .loopsc { background: var(--red); color: #fff; box-shadow: none; }
  .oksc { background: var(--acc); color: #fff; box-shadow: none; }
  .minesc { background: #f1e3c8; color: #6b4a10; box-shadow: none; font-size: 10.5px; }
  .sw-fixed,
  .sw-mine {
    display: none !important;
  }
  .ac[data-state="fixed"] .sw-fixed,
  .ac[data-state="mine"] .sw-mine {
    display: grid !important;
    animation: in 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ac:not([data-state="loop"]) .sw-loop {
    display: none !important;
  }
  @keyframes in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    font-weight: 550;
    font-size: 12.5px;
    white-space: nowrap;
    cursor: pointer;
  }
  .btn.dark {
    background: var(--ink);
    color: #fff;
  }
  .btn.ghost {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgb(0 0 0 / 0.04);
  }

  /* Detail panel */
  .scrim {
    position: absolute;
    inset: 0;
    background: rgb(16 18 24 / 0.12);
  }
  .sheet {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 92%);
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    background: #fff;
    box-shadow: -1px 0 0 var(--line), -24px 0 48px -24px rgb(0 0 0 / 0.25);
    animation: slide 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sheet[hidden],
  .scrim[hidden] {
    display: none;
  }
  @keyframes slide {
    from {
      transform: translateX(24px);
      opacity: 0;
    }
  }
  .s-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .s-head div {
    display: grid;
    flex: 1;
  }
  .s-head small {
    color: var(--mute);
  }
  .s-head b {
    font-size: 15px;
    font-weight: 600;
  }
  .x {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 7px;
    background: var(--soft);
    color: var(--ink2);
    cursor: pointer;
  }
  .s-lbl {
    display: flex;
    align-items: center;
    margin: 4px 0 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--mute);
  }
  .tries {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    border-left: 1.5px solid var(--line);
    display: grid;
    gap: 10px;
    color: var(--ink2);
  }
  .tries li {
    position: relative;
  }
  .tries li::before {
    content: "";
    position: absolute;
    left: -19px;
    top: 5px;
