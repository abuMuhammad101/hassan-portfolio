---
/* Illustrated stand-ins for the hero photography: an airport at dusk, the
   road between the cities, and a morning of ziyarat among the palms. */
import Vehicle from "./Vehicle.astro";
interface Props {
  kind: "dusk" | "road" | "palms";
  class?: string;
}
const { kind, class: cls = "" } = Astro.props;
const id = `sc-${kind}-${Math.random().toString(36).slice(2, 7)}`;

// A date palm: trunk plus a crown of fronds, built from a few curves.
const palm = (x: number, base: number, h: number, lean = 0, s = 1) => {
  const top = { x: x + lean, y: base - h };
  const fronds = [-150, -120, -95, -70, -40, -15, 10, 200, 230].map((a) => {
    const r = (a * Math.PI) / 180;
    const len = 46 * s;
    const ex = top.x + Math.cos(r) * len;
    const ey = top.y + Math.sin(r) * len * 0.55 + 18 * s;
    const cx = top.x + Math.cos(r) * len * 0.5;
    const cy = top.y + Math.sin(r) * len * 0.5 - 10 * s;
    return `M${top.x} ${top.y} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`;
  });
  return { trunk: `M${x - 4 * s} ${base} Q${x + lean * 0.4} ${base - h * 0.5} ${top.x - 2 * s} ${top.y} L${top.x + 2 * s} ${top.y} Q${x + lean * 0.4 + 6 * s} ${base - h * 0.5} ${x + 4 * s} ${base} Z`, fronds };
};
const palms = [palm(120, 300, 150, -10, 1.1), palm(205, 304, 118, 8, 0.9), palm(640, 300, 170, 12, 1.2), palm(712, 306, 120, -6, 0.85)];
---

<div class={`scene ${cls}`} aria-hidden="true">
  {kind === "dusk" && (
    <svg viewBox="0 0 800 360" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3e3f63" />
          <stop offset="0.38" stop-color="#9a6f86" />
          <stop offset="0.66" stop-color="#e59c6c" />
          <stop offset="0.82" stop-color="#f6c58a" />
        </linearGradient>
        <radialGradient id={`${id}-sun`} cx="0.62" cy="0.76" r="0.5">
          <stop offset="0" stop-color="#fff3d1" stop-opacity="0.95" />
          <stop offset="0.12" stop-color="#ffd99a" stop-opacity="0.6" />
          <stop offset="1" stop-color="#ffd99a" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="800" height="360" fill={`url(#${id}-sky)`} />
      <rect width="800" height="360" fill={`url(#${id}-sun)`} />
      <circle cx="500" cy="270" r="26" fill="#fff1cf" opacity="0.9" />
      <!-- a plane climbing out, with its trail -->
      <path d="M150 128 C260 112 360 92 470 70" stroke="#fff" stroke-opacity="0.45" stroke-width="1.4" fill="none" stroke-linecap="round" />
      <g transform="translate(476 66) rotate(-11)" fill="#2c2b40">
        <path d="M-22 0 L18 -2 C24 -2 26 0 26 1 C26 2 24 3 18 3 L-22 2 Z" />
        <path d="M-2 0 L-12 -12 L-6 -12 L8 0 Z" />
        <path d="M-2 2 L-12 13 L-6 13 L8 2 Z" />
        <path d="M-20 0 L-26 -7 L-22 -7 L-16 0 Z" />
      </g>
      <!-- the city on the horizon -->
      <path d="M0 286 L40 286 L40 272 L58 272 L58 280 L92 280 L92 262 L104 262 L104 280 L150 280 L150 270 L190 270 L190 284 L250 284 L250 276 L300 276 L300 286 L360 286 L360 278 L420 278 L420 288 L800 288 L800 360 L0 360 Z" fill="#6b5168" opacity="0.55" />
      <!-- terminal and control tower -->
      <path d="M560 300 L560 268 C600 254 690 254 760 262 L760 300 Z" fill="#3b2f45" />
      <path d="M572 268 L748 263" stroke="#f7c98a" stroke-opacity="0.5" stroke-width="2" />
      <rect x="616" y="196" width="12" height="80" fill="#3b2f45" />
      <path d="M604 196 L640 196 L634 178 L610 178 Z" fill="#3b2f45" />
      <rect x="612" y="182" width="20" height="8" fill="#f7c98a" opacity="0.7" />
      <rect x="621" y="166" width="2" height="12" fill="#3b2f45" />
      <!-- apron and runway lights -->
      <path d="M0 300 L800 300 L800 360 L0 360 Z" fill="#2a2436" />
      <path d="M0 300 L800 300" stroke="#4a3e55" stroke-width="2" />
      {Array.from({ length: 22 }).map((_, k) => (
        <circle cx={20 + k * 36} cy={318 + (k % 2) * 0} r="1.8" fill={k % 5 === 0 ? "#ff8a5c" : "#ffe3a6"} opacity="0.85" />
      ))}
      <path d="M0 340 L800 330" stroke="#ffe3a6" stroke-opacity="0.25" stroke-dasharray="14 18" stroke-width="2" />
    </svg>
  )}

  {kind === "road" && (
    <svg viewBox="0 0 800 360" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#9cc3d8" />
          <stop offset="0.55" stop-color="#e6ddc8" />
          <stop offset="0.7" stop-color="#f1dcb5" />
        </linearGradient>
        <linearGradient id={`${id}-sand`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#dcbc8a" />
          <stop offset="1" stop-color="#b98d58" />
        </linearGradient>
      </defs>
      <rect width="800" height="360" fill={`url(#${id}-sky)`} />
      <!-- the Hejaz ranges, far and near -->
      <path d="M0 214 L60 190 L110 204 L170 168 L230 196 L290 176 L340 200 L420 160 L480 192 L540 172 L610 198 L680 166 L740 190 L800 178 L800 240 L0 240 Z" fill="#b39a84" opacity="0.55" />
      <path d="M0 236 L50 214 L96 226 L150 196 L210 222 L262 206 L320 230 L380 210 L440 232 L520 200 L580 226 L650 206 L720 228 L800 210 L800 260 L0 260 Z" fill="#8c705c" opacity="0.7" />
      <path d="M0 250 C140 236 300 246 420 242 C560 238 680 246 800 240 L800 360 L0 360 Z" fill={`url(#${id}-sand)`} />
      <path d="M0 290 C160 270 260 300 420 284 C560 270 700 300 800 286 L800 360 L0 360 Z" fill="#c79d65" opacity="0.6" />
      <!-- the highway, running to the horizon -->
      <path d="M392 246 L410 246 L800 330 L800 360 L-40 360 Z" fill="#4d4a46" />
      <path d="M392 246 L-40 360" stroke="#efe6d4" stroke-width="2" />
      <path d="M410 246 L800 334" stroke="#efe6d4" stroke-width="2" />
      <path d="M401 247 L380 360" stroke="#f3cf6a" stroke-width="3" stroke-dasharray="16 16" />
      <!-- a road sign -->
      <rect x="600" y="214" width="3" height="66" fill="#6a6660" />
      <rect x="566" y="200" width="72" height="26" rx="3" fill="#1d6b45" stroke="#fff" stroke-width="1.5" />
      <path d="M576 213 L626 213 M618 207 L626 213 L618 219" stroke="#fff" stroke-width="2" fill="none" />
      <Vehicle kind="van" at={[150, 268, 170]} />
    </svg>
  )}

  {kind === "palms" && (
    <svg viewBox="0 0 800 360" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#bcdcea" />
          <stop offset="0.7" stop-color="#f4efe2" />
        </linearGradient>
      </defs>
      <rect width="800" height="360" fill={`url(#${id}-sky)`} />
      <circle cx="610" cy="96" r="44" fill="#fff8e6" opacity="0.8" />
      <!-- a dome and minarets in the distance -->
      <g fill="#7f9a8b" opacity="0.75">
        <rect x="330" y="196" width="150" height="70" />
        <path d="M360 198 C360 150 450 150 450 198 Z" />
        <rect x="402" y="140" width="6" height="16" />
        <rect x="312" y="120" width="12" height="146" />
        <path d="M309 122 L327 122 L318 98 Z" />
        <rect x="486" y="120" width="12" height="146" />
        <path d="M483 122 L501 122 L492 98 Z" />
      </g>
      <path d="M0 262 L800 262 L800 360 L0 360 Z" fill="#d9c49c" />
      <path d="M0 262 L800 262" stroke="#c4ab7d" stroke-width="2" />
      <!-- a low garden wall -->
      <path d="M0 286 L800 286 L800 300 L0 300 Z" fill="#c9b289" />
      {Array.from({ length: 20 }).map((_, k) => <rect x={k * 42} y="280" width="22" height="8" fill="#c9b289" />)}
      {palms.map((p) => (
        <g>
          <path d={p.trunk} fill="#7a5b3c" />
          {p.fronds.map((f) => <path d={f} stroke="#3f6a48" stroke-width="7" stroke-linecap="round" fill="none" />)}
        </g>
      ))}
      <Vehicle kind="suv" at={[300, 248, 190]} />
    </svg>
  )}
</div>

<style>
  .scene,
  .scene svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
