---
/* Voice-first copilot over a tablet app, re-created with stand-in brand,
   names and data. Monochrome overlay; it asks only for what's missing,
   and the clinician confirms every step. */
import Icon from "../Icon.astro";
const patients = [
  ["AB", "Arthur Bell", "PT · Plan of care certified", "Active"],
  ["RL", "Rosa Lind", "OT · Evaluation due", "Pending"],
  ["OH", "Omar Haddad", "RT · 4 of 12 visits", "Active"],
  ["MK", "Mei Kato", "PT · Discharge planned", "Discharge"],
  ["JS", "Jonah Sterne", "ST · Re-evaluation", "Active"],
];
---

<div class="cp" data-copilot data-step="idle">
  <div class="tablet" role="group" aria-label="Re-created tablet app with a voice copilot">
    <div class="screen">
      <div class="app" aria-hidden="true">
        <header class="bar">
          <Icon name="list" size={18} />
          <span class="brand"><i class="mark"></i>Strand</span>
          <span class="end"><Icon name="magnifying-glass" size={17} /><span class="av sm warm">KR</span></span>
        </header>
        <div class="dash">
          <div class="dh"><h4>Today</h4><span class="add"><Icon name="plus" size={13} weight="bold" />Add patient</span></div>
          <p class="lbl">Recently viewed</p>
          <div class="recent">{patients.map(([i, n]) => <span><b class="av">{i}</b>{n.split(" ")[0]}</span>)}</div>
          <p class="lbl">My patients · 5</p>
          <ul class="list">
            {patients.map(([i, n, d, s]) => (
              <li><b class="av">{i}</b><span><strong>{n}</strong><small>{d}</small></span><em class={s.toLowerCase()}>{s}</em><Icon name="caret-right" size={13} /></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="veil" aria-hidden="true"></div>

      <div class="layer" aria-live="polite">
        <p class="said"><span class="q">“</span><span data-said></span><span class="q">”</span></p>
        <ol class="dots" aria-hidden="true"><li data-d="patient"></li><li data-d="device"></li><li data-d="details"></li><li data-d="ready"></li></ol>

        <!-- idle -->
        <div class="hint st-idle">
          <span class="spark"><Icon name="sparkle" size={14} weight="fill" /></span>
          Tap the mic and try <b>“Start a breathing test for Arthur.”</b>
        </div>

        <!-- listening -->
        <div class="orb st-listen"><span></span><span></span><span></span><i><Icon name="waveform" size={26} /></i></div>

        <!-- patient -->
        <div class="stage st-patient">
          <p class="ask">Is this the right patient?</p>
          <div class="tile wide"><b class="av lg">AB</b><span><strong>Arthur Bell</strong><small>78 · Room 214 · RT case will be created</small></span></div>
          <div class="acts"><button type="button" class="ghost" data-go="listen">Someone else</button><button type="button" class="solid" data-go="device">Yes, that's him</button></div>
        </div>

        <!-- device -->
        <div class="stage st-device">
          <div class="rings"><span></span><span></span><span></span><i><Icon name="device-mobile" size={24} /></i></div>
          <p class="ask"><span class="searching">Looking for the spirometer…</span><span class="found"><Icon name="bluetooth" size={14} /> Spirometer SN-4471 connected</span></p>
          <div class="acts found"><button type="button" class="solid" data-go="details">Continue</button></div>
        </div>

        <!-- details -->
        <div class="stage st-details st-edit">
          <p class="ask"><span class="h-empty">Predicted values need these. One is missing.</span><span class="h-set">All set. Pulled from Arthur's record.</span></p>
          <div class="tiles">
            <div class="tile"><strong>Male</strong><small>Sex</small></div>
            <div class="tile"><strong>12/04/1948</strong><small>Date of birth</small></div>
            <div class="tile"><strong>74 kg</strong><small>Weight</small></div>
            <button type="button" class="tile need" data-go="edit"><strong class="h-empty">Add</strong><strong class="h-set">5 ft 6 in</strong><small>Height</small><Icon name="pencil-simple" size={13} /></button>
            <div class="tile"><strong>From record</strong><small>Ethnicity</small></div>
          </div>
          <div class="capsule" role="group" aria-label="Height">
            <span class="num"><b>5</b><small>ft</small></span><span class="num"><b>6</b><small>in</small></span><span class="cm">168 cm</span>
            <button type="button" class="ok" data-go="details-set" aria-label="Confirm height"><Icon name="check" size={16} weight="bold" /></button>
          </div>
          <div class="acts h-set"><button type="button" class="solid" data-go="ready">Looks right</button></div>
        </div>

        <!-- ready -->
        <div class="stage st-ready">
          <p class="ask">Ready when Arthur is.</p>
          <div class="tile wide instr"><Icon name="wind" size={22} /><span><strong>Breathe in fully, then blow hard and fast</strong><small>Keep going until the device beeps · 3 tries, best one counts</small></span></div>
          <div class="acts"><button type="button" class="solid" data-go="done"><Icon name="play" size={13} weight="fill" />Start test</button></div>
        </div>

        <!-- done -->
        <div class="stage st-done">
          <div class="tile wide result"><span class="check"><Icon name="check" size={16} weight="bold" /></span><span><strong>Saved to Arthur's record</strong><small>FEV1 1.92 L · FVC 2.61 L · 3 tries · sample data</small></span><button type="button" class="undo" data-go="details-set"><Icon name="arrow-u-up-left" size={13} />Undo</button></div>
        </div>

        <!-- exit -->
        <div class="exit" data-exit hidden role="dialog" aria-label="Exit the guide?">
          <strong>Exit the guide?</strong>
          <p>This test isn't finished. Nothing will be saved.</p>
          <div class="acts"><button type="button" class="ghost" data-exit-yes>Exit guide</button><button type="button" class="solid" data-exit-no>Keep going</button></div>
        </div>
      </div>

      <div class="dock">
        <button type="button" class="round back" data-back aria-label="Back"><Icon name="arrow-left" size={17} /></button>
        <button type="button" class="round close" data-close aria-label="Close copilot"><Icon name="x" size={16} /></button>
        <button type="button" class="mic" data-mic aria-label="Talk to the copilot"><Icon name="microphone" size={20} weight="fill" /></button>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-copilot]").forEach((root) => {
    const said = root.querySelector<HTMLElement>("[data-said]")!;
    const exit = root.querySelector<HTMLElement>("[data-exit]")!;
        const order = ["idle", "listen", "patient", "device", "details", "edit", "details-set", "ready", "done"];
    const lines: Record<string, string> = {
      listen: "Start a breathing test for Arthur",
      patient: "Start a breathing test for Arthur",
      device: "Yes, that's him",
      details: "Continue",
      edit: "His height is five six",
      "details-set": "His height is five six",
      ready: "Looks right",
      done: "Start",
    };
    let timers: number[] = [];
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const go = (s: string) => {
      clear();
      root.dataset.step = s;
      root.classList.toggle("found-it", false);
      if (s === "details-set") root.dataset.height = "set";
      if (s === "idle" || s === "listen") delete root.dataset.height;
      said.textContent = lines[s] ?? "";
      if (s === "listen") {
        said.textContent = "";
        const text = lines.listen;
        [...text].forEach((_, i) => timers.push(window.setTimeout(() => (said.textContent = text.slice(0, i + 1)), 400 + i * 38)));
        timers.push(window.setTimeout(() => go("patient"), 400 + text.length * 38 + 600));
      }
      if (s === "device") timers.push(window.setTimeout(() => root.classList.add("found-it"), 1800));
    };
    root.querySelectorAll<HTMLElement>("[data-go]").forEach((b) => b.addEventListener("click", () => go(b.dataset.go!)));
    root.querySelector("[data-mic]")!.addEventListener("click", () => {
      const s = root.dataset.step!;
      if (s === "idle" || s === "done") go("listen");
    });
    root.querySelector("[data-back]")!.addEventListener("click", () => {
      const map: Record<string, string> = { patient: "idle", device: "patient", details: "device", edit: "details", "details-set": "device", ready: "details-set", done: "ready" };
      const s = root.dataset.step!;
      if (map[s]) go(map[s]);
    });
    root.querySelector("[data-close]")!.addEventListener("click", () => {
      const s = root.dataset.step!;
      if (s === "idle") return;
      if (s === "done" || s === "listen" || s === "patient") return go("idle");
      exit.hidden = false;
    });
    root.querySelector("[data-exit-yes]")!.addEventListener("click", () => { exit.hidden = true; go("idle"); });
    root.querySelector("[data-exit-no]")!.addEventListener("click", () => (exit.hidden = true));
    void order;
  });
</script>

<style>
  .cp { container-type: inline-size; --ink: #18191b; --mute: #8b8e94; --line: #ececea; --dark: rgb(30 30 32 / 0.9); }
  .tablet {
    width: 100%; max-width: 1000px; padding: 14px; border-radius: 36px; background: #1b1b1d;
    box-shadow: inset 0 0 0 1.5px #3a3a3d, 0 40px 80px -40px rgb(0 0 0 / 0.55);
  }
  .screen { position: relative; overflow: hidden; height: 650px; border-radius: 24px; background: #fbfbfa; color: var(--ink); font: 13px/1.4 Inter, var(--font-body, system-ui), sans-serif; }

  /* Underlying app */
  .app { position: absolute; inset: 0; transition: filter 0.5s ease, transform 0.5s ease, opacity 0.5s; }
  .cp:not([data-step="idle"]) .app { filter: blur(7px) saturate(0.4); transform: scale(1.015); opacity: 0.55; }
  .bar { display: flex; align-items: center; padding: 14px 22px; color: #45484d; }
  .brand { display: flex; align-items: center; gap: 7px; margin: 0 auto; font-weight: 700; font-size: 16px; letter-spacing: -0.02em; color: var(--ink); }
  .mark { width: 20px; height: 20px; border-radius: 6px; background: radial-gradient(circle at 30% 30%, #8f93f2, #4b4fd6 60%); }
  .end { display: flex; align-items: center; gap: 14px; }
  .dash { padding: 4px 26px; }
  .dh { display: flex; align-items: center; }
  h4 { margin: 0; font-size: 24px; font-weight: 650; letter-spacing: -0.02em; }
  .add { margin-left: auto; display: inline-flex; gap: 6px; align-items: center; padding: 7px 12px; border-radius: 9px; background: var(--ink); color: #fff; font-weight: 600; }
  .lbl { margin: 18px 0 10px; font-size: 12px; font-weight: 600; color: var(--mute); }
  .recent { display: flex; gap: 26px; }
  .recent span { display: grid; justify-items: center; gap: 6px; font-size: 12px; color: #55585e; }
  .av { display: inline-grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: #e6e7fb; color: #3a3ea8; font-weight: 650; font-size: 13px; font-style: normal; }
  .av.sm { width: 28px; height: 28px; font-size: 10px; }
  .av.warm { background: #f5e7c8; color: #7a5410; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .list li { display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px var(--line); color: var(--mute); }
  .list .av { width: 38px; height: 38px; }
  .list span { display: grid; flex: 1; }
  .list strong { color: var(--ink); font-weight: 600; }
  .list em { font-style: normal; font-size: 12px; font-weight: 600; }
  .list em::before { content: "● "; font-size: 9px; }
  .active { color: #23824a; } .pending { color: #a95a0c; } .discharge { color: #b33a3a; }

  /* Overlay */
  .veil { position: absolute; inset: 0; background: radial-gradient(120% 90% at 50% 100%, rgb(255 255 255 / 0.6), rgb(245 245 244 / 0.2)); opacity: 0; transition: opacity 0.4s; pointer-events: none; }
  .cp:not([data-step="idle"]) .veil { opacity: 1; }
  .layer { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .layer > * { grid-area: 1 / 1; pointer-events: auto; }
  .said { align-self: start; margin: 70px 0 0; max-width: 620px; text-align: center; font-size: 22px; font-weight: 550; letter-spacing: -0.015em; color: var(--ink); min-height: 31px; }
  .said .q { color: #b9bbbf; }
  .cp:is([data-step="idle"]) .said { visibility: hidden; }
  .dots { align-self: start; margin-top: 40px; list-style: none; padding: 0; display: flex; gap: 6px; }
  .dots li { width: 18px; height: 3px; border-radius: 2px; background: #d5d6d8; transition: background 0.3s, width 0.3s; }
  .cp:is([data-step="idle"], [data-step="listen"]) .dots { visibility: hidden; }
  .cp[data-step="patient"] [data-d="patient"],
  .cp[data-step="device"] :is([data-d="patient"], [data-d="device"]),
  .cp:is([data-step="details"], [data-step="edit"], [data-step="details-set"]) :is([data-d="patient"], [data-d="device"], [data-d="details"]),
  .cp:is([data-step="ready"], [data-step="done"]) .dots li { background: var(--ink); }

  .st-idle, .st-listen, .st-patient, .st-device, .st-details, .st-ready, .st-done { display: none !important; }
  .cp[data-step="idle"] .st-idle, .cp[data-step="listen"] .st-listen, .cp[data-step="patient"] .st-patient,
  .cp[data-step="device"] .st-device, .cp:is([data-step="details"], [data-step="edit"], [data-step="details-set"]) .st-details,
  .cp[data-step="ready"] .st-ready, .cp[data-step="done"] .st-done { display: grid !important; }

  .cp[data-step="idle"] .hint.st-idle { display: flex !important; }
  .hint { align-self: end; margin-bottom: 92px; white-space: nowrap; align-items: center; gap: 9px; padding: 9px 14px 9px 9px; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 12px 28px -14px rgb(0 0 0 / 0.3); color: #55585e; }
  .cp:not([data-step="idle"]) .hint { display: none !important; }
  .spark { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: #fff; }

  .stage { justify-items: center; gap: 16px; animation: up 0.4s cubic-bezier(.2,.8,.2,1); }
  @keyframes up { from { opacity: 0; transform: translateY(10px) scale(0.98); } }
  .ask { margin: 0; font-size: 15px; font-weight: 600; color: #3d4045; display: flex; align-items: center; gap: 6px; }
  .tile { display: grid; align-content: center; gap: 3px; min-width: 150px; min-height: 92px; padding: 14px 18px; border-radius: 18px; background: var(--dark); color: #fff; text-align: left; border: 0; font: inherit; box-shadow: 0 0 0 1px rgb(255 255 255 / 0.06) inset, 0 18px 36px -18px rgb(0 0 0 / 0.55); backdrop-filter: blur(10px); }
  .tile strong { font-size: 17px; font-weight: 650; letter-spacing: -0.01em; }
  .tile small { color: rgb(255 255 255 / 0.62); font-size: 12px; }
  .tile.wide { display: flex; align-items: center; gap: 14px; min-width: 420px; }
  .tile.wide > span { display: grid; gap: 2px; }
  .tile .av.lg { width: 48px; height: 48px; background: rgb(255 255 255 / 0.14); color: #fff; }
  .tiles { display: grid; grid-template-columns: repeat(3, 160px); gap: 12px; }
  .need { position: relative; cursor: pointer; background: #fff; color: var(--ink); box-shadow: 0 0 0 2px var(--ink), 0 18px 36px -18px rgb(0 0 0 / 0.4); }
  .need small { color: var(--mute); }
  .need :global(svg) { position: absolute; top: 12px; right: 12px; }
  .h-set { display: none !important; }
  .cp[data-height="set"] .h-set { display: revert !important; }
  .cp[data-height="set"] .h-empty { display: none; }
  .cp[data-height="set"] .need { background: var(--dark); color: #fff; box-shadow: 0 18px 36px -18px rgb(0 0 0 / 0.55); }
  .cp[data-height="set"] .need small { color: rgb(255 255 255 / 0.62); }
  .cp[data-height="set"] .acts.h-set { display: flex !important; }

  .st-details { position: relative; }
  .capsule { position: absolute; inset: 0; margin: auto; width: fit-content; height: fit-content; display: none; align-items: center; gap: 22px; padding: 10px 10px 10px 28px; border-radius: 20px; background: var(--dark); color: #fff; box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.6); animation: up 0.3s ease-out; }
  .cp[data-step="edit"] .capsule { display: flex; }
  .cp[data-step="edit"] .tiles { opacity: 0.25; pointer-events: none; filter: blur(2px); }
  .num b { font-size: 30px; font-weight: 650; }
  .num small { margin-left: 4px; color: rgb(255 255 255 / 0.6); }
  .cm { margin-left: 40px; color: rgb(255 255 255 / 0.6); }
  .ok { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.5); background: none; color: #fff; cursor: pointer; }

  .acts { display: flex; gap: 10px; justify-content: center; }
  .solid, .ghost { display: inline-flex; align-items: center; gap: 7px; padding: 10px 18px; border-radius: 999px; font: inherit; font-weight: 600; cursor: pointer; border: 0; }
  .solid { background: var(--ink); color: #fff; box-shadow: 0 10px 22px -12px rgb(0 0 0 / 0.6); }
  .ghost { background: #fff; color: var(--ink); box-shadow: 0 0 0 1px #dcdcda; }
  :is(.solid, .ghost, .ok, .mic, .round, .need, .undo):focus-visible { outline: 2px solid #4b4fd6; outline-offset: 3px; }

  .orb, .rings { position: relative; width: 220px; height: 220px; display: grid !important; place-items: center; }
  .cp:not([data-step="listen"]) .orb { display: none !important; }
  .orb span, .rings span { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgb(24 25 27 / 0.18); animation: pulse 2.4s ease-out infinite; }
  .orb span:nth-child(2), .rings span:nth-child(2) { animation-delay: 0.8s; }
  .orb span:nth-child(3), .rings span:nth-child(3) { animation-delay: 1.6s; }
  .orb i, .rings i { display: grid; place-items: center; width: 92px; height: 92px; border-radius: 50%; background: #2a2a2d; color: #fff; box-shadow: 0 0 0 10px rgb(255 255 255 / 0.7), 0 0 0 11px rgb(24 25 27 / 0.12), 0 20px 40px -14px rgb(0 0 0 / 0.5); }
  @keyframes pulse { from { transform: scale(0.45); opacity: 1; } to { transform: scale(1); opacity: 0; } }
  .found { display: none !important; }
  .cp.found-it .found { display: inline-flex !important; }
  .cp.found-it .searching { display: none; }
  .cp.found-it .rings span { animation: none; opacity: 0; }

  .instr :global(svg) { flex: none; }
  .result { gap: 12px !important; }
  .check { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #fff; color: var(--ink); flex: none; }
  .undo { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; padding: 7px 12px; border-radius: 999px; border: 0; background: rgb(255 255 255 / 0.12); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }

  .exit { display: grid; justify-items: center; gap: 6px; padding: 26px 30px; border-radius: 22px; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 30px 60px -24px rgb(0 0 0 / 0.45); z-index: 3; text-align: center; }
  .exit[hidden] { display: none; }
  .exit strong { font-size: 19px; }
  .exit p { margin: 0 0 10px; color: #55585e; }

  .screen::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 170px; background: linear-gradient(rgb(251 251 250 / 0), #fbfbfa 62%); pointer-events: none; z-index: 1; }
  .layer, .dock { z-index: 2; }
  .dock { position: absolute; left: 0; right: 0; bottom: 22px; display: flex; justify-content: center; gap: 14px; }
  .round { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 0; background: #fff; color: var(--ink); cursor: pointer; box-shadow: 0 0 0 1px #e2e2df, 0 8px 18px -10px rgb(0 0 0 / 0.35); transition: opacity 0.3s, transform 0.3s; }
  .back { position: absolute; left: 24px; background: #3a3a3d; color: #fff; box-shadow: none; }
  .cp[data-step="idle"] .round { opacity: 0; pointer-events: none; transform: translateY(6px); }
  .mic { display: grid; place-items: center; width: 56px; height: 56px; margin-top: -5px; border-radius: 50%; border: 0; cursor: pointer; background: var(--ink); color: #fff; box-shadow: 0 0 0 5px rgb(255 255 255 / 0.9), 0 0 0 6px #e2e2df, 0 14px 28px -12px rgb(0 0 0 / 0.6); }
  .cp[data-step="listen"] .mic { animation: live 1.2s ease-in-out infinite; }
  @keyframes live { 50% { box-shadow: 0 0 0 9px rgb(255 255 255 / 0.9), 0 0 0 10px #d0d0cd, 0 14px 28px -12px rgb(0 0 0 / 0.6); } }

  @container (max-width: 640px) {
    .tablet { padding: 8px; border-radius: 26px; }
    .screen { height: 600px; border-radius: 19px; font-size: 12.5px; }
    .bar { padding: 12px 16px; } .dash { padding: 2px 16px; }
    h4 { font-size: 21px; } .add { padding: 6px 10px; }
    .recent { gap: 14px; overflow: hidden; } .recent span:nth-child(n+5) { display: none; }
    .list li { padding: 9px 11px; gap: 11px; } .list em { display: none; }
    .said { margin-top: 56px; padding: 0 18px; font-size: 18px; }
    .dots { margin-top: 30px; }
    .cp[data-step="idle"] .hint.st-idle { display: block !important; text-align: center; padding: 10px 14px; border-radius: 16px; }
    .hint .spark { display: inline-grid; vertical-align: middle; margin-right: 6px; width: 20px; height: 20px; }
    .hint { white-space: normal; max-width: calc(100% - 32px); margin-bottom: 88px; font-size: 12px; line-height: 1.35; }
    .stage { width: 100%; padding: 0 16px; box-sizing: border-box; }
    .tile.wide { min-width: 0; width: 100%; box-sizing: border-box; }
    .tiles { grid-template-columns: 1fr 1fr; width: 100%; }
    .tile { min-width: 0; min-height: 78px; padding: 12px 14px; }
    .tile strong { font-size: 15px; }
    .capsule { gap: 14px; padding-left: 18px; } .num b { font-size: 26px; } .cm { margin-left: 4px; }
    .orb, .rings { width: 180px; height: 180px; }
    .back { left: 14px; }
    .undo span, .result small { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orb span, .rings span, .stage, .capsule, .cp[data-step="listen"] .mic { animation: none; }
    .app { transition: none; }
  }
</style>
