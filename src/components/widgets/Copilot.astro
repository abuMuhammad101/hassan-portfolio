---
/* Voice-first copilot over the Strand tablet app, re-created with stand-in
   brand, names and data. The app stays sharp and keeps working underneath;
   the copilot is a monochrome card and a voice bar at the bottom. It asks
   only for what's missing, the clinician confirms every step, and the
   result lands in the chart behind it. */
import Icon from "../Icon.astro";

const patients = [
  { i: "AB", n: "Arthur Bell", d: "PT · Room 214", s: "Visit 9:00", tone: "a" },
  { i: "RL", n: "Rosa Lind", d: "OT · Room 118", s: "Eval due", tone: "b" },
  { i: "OH", n: "Omar Haddad", d: "RT · Room 302", s: "4 of 12", tone: "c" },
  { i: "MK", n: "Mei Kato", d: "PT · Room 207", s: "Discharge", tone: "d" },
  { i: "JS", n: "Jonah Sterne", d: "ST · Room 121", s: "Re-eval", tone: "a" },
];
const today = [
  ["9:00", "Arthur Bell", "PT session · 45 min", "now"],
  ["10:30", "Rosa Lind", "OT evaluation", ""],
  ["11:45", "Omar Haddad", "Breathing exercises", ""],
  ["14:00", "Mei Kato", "Discharge planning", ""],
];
const bars = Array.from({ length: 14 }, (_, i) => 0.25 + Math.abs(Math.sin(i * 1.7)) * 0.75);
---

<div class="cp" data-copilot data-step="idle">
  <button type="button" hidden data-reset-cp aria-hidden="true" tabindex="-1"></button>
  <div class="tablet" role="group" aria-label="Re-created tablet app with a voice copilot">
    <div class="screen">
      <div class="status" aria-hidden="true"><b>9:41</b><span>Tue 4 Mar</span><span class="sys"><Icon name="wifi-high" size={13} weight="bold" /><i class="batt"></i></span></div>

      <!-- The app underneath. It stays sharp and reacts to what the copilot does. -->
      <div class="app" aria-hidden="true">
        <aside class="side">
          <div class="side-h">
            <span class="brand"><i class="mark"></i>Strand</span>
            <span class="av xs warm">KR</span>
          </div>
          <h4>Patients</h4>
          <div class="search"><Icon name="magnifying-glass" size={14} /><span>Search patients</span></div>
          <div class="seg"><span class="on">My list</span><span>Unit</span><span>All</span></div>
          <ul class="plist">
            {patients.map((p, k) => (
              <li class:list={[{ arthur: k === 0 }]}>
                <b class:list={["av", p.tone]}>{p.i}</b>
                <span><strong>{p.n}</strong><small>{p.d}</small></span>
                <em>{p.s}</em>
              </li>
            ))}
          </ul>
        </aside>

        <main class="main">
          <!-- Today: what the clinician sees before asking for anything. -->
          <section class="pane today">
            <div class="ph">
              <div><p class="kick">Tuesday 4 March</p><h3>Today</h3></div>
              <span class="btn"><Icon name="plus" size={13} weight="bold" />Add visit</span>
            </div>
            <div class="sum">
              <div><b>6</b><small>visits</small></div>
              <div><b>2</b><small>notes to sign</small></div>
              <div><b>1</b><small>plan to certify</small></div>
            </div>
            <p class="lbl">Schedule</p>
            <ol class="sched">
              {today.map(([t, n, w, now]) => (
                <li class:list={[{ now: now }]}><time>{t}</time><span><strong>{n}</strong><small>{w}</small></span>{now && <em>In progress</em>}</li>
              ))}
            </ol>
          </section>

          <!-- Arthur's chart: opens once the copilot confirms him. -->
          <section class="pane chart">
            <div class="ph">
              <div class="who"><b class="av lg a">AB</b><div><h3>Arthur Bell <span class="chip ok">Plan certified</span></h3><p class="sub">78 · Male · Room 214 · Medicare A</p></div></div>
            </div>
            <div class="tabs"><span>Overview</span><span>Sessions</span><span class="on">Tests</span><span>Goals</span></div>
            <p class="lbl">Breathing tests</p>
            <ul class="tests">
              <li class="new"><span class="ti"><Icon name="wind" size={15} /></span><span><strong>Spirometry</strong><small>Today, 9:12 · 3 tries · Spirometer SN-4471</small></span><b>1.92 L</b><em>New</em></li>
              <li><span class="ti"><Icon name="wind" size={15} /></span><span><strong>Spirometry</strong><small>25 Feb · 3 tries</small></span><b>1.84 L</b></li>
              <li><span class="ti"><Icon name="wind" size={15} /></span><span><strong>Spirometry</strong><small>18 Feb · 2 tries</small></span><b>1.79 L</b></li>
            </ul>
            <p class="foot-note">FEV1, best of three. Sample data.</p>
          </section>
        </main>
      </div>

      <!-- The copilot: one card above one voice bar. Monochrome, on purpose. -->
      <div class="co" aria-live="polite">
        <div class="card">
          <ol class="steps" aria-hidden="true">
            <li data-d="patient">Patient</li><li data-d="device">Device</li><li data-d="details">Details</li><li data-d="ready">Start</li>
          </ol>

          <!-- patient -->
          <div class="stage st-patient">
            <p class="ask">Is this the right patient?</p>
            <div class="row"><b class="av md a">AB</b><span><strong>Arthur Bell</strong><small>78 · Room 214 · a breathing test will be added to his chart</small></span></div>
            <div class="acts"><button type="button" class="ghost" data-go="listen">Someone else</button><button type="button" class="solid" data-go="device">Yes, that's him</button></div>
          </div>

          <!-- device -->
          <div class="stage st-device">
            <p class="ask"><span class="searching">Looking for the spirometer nearby…</span><span class="found">Spirometer found</span></p>
            <div class="row dev">
              <span class="radar"><i></i><i></i><Icon name="bluetooth" size={16} /></span>
              <span><strong>Spirometer SN-4471</strong><small class="searching">Hold it close to the tablet</small><small class="found">Connected · battery 82%</small></span>
              <span class="tick found"><Icon name="check" size={13} weight="bold" /></span>
            </div>
            <div class="acts found"><button type="button" class="solid" data-go="details">Continue</button></div>
          </div>

          <!-- details -->
          <div class="stage st-details">
            <p class="ask"><span class="h-empty">Predicted values need his height. The rest is from his chart.</span><span class="h-set">All set, pulled from Arthur's chart.</span></p>
            <dl class="fields">
              <div><dt>Sex</dt><dd>Male</dd></div>
              <div><dt>Born</dt><dd>12 Apr 1948</dd></div>
              <div><dt>Weight</dt><dd>74 kg</dd></div>
              <button type="button" class="need" data-go="edit"><dt>Height</dt><dd><span class="h-empty">Missing</span><span class="h-set">5 ft 6 in</span></dd><Icon name="pencil-simple" size={12} /></button>
            </dl>
            <div class="capsule" role="group" aria-label="Height">
              <span class="num"><b>5</b><small>ft</small></span><span class="num"><b>6</b><small>in</small></span><span class="cm">168 cm</span>
              <button type="button" class="ok" data-go="details-set" aria-label="Confirm height"><Icon name="check" size={14} weight="bold" /></button>
            </div>
            <div class="acts h-set"><button type="button" class="solid" data-go="ready">Looks right</button></div>
          </div>

          <!-- ready -->
          <div class="stage st-ready">
            <p class="ask">Ready when Arthur is.</p>
            <div class="row"><span class="ti big"><Icon name="wind" size={18} /></span><span><strong>Breathe in fully, then blow hard and fast</strong><small>Until the device beeps · 3 tries, the best one counts</small></span></div>
            <div class="acts"><button type="button" class="solid" data-go="done"><Icon name="play" size={12} weight="fill" />Start test</button></div>
          </div>

          <!-- done -->
          <div class="stage st-done">
            <div class="row"><span class="ok-dot"><Icon name="check" size={14} weight="bold" /></span><span><strong>Saved to Arthur's chart</strong><small>FEV1 1.92 L · FVC 2.61 L · up from 1.84 L</small></span><button type="button" class="undo" data-go="details-set"><Icon name="arrow-u-up-left" size={12} />Undo</button></div>
          </div>

          <!-- exit -->
          <div class="exit" data-exit hidden role="dialog" aria-label="Exit the guide?">
            <strong>Stop this test?</strong>
            <p>It isn't finished, so nothing will be saved.</p>
            <div class="acts"><button type="button" class="ghost" data-exit-yes>Stop</button><button type="button" class="solid" data-exit-no>Keep going</button></div>
          </div>
        </div>

        <div class="hint"><Icon name="sparkle" size={13} weight="fill" />Try <b>“Start a breathing test for Arthur”</b></div>

        <div class="bar">
          <button type="button" class="round" data-back aria-label="Back"><Icon name="arrow-left" size={15} /></button>
          <div class="said">
            <span class="ph-text">Ask Strand to do something</span>
            <span class="live"><span data-said></span><i class="caret"></i></span>
            <span class="wave" aria-hidden="true">{bars.map((h, k) => <i style={`--h:${h.toFixed(2)};--k:${k}`}></i>)}</span>
          </div>
          <button type="button" class="round" data-close aria-label="Close copilot"><Icon name="x" size={14} /></button>
          <button type="button" class="mic" data-mic aria-label="Talk to the copilot"><Icon name="microphone" size={18} weight="fill" /></button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-copilot]").forEach((root) => {
    const said = root.querySelector<HTMLElement>("[data-said]")!;
    const exit = root.querySelector<HTMLElement>("[data-exit]")!;
    const lines: Record<string, string> = {
      listen: "Start a breathing test for Arthur",
      patient: "Start a breathing test for Arthur",
      device: "Yes, that's him",
      details: "Continue",
      edit: "His height is five six",
      "details-set": "His height is five six",
      ready: "Looks right",
      done: "Start",
    };
    let timers: number[] = [];
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const go = (s: string) => {
      clear();
      root.dataset.step = s;
      root.classList.remove("found-it");
      if (s === "details-set") root.dataset.height = "set";
      if (s === "idle" || s === "listen") delete root.dataset.height;
      said.textContent = lines[s] ?? "";
      if (s === "listen") {
        said.textContent = "";
        const text = lines.listen;
        [...text].forEach((_, i) => timers.push(window.setTimeout(() => (said.textContent = text.slice(0, i + 1)), 350 + i * 38)));
        timers.push(window.setTimeout(() => go("patient"), 350 + text.length * 38 + 600));
      }
      if (s === "device") timers.push(window.setTimeout(() => root.classList.add("found-it"), 1600));
    };
    root.querySelectorAll<HTMLElement>("[data-go]").forEach((b) => b.addEventListener("click", () => go(b.dataset.go!)));
    root.querySelector("[data-mic]")!.addEventListener("click", () => {
      const s = root.dataset.step!;
      if (s === "idle" || s === "done") go("listen");
    });
    root.querySelector("[data-back]")!.addEventListener("click", () => {
      const map: Record<string, string> = { patient: "idle", device: "patient", details: "device", edit: "details", "details-set": "device", ready: "details-set", done: "ready" };
      const s = root.dataset.step!;
      if (map[s]) go(map[s]);
    });
    root.querySelector("[data-close]")!.addEventListener("click", () => {
      const s = root.dataset.step!;
      if (s === "idle") return;
      if (s === "done" || s === "listen" || s === "patient") return go("idle");
      exit.hidden = false;
    });
    root.querySelector("[data-exit-yes]")!.addEventListener("click", () => { exit.hidden = true; go("idle"); });
    root.querySelector("[data-exit-no]")!.addEventListener("click", () => (exit.hidden = true));
    // Used by the story player to start over from any step.
    root.querySelector("[data-reset-cp]")!.addEventListener("click", () => { exit.hidden = true; go("idle"); });
  });
</script>

<style>
  .cp {
    container-type: inline-size;
    --ink: #18191b;
    --ink2: #55585f;
    --mute: #8b8e95;
    --line: #ebebe8;
    --brand: #4a4ad6;
    --brand-soft: #ececfd;
    --co: #1c1c1f;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tablet {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 12px;
    border-radius: 34px;
    background: #1c1c1e;
    box-shadow:
      inset 0 0 0 1.5px #3b3b3e,
      0 1px 2px rgb(0 0 0 / 0.1),
      0 30px 60px -30px rgb(0 0 0 / 0.45);
  }
  .screen {
    position: relative;
    overflow: hidden;
    height: 640px;
    border-radius: 23px;
    background: #f7f7f5;
    color: var(--ink);
    font: 13px/1.4 var(--font-sans);
    isolation: isolate;
  }
  .status {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 26px;
    padding: 0 20px;
    font-size: 11.5px;
    color: var(--ink);
  }
  .status span:not(.sys) {
    color: var(--ink2);
  }
  .sys {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .batt {
    width: 20px;
    height: 10px;
    border-radius: 3px;
    border: 1.2px solid var(--ink);
    background: linear-gradient(90deg, var(--ink) 70%, transparent 70%) content-box;
    padding: 1px;
  }

  /* App -------------------------------------------------------------- */
  .app {
    position: absolute;
    inset: 26px 0 0;
    display: grid;
    grid-template-columns: 290px 1fr;
  }
  .side {
    display: flex;
    flex-direction: column;
    padding: 10px 14px 0;
    background: #fff;
    border-right: 1px solid var(--line);
  }
  .side-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 4px 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: 650;
    font-size: 14px;
    letter-spacing: -0.01em;
  }
  .mark {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: linear-gradient(140deg, #8f93f2, #4b4fd6 65%);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  h4 {
    margin: 4px 4px 10px;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 10px;
    border-radius: 9px;
    background: #f2f2f0;
    color: var(--mute);
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 10px 0 6px;
    padding: 2px;
    border-radius: 8px;
    background: #f2f2f0;
    font-size: 12px;
    font-weight: 500;
    text-align: center;
    color: var(--ink2);
  }
  .seg span {
    padding: 4px 0;
    border-radius: 6px;
  }
  .seg .on {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .plist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plist li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 8px;
    border-radius: 10px;
    transition: background 0.35s;
  }
  .plist li + li {
    margin-top: 1px;
  }
  .plist span {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .plist strong {
    font-weight: 550;
  }
  .plist small,
  .plist em {
    font-size: 11.5px;
    color: var(--mute);
    font-style: normal;
  }
  .cp:not([data-step="idle"], [data-step="listen"]) .plist .arthur {
    background: var(--brand-soft);
  }
  .av {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 600;
    font-style: normal;
  }
  .av.a { background: #e6e7fb; color: #3a3ea8; }
  .av.b { background: #fbe6e0; color: #9a3b22; }
  .av.c { background: #dff1e7; color: #1f6a43; }
  .av.d { background: #f3ead6; color: #7a5a17; }
  .av.xs { width: 24px; height: 24px; font-size: 9.5px; }
  .av.warm { background: #f5e7c8; color: #7a5410; }
  .av.md { width: 38px; height: 38px; font-size: 12px; }
  .av.lg { width: 44px; height: 44px; font-size: 14px; }

  .main {
    position: relative;
    overflow: hidden;
  }
  .pane {
    position: absolute;
    inset: 0;
    padding: 18px 26px;
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
  }
  .chart {
    opacity: 0;
    transform: translateX(24px);
    pointer-events: none;
  }
  .cp:not([data-step="idle"], [data-step="listen"], [data-step="patient"]) .today {
    opacity: 0;
    transform: translateX(-16px);
  }
  .cp:not([data-step="idle"], [data-step="listen"], [data-step="patient"]) .chart {
    opacity: 1;
    transform: none;
  }
  .ph {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .kick {
    margin: 0;
    font-size: 12px;
    color: var(--mute);
  }
  h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border-radius: 9px;
    background: var(--ink);
    color: #fff;
    font-weight: 550;
    font-size: 12.5px;
  }
  .sum {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 18px 0 4px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }
  .sum div {
    display: grid;
    padding: 12px 16px;
  }
  .sum div + div {
    border-left: 1px solid var(--line);
  }
  .sum b {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sum small {
    color: var(--mute);
    font-size: 12px;
  }
  .lbl {
    margin: 18px 0 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--mute);
  }
  .sched {
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }
  .sched li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 11px 16px;
  }
  .sched li + li {
    border-top: 1px solid var(--line);
  }
  .sched time {
    width: 40px;
    font-variant-numeric: tabular-nums;
    color: var(--ink2);
  }
  .sched span {
    display: grid;
    flex: 1;
  }
  .sched strong {
    font-weight: 550;
  }
  .sched small {
    color: var(--mute);
    font-size: 12px;
  }
  .sched .now time {
    color: var(--brand);
    font-weight: 600;
  }
  .sched em {
    font-style: normal;
    font-size: 11.5px;
    font-weight: 550;
    color: var(--brand);
  }
  .sched em::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 1px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sub {
    margin: 2px 0 0;
    color: var(--mute);
    font-size: 12.5px;
  }
  .chip {
    display: inline-block;
    margin-left: 6px;
    vertical-align: 4px;
    white-space: nowrap;
    letter-spacing: 0;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 550;
  }
  .chip.ok {
    background: #e3f3e9;
    color: #1f7a45;
  }
  .tabs {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    border-bottom: 1px solid var(--line);
    color: var(--mute);
  }
  .tabs span {
    padding: 8px 0;
  }
  .tabs .on {
    color: var(--ink);
    font-weight: 550;
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .tests {
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .tests li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    border-top: 1px solid var(--line);
  }
  .tests li span:nth-child(2) {
    display: grid;
    flex: 1;
  }
  .tests strong {
    font-weight: 550;
  }
  .tests small {
    color: var(--mute);
    font-size: 12px;
  }
  .tests b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tests em {
    font-style: normal;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
  }
  .ti {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: #f1f1ef;
    color: var(--ink2);
  }
  /* The new result exists only once the test is done, and slides in. */
  .tests .new {
    display: none;
    border-top: 0;
    background: color-mix(in srgb, var(--brand-soft) 55%, #fff);
  }
  .tests .new + li {
    border-top: 0;
  }
  .cp[data-step="done"] .tests .new {
    display: flex;
    animation: slot 0.7s 0.2s var(--ease) both;
  }
  .cp[data-step="done"] .tests .new + li {
    border-top: 1px solid var(--line);
  }
  @keyframes slot {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .foot-note {
    margin: 10px 2px 0;
    font-size: 11.5px;
    color: var(--mute);
  }

  /* Copilot ---------------------------------------------------------- */
  .co {
    position: absolute;
    left: 50%;
    bottom: 18px;
    z-index: 4;
    width: min(460px, calc(100% - 28px));
