---
/* Canvas construction lines with selection handles, framing the parent.
   Decorative. The parent needs position: relative. Lines draw in once via
   src/scripts/motion.ts; they are fully visible without JS. */
---

<div class="construct" aria-hidden="true" data-construct>
  <span class="line h top"></span>
  <span class="line h bottom"></span>
  <span class="line v left"></span>
  <span class="line v right"></span>
  <span class="handle tl"></span>
  <span class="handle tr"></span>
  <span class="handle bl"></span>
  <span class="handle br"></span>
</div>

<style>
  .construct {
    position: absolute;
    inset: var(--space-3) -12px var(--space-3) -12px;
    pointer-events: none;
  }
  .line {
    position: absolute;
    background: var(--construct);
  }
  .h {
    left: -100vw;
    right: -100vw;
    height: 1px;
    transform-origin: left center;
  }
  .v {
    top: -64px;
    bottom: -64px;
    width: 1px;
    transform-origin: center top;
  }
  .top { top: 0; }
  .bottom { bottom: 0; }
  .left { left: 0; }
  .right { right: 0; }
  .handle {
    position: absolute;
    width: 7px;
    height: 7px;
    background: var(--bg);
    border: 1px solid var(--ink-muted);
  }
  .tl { top: -3px; left: -3px; }
  .tr { top: -3px; right: -3px; }
  .bl { bottom: -3px; left: -3px; }
  .br { bottom: -3px; right: -3px; }
</style>
