---
/* Minimal browser window for re-created web UI. */
interface Props {
  address?: string;
  label?: string;
}
const { address = "", label = "Browser window" } = Astro.props;
---

<figure class="browser" role="group" aria-label={label}>
  <div class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {address && <span class="address">{address}</span>}
  </div>
  <div class="viewport"><slot /></div>
</figure>

<style>
  .browser {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--bg-raised);
    overflow: hidden;
    max-width: 100%;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--rule);
  }
  .address {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    background: var(--bg);
    border-radius: 6px;
    padding: 3px 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .viewport {
    min-height: 120px;
    overflow: auto;
  }
</style>
