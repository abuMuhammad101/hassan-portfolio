---
/* Browser window for re-created product UI. */
import Icon from "./Icon.astro";
interface Props {
  address?: string;
  label?: string;
}
const { address = "", label = "Browser window" } = Astro.props;
---

<figure class="browser" role="group" aria-label={label}>
  <div class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {address && <span class="address"><Icon name="lock-simple" size={12} /> {address}</span>}
    <span class="spacer" aria-hidden="true"></span>
  </div>
  <div class="viewport" data-lenis-prevent><slot /></div>
</figure>

<style>
  .browser {
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-radius: 14px;
    background: var(--bg-raised);
    overflow: hidden;
    max-width: 100%;
    box-shadow:
      0 30px 60px -30px rgb(0 0 0 / 0.3),
      0 12px 24px -18px rgb(0 0 0 / 0.25);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 9px 14px;
    background: var(--bg-sunk);
    border-bottom: 1px solid var(--rule);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .address {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--ink-secondary);
    background: var(--bg-raised);
    border-radius: 999px;
    padding: 3px 14px;
    max-width: 46vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .viewport {
    overflow: auto;
  }
</style>
