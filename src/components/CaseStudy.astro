---
/* The v2 case-study page: exhibit header, sections with a side rail, one
   interactive proof, and honest evidence in place of metrics. */
import TwoToneHeading from "./TwoToneHeading.astro";
import BeforeAfter from "./widgets/BeforeAfter.astro";
import RecordChain from "./widgets/RecordChain.astro";
import Copilot from "./widgets/Copilot.astro";
import AgentConsole from "./widgets/AgentConsole.astro";
import Icon from "./Icon.astro";

interface Props {
  data: any;
  next?: { slug: string; title: string };
}
const { data, next } = Astro.props;
const metaIcon: Record<string, string> = { Role: "user", Effort: "timer", Platform: "devices", Scope: "browsers", Domain: "tag" };
const rail = [
  ["problem", "Problem"],
  ["constraints", "Constraints"],
  ["decisions", "Decisions"],
  ["proof", "Try it"],
  ["states", "Edge states"],
  ["evidence", "Evidence"],
  ["measure", "Measure"],
];
---

<article class="case">
  <header class="wrap-wide head">
    <TwoToneHeading as="h1" size="hero" lead={data.title} rest={data.titleRest} />
    <p class="angle">{data.angle}</p>
    <dl class="meta surface">
      {data.meta.map((m: any) => (
        <div>
          <Icon name={metaIcon[m.label] ?? "tag"} size={18} />
          <span><dt>{m.label}</dt><dd>{m.value}</dd></span>
        </div>
      ))}
    </dl>
    {data.ndaRecreated && (
      <p class="nda"><Icon name="lock-simple" size={14} /> Under NDA, so names and screens here are re-created.</p>
    )}
  </header>

  <div class="wrap-wide body">
    <nav class="rail" aria-label="Sections">
      <ol>
        {rail.map(([id, label]) => (
          <li><a href={`#${id}`} data-rail={id}>{label}</a></li>
        ))}
      </ol>
    </nav>

    <div class="col">
      {data.stats && (
        <ul class="stats">
          {data.stats.map((s: any) => (
            <li>
              <p class="big tabular-nums">{s.value}<sup>{s.unit}</sup></p>
              <p class="stat-label">{s.label}</p>
            </li>
          ))}
        </ul>
      )}

      <section id="problem">
        <p class="section-label">The problem</p>
        {data.problem.map((p: string) => <p class="lede">{p}</p>)}
      </section>

      <section id="constraints" class="reveal">
        <p class="section-label">Constraints</p>
        <ul class="guards">
          {data.constraints.map((c: string) => (
            <li><span class="g-ic" aria-hidden="true"><Icon name="lock-simple" size={13} /></span><span>{c}</span></li>
          ))}
        </ul>
      </section>

      <section id="decisions" class="reveal">
        <p class="section-label">Decisions</p>
        {data.decisionsIntro && <p>{data.decisionsIntro}</p>}
        <div class="decisions">
          {data.decisions.map((d: any, i: number) => (
            <details open={i === 0}>
              <summary>
                <span class="num tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                <span class="d-title">{d.title}</span>
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <p>{d.body}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="proof" class="reveal">
        <p class="section-label">Try it</p>
        <p>{data.widgetIntro}</p>
        <div class="widget">
          {data.widget === "before-after" && <BeforeAfter />}
          {data.widget === "record-chain" && <RecordChain />}
          {data.widget === "copilot" && <Copilot />}
          {data.widget === "agent-console" && <AgentConsole />}
        </div>
        <p class="caption">Re-created for this page. It shows the pattern, with sample data.</p>
      </section>

      <section id="states" class="reveal">
        <p class="section-label">Beyond the happy path</p>
        <p>The states I check on work like this, because nobody asks for them until they break.</p>
        <ul class="states">
          {data.states.map((s: any) => (
            <li><b>{s.name}</b><span>{s.note}</span></li>
          ))}
        </ul>
      </section>

      <section id="evidence" class="reveal">
        <p class="section-label">Evidence</p>
        <ul class="plain">
          {data.evidence.map((e: string) => <li>{e}</li>)}
        </ul>
      </section>

      <section id="measure" class="reveal">
        <p class="section-label">How I'd measure it</p>
        <p>These results weren't tracked on this project. With access, these are the numbers I'd watch.</p>
        <ul class="measures">
          {data.measures.map((m: string) => <li>{m}</li>)}
        </ul>
        <p class="next-step"><b>Next:</b> {data.next}</p>
      </section>

      {next && (
        <a class="next-case" href={`/work/${next.slug}/`}>
          <span>Next case</span>
          <b>{next.title} <Icon name="arrow-right" size={20} /></b>
        </a>
      )}
    </div>
  </div>
</article>

<script>
  // Highlight the rail link for the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-rail]")];
  if (links.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) => l.toggleAttribute("data-active", l.dataset.rail === e.target.id));
        });
      },
      { rootMargin: "-30% 0px -60% 0px" }
    );
    links.forEach((l) => {
      const s = document.getElementById(l.dataset.rail!);
      if (s) io.observe(s);
    });
  }
</script>

<style>
  .head {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--rule);
  }
  .angle {
    font-size: var(--text-lg);
    color: var(--ink-secondary);
    max-width: 52ch;
    margin: var(--space-3) 0;
  }
  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 6px;
    max-width: 100%;
  }
  .meta div {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px 8px 12px;
    color: var(--ink-muted);
  }
  .meta div + div {
    border-left: 1px solid var(--rule);
  }
  .meta span {
    display: grid;
  }
  .meta dt {
    font-size: 12px;
    line-height: 1.3;
    color: var(--ink-muted);
  }
  .meta dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }
  .nda {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  @media (max-width: 620px) {
    .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .meta div + div {
      border-left: none;
    }
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
  .rail {
    display: none;
  }
  .col {
    min-width: 0;
    max-width: 680px;
  }
  @media (min-width: 960px) {
    .body {
      grid-template-columns: 180px minmax(0, 1fr);
    }
    .rail {
      display: block;
    }
    .rail ol {
      position: sticky;
      top: 104px;
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--rule);
    }
    .rail a {
      display: block;
      padding: 6px 0 6px 16px;
      margin-left: -1px;
      border-left: 1px solid transparent;
      font-size: var(--text-sm);
      color: var(--ink-muted);
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .rail a:hover {
      color: var(--ink);
    }
    .rail a[data-active] {
      color: var(--ink);
      font-weight: 500;
      border-left-color: var(--accent-warm);
    }
  }
  section {
    padding-bottom: var(--space-6);
    scroll-margin-top: 96px;
  }
  section p {
    color: var(--ink-secondary);
    margin: 0 0 var(--space-2);
    max-width: 62ch;
  }
  .lede {
    font-size: var(--text-lg);
  }
  .stats {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
  }
  .big {
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .big sup {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-left: 6px;
    vertical-align: top;
    position: relative;
    top: 8px;
  }
  .stat-label {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    margin: 0;
  }
  .guards {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .guards li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    align-items: start;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    max-width: 62ch;
  }
  .g-ic {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-sunk);
    color: var(--ink-secondary);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .guards li > span:last-child {
    padding-top: 3px;
  }
  .plain,
  .states,
  .measures {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .plain li {
    position: relative;
    padding: 5px 0 5px 20px;
    color: var(--ink-secondary);
    max-width: 62ch;
  }
  .plain li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--ink-muted);
  }
  .decisions {
    border-top: 1px solid var(--rule);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .num {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .d-title {
    flex: 1;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--ink);
  }
  .plus {
    position: relative;
    width: 11px;
    height: 11px;
    align-self: center;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    background: var(--ink);
  }
  .plus::before { left: 0; right: 0; top: 5px; height: 1px; }
  .plus::after { top: 0; bottom: 0; left: 5px; width: 1px; }
  details[open] .plus::after {
    display: none;
  }
  details p {
    padding: 0 0 var(--space-2) 30px;
    margin: 0;
  }
  .widget {
    margin: var(--space-3) 0 var(--space-1);
  }
  @media (min-width: 1100px) {
    .widget {
      width: calc(100% + 170px);
    }
  }
  .caption {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .states {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 8px;
  }
  .states li {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 10px 12px;
    background: var(--bg-raised);
  }
  .states b {
    display: block;
    font-weight: 500;
    color: var(--ink);
    font-size: var(--text-sm);
  }
  .states span {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
  .measures {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin-bottom: var(--space-3);
  }
  .measures li {
    font-size: var(--text-sm);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 4px 12px;
    background: var(--bg-raised);
  }
  .next-step b {
    color: var(--ink);
    font-weight: 500;
  }
  .next-case {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .next-case span {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .next-case b {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-xl);
  }
  .next-case:hover b {
    color: var(--accent-site);
  }
</style>
