---
/* The case-study page. The product comes first, right under the title, and
   the write-up follows in two columns: a plain title on the left, the
   substance on the right, ruled like a document. */
import BeforeAfter from "./widgets/BeforeAfter.astro";
import RecordChain from "./widgets/RecordChain.astro";
import Copilot from "./widgets/Copilot.astro";
import AgentConsole from "./widgets/AgentConsole.astro";
import DensityTable from "./widgets/DensityTable.astro";
import ClickerTour from "./widgets/ClickerTour.astro";
import SiteTour from "./widgets/SiteTour.astro";
import RangeAudit from "./widgets/RangeAudit.astro";
import PhoneTour from "./widgets/PhoneTour.astro";
import Icon from "./Icon.astro";
import StoryDirector from "./StoryDirector.astro";
import { stories } from "../data/stories";

interface Props {
  data: any;
  next?: { slug: string; title: string };
}
const { data, next } = Astro.props;
const story = stories[data.widget];
const slug = Astro.url.pathname.split("/").filter(Boolean).pop();
---

<article class="case">
  <header class="wrap-wide hero">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/#work">Work</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>
    <h1 class="title" style={`view-transition-name: t-${slug}`}>{[data.title, data.titleRest].filter(Boolean).join(" ")}</h1>
    <p class="angle">{data.angle}</p>
    {data.ndaRecreated && <p class="nda"><Icon name="lock-simple" size={13} />Under NDA. The product below is re-created with stand-in names and data.</p>}
  </header>

  <dl class="wrap-wide facts">
    {data.meta.map((m: any) => (
      <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
    ))}
  </dl>

  <section id="proof" class="wrap-wide proof" aria-label="The product">
    <p class="proof-intro">{data.widgetIntro}</p>
    <div class="widget">
      {story ? (
        <StoryDirector chapters={story.chapters} reset={story.reset} accent={story.accent} address={story.address} pad={story.pad}>
          {data.widget === "before-after" && <BeforeAfter />}
          {data.widget === "record-chain" && <RecordChain />}
          {data.widget === "copilot" && <Copilot />}
          {data.widget === "agent-console" && <AgentConsole />}
          {data.widget === "density" && <DensityTable />}
          {data.widget === "tour" && <ClickerTour />}
          {data.widget === "site-tour" && <SiteTour />}
          {data.widget === "range-audit" && <RangeAudit />}
          {data.widget === "phone-tour" && <PhoneTour />}
        </StoryDirector>
      ) : (
        <>
          {data.widget === "before-after" && <BeforeAfter />}
          {data.widget === "record-chain" && <RecordChain />}
          {data.widget === "copilot" && <Copilot />}
          {data.widget === "agent-console" && <AgentConsole />}
          {data.widget === "density" && <DensityTable />}
          {data.widget === "tour" && <ClickerTour />}
          {data.widget === "site-tour" && <SiteTour />}
          {data.widget === "range-audit" && <RangeAudit />}
          {data.widget === "phone-tour" && <PhoneTour />}
        </>
      )}
    </div>
  </section>

  {data.stats && (
    <ul class="wrap-wide stats">
      {data.stats.map((s: any) => (
        <li><p><b class="tabular-nums">{s.value} {s.unit}.</b> {s.label}.</p></li>
      ))}
    </ul>
  )}

  <div class="wrap-wide body">
    <section id="problem" class="row">
      <h2>The problem</h2>
      <div class="text">
        {data.problem.map((p: string, i: number) => <p class:list={[{ lede: i === 0 }]}>{p}</p>)}
      </div>
    </section>

    <section id="constraints" class="row reveal">
      <h2>Ground rules</h2>
      <div class="text">
        <p class="intro">What I couldn't change, and worked with.</p>
        <ul class="ruled">
          {data.constraints.map((c: string) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section id="decisions" class="row reveal">
      <h2>Decisions</h2>
      <div class="text">
        {data.decisionsIntro && <p class="intro">{data.decisionsIntro}</p>}
        <div class="decisions">
          {data.decisions.map((d: any, i: number) => (
            <details open={i === 0}>
              <summary><span>{d.title}</span><span class="plus" aria-hidden="true"></span></summary>
              <p>{d.body}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="states" class="row reveal">
      <h2>Beyond the happy path</h2>
      <div class="text">
        <p class="intro">The states nobody asks for until they break.</p>
        <ul class="states">
          {data.states.map((st: any) => (
            <li>
              <span class="st-ic"><Icon name={st.icon ?? "circle-dashed"} size={17} /></span>
              <span><b>{st.name}</b><span>{st.note}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="evidence" class="row reveal">
      <h2>What's on file</h2>
      <div class="text">
        <ol class="ruled numbered">
          {data.evidence.map((e: string) => <li>{e}</li>)}
        </ol>
      </div>
    </section>

    {data.measures?.length && (
      <section id="measure" class="row reveal">
        <h2>How I'd measure it</h2>
        <div class="text">
          <p class="intro">These results weren't tracked on this project. With access, these are the numbers I'd watch.</p>
          <ul class="ruled">
            {data.measures.map((m: string) => <li>{m}</li>)}
          </ul>
          {data.next && <p class="next-step"><b>Next:</b> {data.next}</p>}
        </div>
      </section>
    )}
  </div>

  {next && (
    <a class="wrap-wide next-case" href={`/work/${next.slug}/`}>
      <span>Next case study</span>
      <b>{next.title}</b>
      <Icon name="arrow-right" size={22} />
    </a>
  )}
</article>

<style>
  /* Header --------------------------------------------------------------- */
  .hero {
    padding-top: clamp(32px, 5vw, 64px);
  }
  .crumbs {
    display: flex;
    gap: 8px;
    margin: 0 0 28px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .crumbs a {
    color: var(--ink-secondary);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .title {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 380;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.03;
    letter-spacing: -0.025em;
  }
  .angle {
    max-width: 48ch;
    margin: 20px 0 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  .nda {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 20px 0 0;
    font-size: 13.5px;
    color: var(--ink-muted);
  }

  /* Facts: one ruled line, like the home page. */
  .facts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(40px, 5vw, 56px) auto 0;
  }
  .facts::before,
  .facts::after {
    content: "";
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    top: 0;
    border-top: 1px solid var(--rule);
  }
  .facts::after {
    top: auto;
    bottom: 0;
  }
  .facts div {
    padding: 16px 20px 18px 0;
  }
  .facts div + div {
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }
  .facts dt {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: 15px;
    line-height: 1.4;
  }

  /* The product -------------------------------------------------------- */
  .proof {
    padding-top: clamp(40px, 5vw, 64px);
    scroll-margin-top: 80px;
  }
  .proof-intro {
    max-width: 60ch;
    margin: 0 0 20px;
    color: var(--ink-secondary);
  }
  .widget {
    position: relative;
  }

  /* Results as sentences: the number belongs to what it measures. */
  .stats {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(48px, 6vw, 72px) auto 0;
  }
  .stats::before {
    content: "";
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    top: 0;
    border-top: 1px solid var(--rule);
  }
  .stats li {
    padding: 18px 24px 0 0;
  }
  .stats li + li {
    padding-left: 24px;
    border-left: 1px solid var(--rule);
  }
  .stats p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  .stats b {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  /* Write-up ------------------------------------------------------------- */
  .body {
    padding-top: clamp(64px, 8vw, 112px);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px 48px;
    padding: 40px 0 48px;
    border-top: 1px solid var(--rule);
  }
  .row h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .text {
    max-width: 640px;
    color: var(--ink-secondary);
  }
  .text p {
    margin: 0 0 1em;
  }
  .text .lede {
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .intro {
    color: var(--ink-muted);
  }
  .ruled {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .ruled li {
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .numbered {
    counter-reset: n;
  }
  .numbered li {
    display: grid;
    grid-template-columns: 32px 1fr;
    counter-increment: n;
  }
  .numbered li::before {
    content: counter(n);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .decisions {
    border-top: 1px solid var(--rule);
  }
  .decisions details {
    border-bottom: 1px solid var(--rule);
  }
  .decisions summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    color: var(--ink);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .decisions summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    left: 0;
    top: 5.5px;
    width: 12px;
    height: 1.5px;
    background: var(--ink-muted);
    transition: transform 0.25s;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0);
  }
  .decisions details p {
    margin: 0;
    padding: 0 32px 18px 0;
  }
  .decisions summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .states {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .states li {
    display: flex;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .states li > span:last-child {
    display: grid;
    gap: 2px;
  }
  .states b {
    font-weight: 500;
    color: var(--ink);
  }
  .states li > span:last-child > span {
    font-size: 14.5px;
  }
  .st-ic {
    flex: none;
    margin-top: 3px;
    color: var(--ink-muted);
  }
  .next-step b {
    color: var(--ink);
    font-weight: 500;
  }

  .next-case {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 6px 16px;
    padding-top: 40px;
    padding-bottom: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .next-case::before {
    content: "";
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    top: 0;
    border-top: 1px solid var(--rule);
  }
  .next-case span {
    grid-column: 1 / -1;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .next-case b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .next-case :global(svg) {
    margin-bottom: 10px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .next-case:hover :global(svg) {
    transform: translateX(6px);
  }

  @media (max-width: 860px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .facts div + div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    .facts div:nth-child(even) {
      padding-left: 20px;
      border-left: 1px solid var(--rule);
    }
    .facts div:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
    .row {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: 1fr;
    }
    .stats li,
    .stats li + li {
      padding: 16px 0;
      border-left: 0;
    }
    .stats li + li {
      border-top: 1px solid var(--rule);
    }
    .states {
      grid-template-columns: 1fr;
    }
  }
</style>
