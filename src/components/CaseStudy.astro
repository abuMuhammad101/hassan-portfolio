---
/* The case-study page, v3. It reads like a designer's working file rather
   than a template: the live proof comes first, right under the title, with
   a handwritten nudge and a named cursor; the rest is set editorially, with
   serif italics for section heads, a taped note of ground rules, edge states
   stacked like notifications, and evidence signed off by hand. */
import TwoToneHeading from "./TwoToneHeading.astro";
import BeforeAfter from "./widgets/BeforeAfter.astro";
import RecordChain from "./widgets/RecordChain.astro";
import Copilot from "./widgets/Copilot.astro";
import AgentConsole from "./widgets/AgentConsole.astro";
import DensityTable from "./widgets/DensityTable.astro";
import ClickerTour from "./widgets/ClickerTour.astro";
import SiteTour from "./widgets/SiteTour.astro";
import RangeAudit from "./widgets/RangeAudit.astro";
import PhoneTour from "./widgets/PhoneTour.astro";
import Icon from "./Icon.astro";
import StoryDirector from "./StoryDirector.astro";
import { stories } from "../data/stories";

interface Props {
  data: any;
  next?: { slug: string; title: string };
}
const { data, next } = Astro.props;
const sections: [string, string][] = [
  ["proof", "Try it"],
  ["problem", "The problem"],
  ["constraints", "Ground rules"],
  ["decisions", "The calls I made"],
  ["states", "Beyond the happy path"],
  ["evidence", "What's on file"],
  ...(data.measures?.length ? ([["measure", "How I'd measure it"]] as [string, string][]) : []),
];
const num = (id: string) => String(sections.findIndex(([s]) => s === id)).padStart(2, "0");
const label = (id: string) => sections.find(([s]) => s === id)![1];
const n = data.states.length;
const story = stories[data.widget];
const slug = Astro.url.pathname.split("/").filter(Boolean).pop();
---

<article class="case">
  <header class="wrap-wide hero">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/#work"><Icon name="arrow-left" size={14} /><span>Work</span></a>
      <span class="slash" aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
      {data.ndaRecreated
        ? <span class="badge nda"><Icon name="lock-simple" size={12} />Under NDA, re-created</span>
        : <span class="badge real"><i></i>Live product</span>}
    </nav>
    <div class="vt-title" style={`view-transition-name: t-${slug}`}><TwoToneHeading as="h1" size="hero" lead={data.title} rest={data.titleRest} /></div>
    <p class="angle">{data.angle}</p>
    <dl class="facts">
      {data.meta.map((m: any) => (
        <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
      ))}
    </dl>
  </header>

  <!-- The proof comes first: read it after you've tried it. -->
  <section id="proof" class="wrap-wide proof">
    <div class="proof-head">
      <p class="proof-intro">{data.widgetIntro}</p>
      <p class="hand" aria-hidden="true">go on, try it
        <svg class="arrow" viewBox="0 0 40 56" fill="none"><path d="M14 3c-9 12-8 28 8 44" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path d="M13 44l9 4 2-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </p>
    </div>
    <div class="widget">
      {story ? (
        <StoryDirector chapters={story.chapters} reset={story.reset} accent={story.accent} address={story.address} pad={story.pad}>
          {data.widget === "before-after" && <BeforeAfter />}
          {data.widget === "record-chain" && <RecordChain />}
          {data.widget === "copilot" && <Copilot />}
          {data.widget === "agent-console" && <AgentConsole />}
          {data.widget === "density" && <DensityTable />}
          {data.widget === "tour" && <ClickerTour />}
          {data.widget === "site-tour" && <SiteTour />}
          {data.widget === "range-audit" && <RangeAudit />}
          {data.widget === "phone-tour" && <PhoneTour />}
        </StoryDirector>
      ) : (
        <>
          {data.widget === "before-after" && <BeforeAfter />}
          {data.widget === "record-chain" && <RecordChain />}
          {data.widget === "copilot" && <Copilot />}
          {data.widget === "agent-console" && <AgentConsole />}
          {data.widget === "density" && <DensityTable />}
          {data.widget === "tour" && <ClickerTour />}
          {data.widget === "site-tour" && <SiteTour />}
          {data.widget === "range-audit" && <RangeAudit />}
          {data.widget === "phone-tour" && <PhoneTour />}
        </>
      )}
    </div>
  </section>

  {data.stats && (
    <div class="wrap-wide">
      <ul class="stats">
        {data.stats.map((s: any) => (
          <li>
            <p class="big tabular-nums">{s.value}<em>{s.unit}</em></p>
            <p class="stat-label">{s.label}</p>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="wrap-wide body">

    <div class="col">
      <section id="problem" class="split">
        <h2 class="sh"><span>{num("problem")}</span><em>{label("problem")}</em></h2>
        <div class="letter">
          {data.problem.map((p: string, i: number) => <p class:list={[{ lede: i === 0 }]}>{p}</p>)}
        </div>
      </section>

      <section id="constraints" class="split reveal">
        <h2 class="sh"><span>{num("constraints")}</span><em>{label("constraints")}</em></h2>
        <div class="note">
          <span class="tape" aria-hidden="true"></span>
          <p class="note-h">Things I couldn't change</p>
          <ol>
            {data.constraints.map((c: string) => <li>{c}</li>)}
          </ol>
        </div>
      </section>

      <section id="decisions" class="split reveal">
        <h2 class="sh"><span>{num("decisions")}</span><em>{label("decisions")}</em></h2>
        <div>
          {data.decisionsIntro && <p class="pull">{data.decisionsIntro}</p>}
          <div class="decisions">
            {data.decisions.map((d: any, i: number) => (
              <details open={i === 0}>
                <summary>
                  <span class="d-n tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                  <span class="d-title">{d.title}</span>
                  <span class="plus" aria-hidden="true"></span>
                </summary>
                <p>{d.body}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="states" class="split reveal">
        <h2 class="sh"><span>{num("states")}</span><em>{label("states")}</em></h2>
        <div class="stack-wrap" data-stack-wrap>
          <p class="stack-note">
            <span class="hand-sm">the ones nobody asks for, until they break</span>
          </p>
          <ul class="stack" data-stack data-open="false" style={`--n:${n}`}>
            {data.states.map((s: any, i: number) => (
              <li style={`--i:${i}`}>
                <span class="st-ic"><Icon name={s.icon ?? "circle-dashed"} weight="duotone" size={18} /></span>
                <span class="st-tx"><b>{s.name}</b><span>{s.note}</span></span>
                <time class="st-t" aria-hidden="true">{i === 0 ? "now" : `${i * 2}m`}</time>
              </li>
            ))}
          </ul>
          <button type="button" class="stack-btn" data-stack-btn aria-expanded="false">
            <span class="when-closed">Show all {n}</span><span class="when-open">Stack them</span>
            <Icon name="caret-down" size={13} />
          </button>
        </div>
      </section>

      <section id="evidence" class="split reveal">
        <h2 class="sh"><span>{num("evidence")}</span><em>{label("evidence")}</em></h2>
        <div>
          <ol class="evidence">
            {data.evidence.map((e: string, i: number) => (
              <li><span class="ev-n tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><p>{e}</p></li>
            ))}
          </ol>
          <p class="sign"><span class="sig">Hassan</span><span>Muhammad Hassan Khan, product designer</span></p>
        </div>
      </section>

      {data.measures?.length && (
        <section id="measure" class="split reveal">
          <h2 class="sh"><span>{num("measure")}</span><em>{label("measure")}</em></h2>
          <div>
            <p>These results weren't tracked on this project. With access, these are the numbers I'd watch.</p>
            <ul class="measures">
              {data.measures.map((m: string) => <li>{m}</li>)}
            </ul>
            {data.next && <p class="next-step"><b>Next:</b> {data.next}</p>}
          </div>
        </section>
      )}

      {next && (
        <a class="next-case" href={`/work/${next.slug}/`}>
          <span>Next case</span>
          <b>{next.title} <Icon name="arrow-right" size={22} /></b>
        </a>
      )}
    </div>
  </div>
</article>

<script>
  // Edge states: a stack of notifications that spreads out on hover or tap.
  document.querySelectorAll<HTMLElement>("[data-stack-wrap]").forEach((wrap) => {
    const stack = wrap.querySelector<HTMLElement>("[data-stack]")!;
    const btn = wrap.querySelector<HTMLButtonElement>("[data-stack-btn]")!;
    let pinned = false;
    const set = (open: boolean) => {
      stack.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", () => {
      pinned = stack.dataset.open !== "true";
      set(pinned);
    });
    stack.addEventListener("click", () => {
      if (stack.dataset.open !== "true") set((pinned = true));
    });
    if (matchMedia("(hover: hover)").matches) {
      stack.addEventListener("mouseenter", () => set(true));
      wrap.addEventListener("mouseleave", () => set(pinned));
    }
  });
</script>

<style>
  /* Hero ----------------------------------------------------------------- */
  /* One column, one voice: a breadcrumb, the title as a single statement,
     a line of why, and the facts on a single hairline. */
  .hero {
    padding-top: var(--space-6);
    padding-bottom: 0;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 var(--space-4);
    font-size: 13.5px;
    color: var(--ink-muted);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .crumbs a :global(svg) {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .crumbs a:hover :global(svg) {
    transform: translateX(-3px);
  }
  .slash {
    color: var(--construct);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    margin-left: auto;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--bg-raised);
    box-shadow: var(--lift-1);
    font-size: 12px;
    color: var(--ink-secondary);
  }
  .real i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2f9e5b;
    box-shadow: 0 0 0 3px rgb(47 158 91 / 0.16);
  }
  .hero :global(.two-tone) {
    max-width: 20ch;
    font-size: clamp(2.4rem, 5.6vw, 4.1rem);
    line-height: 1.04;
  }
  .hero :global(.two-tone .lead),
  .hero :global(.two-tone .rest) {
    display: inline;
  }
  .angle {
    margin: var(--space-3) 0 0;
    max-width: 44ch;
    font-family: var(--font-editorial);
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.3;
    color: var(--ink-secondary);
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    margin: var(--space-6) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--ink);
  }
  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .facts div + div {
      padding-left: 24px;
      border-left: 1px solid var(--rule);
    }
  }
  @media (max-width: 560px) {
    .crumbs .slash,
    .crumbs [aria-current] {
      display: none;
    }
  }

  /* Proof ---------------------------------------------------------------- */
  /* The invitation sits on one line with the stage: what you'll see on the
     left, a handwritten nudge on the right pointing down into it. */
  .proof {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
    scroll-margin-top: 90px;
  }
  .proof-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin: 0 0 var(--space-3);
  }
  .proof-intro {
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--ink-secondary);
  }
  .hand {
    position: relative;
    flex: none;
    margin: 0 8px 0 0;
    padding-right: 34px;
    font-family: var(--font-hand);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent-warm);
  }
  .arrow {
    position: absolute;
    right: 0;
    top: 6px;
    width: 26px;
    height: 38px;
    color: var(--accent-warm);
  }
  @media (max-width: 640px) {
    .hand {
      display: none;
    }
  }
  .widget {
    position: relative;
  }
  /* Stats ---------------------------------------------------------------- */
  .stats {
    list-style: none;
    margin: 0;
    padding: var(--space-6) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stats li {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
  }
  .stats li + li {
    border-left: 1px solid var(--rule);
    padding-left: var(--space-3);
  }
  @media (max-width: 700px) {
    .stats li + li {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
  .big {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3rem, 6vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .big em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.5rem;
    letter-spacing: 0;
    color: var(--ink-muted);
  }
  .stat-label {
    max-width: 30ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  /* Body ----------------------------------------------------------------- */
  .body {
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
  }
  .col {
    min-width: 0;
  }
  section {
    scroll-margin-top: 96px;
  }
  section p {
    margin: 0 0 var(--space-2);
    color: var(--ink-secondary);
  }

  /* Each section: an editorial head on the left, the content on the right. */
  /* Sections sit on a quiet rhythm: a hairline, then generous room. */
  .split {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) 0;
  }
  .split + .split {
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 820px) {
    .split {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--space-6);
    }
    .sh {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }
  .sh {
    display: grid;
    gap: 2px;
    margin: 0;
    font-weight: 400;
  }
  .sh span {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
  }
  .sh em {
    font-family: var(--font-editorial);
    font-size: 1.9rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .letter p {
    max-width: 60ch;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .letter p:last-child {
    margin-bottom: 0;
  }
  .letter .lede {
    margin-bottom: 24px;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* Ground rules on a taped note. */
  .note {
    position: relative;
    max-width: 560px;
    margin-top: 12px;
    padding: 34px 32px 22px;
    border-radius: 3px;
    background: color-mix(in srgb, #fff3c4 72%, var(--bg-raised));
    color: #3a3324;
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.04),
      0 18px 30px -22px rgb(60 45 10 / 0.45);
  }
  :global([data-theme="dark"]) .note {
    background: #3a3526;
    color: #efe7cf;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .note {
      background: #3a3526;
      color: #efe7cf;
    }
  }
  .tape {
    position: absolute;
    top: -11px;
    left: 50%;
    width: 92px;
    height: 24px;
    background: rgb(214 202 176 / 0.55);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
    transform: translateX(-50%) rotate(2.5deg);
    outline: 1px solid transparent;
    backface-visibility: hidden;
  }
  .note-h {
    margin: 0 0 16px;
    font-family: var(--font-hand);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1;
    color: inherit;
  }
  .note ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rule;
  }
  .note li {
    counter-increment: rule;
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    padding: 13px 0;
    border-top: 1px dashed rgb(58 51 36 / 0.22);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .note li::before {
    content: counter(rule) ".";
    font-family: var(--font-hand);
    font-size: 1.2rem;
    line-height: 1.2;
    opacity: 0.7;
  }

  /* Decisions. */
  .pull {
    max-width: 34ch;
    margin: 0 0 var(--space-4);
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.55rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .decisions {
    border-top: 1px solid var(--rule);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: grid;
    grid-template-columns: 40px 1fr 20px;
    align-items: baseline;
    gap: 8px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .d-n {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ink-muted);
  }
  .d-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
  }
  summary:hover .d-title {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
    text-underline-offset: 4px;
  }
  .plus {
    position: relative;
    width: 12px;
    height: 12px;
    align-self: center;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    inset: 5px 0 auto;
    height: 1.5px;
    background: var(--ink-muted);
    transition: transform 0.3s;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0deg);
  }
  details[open] .d-n {
    color: var(--accent-warm);
  }
  details > p {
    max-width: 58ch;
    margin: -6px 0 0;
    padding: 0 0 26px 48px;
    line-height: 1.7;
  }
  summary:focus-visible {
    outline: 2px solid var(--accent-warm);
    outline-offset: 2px;
  }

  /* Edge states: stacked like notifications, spread on hover or tap. */
  .stack-wrap {
    --h: 78px;
    --gap: 10px;
    max-width: 470px;
  }
  .stack-note {
    margin: 0 0 20px;
  }
  .hand-sm {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--ink-muted);
  }
  .stack {
    position: relative;
    display: grid;
    grid-auto-rows: var(--h);
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
    height: calc(var(--h) + 24px);
    transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
  }
  .stack[data-open="true"] {
    height: calc(var(--n) * (var(--h) + var(--gap)) - var(--gap));
    cursor: default;
  }
  .stack li {
    position: relative;
    z-index: calc(20 - var(--i));
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 18px;
    background: var(--bg-raised);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ink) 7%, transparent),
      0 10px 24px -16px rgb(0 0 0 / 0.35);
    transform-origin: 50% 0;
    transform: translateY(calc(var(--i) * -1 * (var(--h) + var(--gap)) + min(var(--i), 2) * 12px)) scale(calc(1 - min(var(--i), 3) * 0.05));
    opacity: clamp(0, 3 - var(--i), 1);
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s;
    transition-delay: calc(var(--i) * 25ms);
  }
  .stack[data-open="true"] li {
    transform: none;
    opacity: 1;
  }
  .st-ic {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: color-mix(in srgb, var(--accent-warm) 12%, var(--bg-raised));
    color: var(--accent-warm);
  }
  .st-tx {
    display: grid;
    min-width: 0;
  }
  .st-tx b {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
  }
  .st-tx span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 13px;
