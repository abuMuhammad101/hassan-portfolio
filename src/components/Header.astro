---
/* Sticky glass pill header. */
import Icon from "./Icon.astro";
interface Props {
  showBack?: boolean;
  wide?: boolean;
}
const { showBack = false } = Astro.props;
---

<header class="site-header">
  <div class="pill">
    <a href="/" class="mark" aria-label="Hassan Khan, home">
      <svg viewBox="0 0 100 100" width="24" height="24" fill="none" aria-hidden="true">
        <circle cx="35" cy="50" r="28" fill="var(--ink)" />
        <circle cx="68" cy="50" r="28" fill="var(--ink)" opacity="0.55" />
      </svg>
      <span class:list={["name", { always: showBack }]}>Hassan Khan</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/#work">Work</a>
      <a href="/resume/">Resume</a>
      <a href="/#contact">Contact</a>
    </nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">
      <span class="icon-sun"><Icon name="sun" size={17} /></span>
      <span class="icon-moon"><Icon name="moon" size={17} /></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 14px;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 14px var(--space-2) 0;
    margin-bottom: var(--space-4);
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    background: color-mix(in srgb, var(--bg-raised) 62%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    backdrop-filter: blur(16px) saturate(1.6);
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 55%, transparent) inset,
      0 8px 28px -12px rgb(0 0 0 / 0.22);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .pill {
      background: var(--bg-raised);
    }
  }
  :global([data-theme="dark"]) .pill {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 8px 28px -12px rgb(0 0 0 / 0.6);
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-right: 10px;
  }
  .nav {
    display: flex;
    gap: 2px;
    font-size: var(--text-sm);
  }
  .nav a {
    color: var(--ink-secondary);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .theme-toggle {
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    border: none;
    color: var(--ink);
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .theme-toggle span {
    display: flex;
  }
  .icon-moon {
    display: none !important;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: none !important;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: flex !important;
  }
  @media (max-width: 480px) {
    .name:not(.always) {
      display: none;
    }
    .name.always {
      display: none;
    }
    .mark {
      margin-right: 2px;
    }
    .nav a {
      padding: 6px 9px;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var root = document.documentElement;
      var current =
        root.getAttribute("data-theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      var next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  })();
</script>
