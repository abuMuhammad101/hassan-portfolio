---
/* Folder preview for a case-study card: two sheets (mini screens from the
   project) tucked into a folder. They lift and fan out when the card is
   hovered or focused. Decorative. */
import Icon from "./Icon.astro";
interface Props {
  kind: string;
}
const { kind } = Astro.props;
// Two faces per project, captured from the prototypes and products on the
// case-study pages, so the peek is the real thing.
const faces: Record<string, [string, string, boolean?]> = {
  "pilgrim-transport": ["/media/peek/pilgrim-1.webp", "/media/peek/pilgrim-2.webp"],
  "therapy-documentation": ["/media/peek/therapy-1.webp", "/media/peek/therapy-2.webp"],
  "clinical-copilot": ["/media/peek/copilot-1.webp", "/media/peek/copilot-2.webp"],
  "claims-agent-console": ["/media/peek/claims-1.webp", "/media/peek/claims-2.webp"],
  clicker: ["/media/clicker/w-aging-light.webp", "/media/clicker/c-stages-dark.webp"],
  istyme: ["/media/istyme/en-welcome.webp", "/media/istyme/en-home.webp", true],
  "hh-global": ["/media/hh/home.webp", "/media/hh/catalogue.webp"],
  "quick-service-app": ["/media/peek/qs-1.webp", "/media/peek/qs-2.webp"],
};
const face = faces[kind];
const marks: Record<string, string> = {
  "pilgrim-transport": "van",
  "therapy-documentation": "heartbeat",
  "clinical-copilot": "microphone",
  "claims-agent-console": "receipt",
  clicker: "squares-four",
  istyme: "map-pin-area",
  "hh-global": "t-shirt",
  "quick-service-app": "hamburger",
};
---

<div class={`folder ${kind}`} aria-hidden="true">
  <div class="back"><span class="tab"></span></div>
  {face && (
    <>
      <div class="sheet s1"><img class:list={["real", { phone: face[2] }]} src={face[0]} alt="" loading="lazy" decoding="async" /></div>
      <div class="sheet s2"><img class:list={["real", { phone: face[2] }]} src={face[1]} alt="" loading="lazy" decoding="async" /></div>
    </>
  )}
  <div class="front"><span class="seam"></span>{marks[kind] && <span class="mark"><Icon name={marks[kind]} weight="duotone" size={18} /></span>}</div>
</div>

<style>
  /* A paper folder: light, hairline-edged, two screens tucked in. */
  .folder {
    --paper: #ffffff;
    --p-ink: #1a1a18;
    --p-muted: #8c8a81;
    --p-rule: #e7e5de;
    --brand: #0f6b5c;
    --ok: #1f8a4c;
    --warn: #b7791f;
    position: relative;
    height: 200px;
    margin: 10px 0 0;
  }
  .back {
    position: absolute;
    inset: 12px 0 0;
    border-radius: 12px;
    background: var(--bg-sunk);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .tab {
    position: absolute;
    left: 0;
    top: -10px;
    width: 34%;
    height: 22px;
    border-radius: 10px 10px 0 0;
    background: var(--bg-sunk);
    box-shadow: inset 1px 1px 0 var(--rule), inset -1px 0 0 var(--rule);
  }
  .sheet {
    position: absolute;
    top: 26px;
    left: 50%;
    width: 56%;
    height: 140px;
    border-radius: 8px;
    background: #f4f3f0;
    color: var(--p-ink);
    box-shadow:
      0 0 0 1px rgb(20 18 12 / 0.07),
      0 6px 16px -8px rgb(20 18 12 / 0.22);
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 9.5px;
    line-height: 1.3;
  }
  /* Straight, never tilted: screens stay pixel-sharp. */
  .s1 {
    transform: translate(-86%, 0);
  }
  .s2 {
    transform: translate(-16%, 10px);
  }
  :global(.card:hover) .s1,
  :global(.card:focus-visible) .s1 {
    transform: translate(-88%, -14px);
  }
  :global(.card:hover) .s2,
  :global(.card:focus-visible) .s2 {
    transform: translate(-14%, -8px);
  }
  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    border-radius: 12px;
    background: var(--bg-raised);
    box-shadow:
      inset 0 0 0 1px var(--rule),
      0 -10px 20px -16px rgb(20 18 12 / 0.28);
  }
  .seam {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 10px;
    border-top: 1px dashed var(--rule);
  }
  /* Which product the folder holds, small and quiet. */
  .mark {
    position: absolute;
    right: 14px;
    bottom: 12px;
    color: var(--ink-muted);
    opacity: 0.6;
    transition: opacity 0.4s;
  }
  :global(.card:hover) .mark,
  :global(.card:focus-visible) .mark {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }

  /* Sheet faces */
  .real {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  .real.phone {
    object-position: 50% 9%;
    background: #fff;
  }
</style>
