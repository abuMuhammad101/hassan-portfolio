---
/* Folder preview for a case-study card: two sheets (mini screens from the
   project) tucked into a folder. They lift and fan out when the card is
   hovered or focused. Decorative. */
import Icon from "./Icon.astro";
interface Props {
  kind: string;
}
const { kind } = Astro.props;
// Two faces per project, captured from the prototypes and products on the
// case-study pages, so the peek is the real thing.
const faces: Record<string, [string, string, boolean?]> = {
  "pilgrim-transport": ["/media/peek/pilgrim-1.webp", "/media/peek/pilgrim-2.webp"],
  "therapy-documentation": ["/media/peek/therapy-1.webp", "/media/peek/therapy-2.webp"],
  "clinical-copilot": ["/media/peek/copilot-1.webp", "/media/peek/copilot-2.webp"],
  "claims-agent-console": ["/media/peek/claims-1.webp", "/media/peek/claims-2.webp"],
  clicker: ["/media/clicker/w-aging-light.webp", "/media/clicker/c-stages-dark.webp"],
  istyme: ["/media/istyme/en-welcome.webp", "/media/istyme/en-home.webp", true],
  "hh-global": ["/media/hh/home.webp", "/media/hh/catalogue.webp"],
  "quick-service-app": ["/media/peek/qs-1.webp", "/media/peek/qs-2.webp"],
};
const face = faces[kind];
const marks: Record<string, string> = {
  "pilgrim-transport": "van",
  "therapy-documentation": "heartbeat",
  "clinical-copilot": "microphone",
  "claims-agent-console": "receipt",
  clicker: "squares-four",
  istyme: "map-pin-area",
  "hh-global": "t-shirt",
  "quick-service-app": "hamburger",
};
---

<div class={`folder ${kind}`} aria-hidden="true">
  <div class="back"><span class="tab"></span></div>
  {face && (
    <>
      <div class="sheet s1"><img class:list={["real", { phone: face[2] }]} src={face[0]} alt="" loading="lazy" decoding="async" /></div>
      <div class="sheet s2"><img class:list={["real", { phone: face[2] }]} src={face[1]} alt="" loading="lazy" decoding="async" /></div>
    </>
  )}
  <div class="front"><span class="seam"></span>{marks[kind] && <span class="mark"><Icon name={marks[kind]} weight="duotone" size={22} /></span>}</div>
</div>

<style>
  .folder {
    --f-back: #26272c;
    --f-front: linear-gradient(180deg, #3b3d45 0%, #2b2d33 100%);
    --paper: #ffffff;
    --p-ink: #1a1a18;
    --p-muted: #8c8a81;
    --p-rule: #e7e5de;
    --brand: #0f6b5c;
    --ok: #1f8a4c;
    --warn: #b7791f;
    position: relative;
    height: 212px;
    margin: 10px 0 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.card:hover) .folder,
  :global(.card:focus-visible) .folder {
    transform: translateY(-4px);
  }
  :global(.card:hover) .front,
  :global(.card:focus-visible) .front {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 -6px 14px -10px rgb(0 0 0 / 0.45),
      0 24px 28px -14px rgb(20 20 24 / 0.38);
  }
  .back {
    position: absolute;
    inset: 16px 0 0;
    border-radius: 14px;
    background: var(--f-back);
  }
  .tab {
    position: absolute;
    left: 0;
    top: -12px;
    width: 38%;
    height: 26px;
    border-radius: 12px 12px 0 0;
    background: var(--f-back);
  }
  .sheet {
    position: absolute;
    top: 24px;
    left: 50%;
    width: 58%;
    height: 150px;
    border-radius: 10px;
    background: var(--paper);
    color: var(--p-ink);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 8px 18px -8px rgb(0 0 0 / 0.5);
    overflow: hidden;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    /* Keeps the tilted edges smooth instead of stair-stepped. */
    outline: 1px solid transparent;
    backface-visibility: hidden;
    font-size: 9.5px;
    line-height: 1.3;
  }
  .s1 {
    transform: translateX(-80%) rotate(-6deg);
  }
  .s2 {
    transform: translateX(-24%) rotate(6deg);
  }
  :global(.card:hover) .s1,
  :global(.card:focus-visible) .s1 {
    transform: translateX(-88%) translateY(-26px) rotate(-9deg);
  }
  :global(.card:hover) .s2,
  :global(.card:focus-visible) .s2 {
    transform: translateX(-14%) translateY(-30px) rotate(8deg);
  }
  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 40%;
    border-radius: 14px;
    background: var(--f-front);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 -6px 14px -10px rgb(0 0 0 / 0.45),
      0 16px 20px -12px rgb(20 20 24 / 0.3);
    transition: box-shadow 0.45s;
  }
  .seam {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  /* A debossed mark: which product this folder holds, felt more than seen. */
  .mark {
    position: absolute;
    right: 16px;
    bottom: 14px;
    color: rgb(255 255 255 / 0.22);
    transition: color 0.45s;
  }
  :global(.card:hover) .mark,
  :global(.card:focus-visible) .mark {
    color: rgb(255 255 255 / 0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }

  /* Sheet faces */
  .real {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  .real.phone {
    object-position: 50% 9%;
    background: #fff;
  }
</style>
