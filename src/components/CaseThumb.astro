---
/* Small abstract preview for a case-study card. */
import Icon from "./Icon.astro";
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<div class={`thumb ${kind}`} aria-hidden="true">
  {kind === "pilgrim-transport" && (
    <div class="route">
      <span class="stop"><Icon name="airplane-takeoff" size={16} /> Airport</span>
      <span class="track"><i></i><span class="van"><Icon name="van" weight="fill" size={20} /></span></span>
      <span class="stop"><Icon name="mosque" size={16} /> Haram</span>
    </div>
  )}
  {kind === "therapy-documentation" && (
    <div class="thread">
      <span class="node ok"><Icon name="check-circle" weight="fill" size={16} /> Evaluation</span>
      <span class="node ok"><Icon name="check-circle" weight="fill" size={16} /> Plan of care</span>
      <span class="node"><Icon name="lock-simple" size={16} /> Session note</span>
    </div>
  )}
  {kind === "clinical-copilot" && (
    <div class="cop">
      <i></i><i></i><i></i>
      <div class="bubble"><Icon name="sparkle" weight="fill" size={14} /> Which patient is this for?</div>
    </div>
  )}
</div>

<style>
  .thumb {
    height: 150px;
    border-radius: 12px;
    background: var(--bg-sunk);
    display: grid;
    place-items: center;
    padding: 16px;
    font-size: 12px;
    color: var(--ink);
    overflow: hidden;
  }
  .route {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .stop,
  .node,
  .bubble {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 5px 10px;
    white-space: nowrap;
  }
  .track {
    position: relative;
    flex: 1;
    height: 20px;
  }
  .track i {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1.5px dashed var(--ink-muted);
  }
  .van {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg-sunk);
    padding: 0 4px;
    display: flex;
    color: var(--accent-site);
  }
  .thread {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }
  .node.ok :global(svg) {
    color: var(--ok);
  }
  .node:not(.ok) {
    color: var(--ink-muted);
    border-style: dashed;
  }
  .cop {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .cop i {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    margin-bottom: 10px;
    width: 70%;
  }
  .cop i:nth-child(2) { width: 90%; }
  .cop i:nth-child(3) { width: 50%; }
  .bubble {
    position: absolute;
    right: 0;
    bottom: 0;
    border-color: var(--ink);
    border-radius: 12px;
    box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.25);
  }
</style>
