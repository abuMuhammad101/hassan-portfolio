---
/* Folder preview for a case-study card. A dark folder holds one sheet that
   shows a single moment from the product, drawn small and sharp, with a
   plain sheet behind it for depth. Both lift when the card is hovered or
   focused. Decorative. */
import Icon from "./Icon.astro";
interface Props {
  kind: string;
}
const { kind } = Astro.props;
const marks: Record<string, string> = {
  "pilgrim-transport": "van",
  "therapy-documentation": "heartbeat",
  "clinical-copilot": "microphone",
  "claims-agent-console": "receipt",
  clicker: "squares-four",
  istyme: "map-pin-area",
  "hh-global": "t-shirt",
  "quick-service-app": "hamburger",
};
const known = kind in marks;
---

<div class={`folder ${kind}`} aria-hidden="true">
  <div class="back"><span class="tab"></span></div>
  {known && (
    <>
      <div class="sheet s1"><i></i><i></i><i></i></div>
      <div class:list={["sheet", "s2", { glass: kind === "clinical-copilot" }]}>
        {kind === "pilgrim-transport" && (
          <div class="pg">
            <div class="seg"><b>Airport</b><span>Between cities</span></div>
            <div class="route">
              <span><small>From</small>Jeddah Airport (JED)</span>
              <span><small>To</small>Hotel in Makkah</span>
            </div>
            <div class="line"><span>Fixed fare</span><b>SAR 260</b></div>
          </div>
        )}
        {kind === "therapy-documentation" && (
          <ul class="th">
            <li class="done"><i><Icon name="check" size={7} weight="bold" /></i><b>Initial evaluation</b><em class="ok">Signed</em></li>
            <li class="warn"><i></i><b>Plan of care</b><em>Needs certification</em></li>
            <li class="lock"><i></i><b>Daily notes</b><em>Locked</em></li>
          </ul>
        )}
        {kind === "clinical-copilot" && (
          <div class="cp">
            <p>Is this the right patient?</p>
            <span class="who"><b>AB</b><span>Arthur Bell<small>78 · Room 214</small></span></span>
            <span class="acts"><span>Someone else</span><span class="yes">Yes, that's him</span></span>
          </div>
        )}
        {kind === "claims-agent-console" && (
          <div class="cl">
            {[["Intake", "214", 72], ["Coding", "386", 88], ["Eligibility", "301", 64]].map(([k, v, w]) => (
              <span><small>{k}</small><b>{v}</b><i style={`--w:${w}%`}></i></span>
            ))}
          </div>
        )}
        {kind === "clicker" && (
          <div class="ck">
            <p><b>Aging</b><small>1,444 bills</small></p>
            <span class="bar">{[34, 21, 21, 9, 55, 174].map((v, k) => <i style={`flex:${v};--k:${k}`}></i>)}</span>
            <span class="kv"><small>Outstanding</small><b>Rs 311 crore</b></span>
            <span class="kv"><small>Overdue</small><b class="red">Rs 278 crore</b></span>
          </div>
        )}
        {kind === "istyme" && (
          <div class="is">
            <p>3 offers</p>
            <span class="offer">
              <span class="who"><b>IQ</b><span>Imran Qureshi<small>★ 4.9 · 132 jobs</small></span><em>Rs 1,100</em></span>
              <span class="hire">Hire Imran</span>
            </span>
          </div>
        )}
        {kind === "hh-global" && (
          <div class="hh">
            <span class="logo"><i></i>H&amp;H Global</span>
            <p>Precision Garments &amp; Genuine Leather</p>
            <span class="btn">View Collection</span>
          </div>
        )}
        {kind === "quick-service-app" && (
          <div class="qs">
            <div class="seg"><span>Delivery</span><b>Pickup</b></div>
            <span class="at"><small>Pick up at</small>Gate Branch</span>
            <span class="ready"><i></i>Ready in ~15 min</span>
          </div>
        )}
      </div>
    </>
  )}
  <div class="front"><span class="seam"></span>{known && <span class="mark"><Icon name={marks[kind]} weight="duotone" size={22} /></span>}</div>
</div>

<style>
  .folder {
    --f-back: #26272c;
    --f-front: linear-gradient(180deg, #3b3d45 0%, #2b2d33 100%);
    --ink: #1a1a18;
    --mute: #8c8a81;
    --line: #ebe9e3;
    position: relative;
    height: 212px;
    margin: 10px 0 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.card:hover) .folder,
  :global(.card:focus-visible) .folder {
    transform: translateY(-4px);
  }
  .back {
    position: absolute;
    inset: 16px 0 0;
    border-radius: 14px;
    background: var(--f-back);
  }
  .tab {
    position: absolute;
    left: 0;
    top: -12px;
    width: 38%;
    height: 26px;
    border-radius: 12px 12px 0 0;
    background: var(--f-back);
  }
  /* Sheets sit straight, so edges and text stay sharp. */
  .sheet {
    position: absolute;
    left: 50%;
    width: 58%;
    height: 150px;
    border-radius: 9px;
    overflow: hidden;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .s1 {
    top: 30px;
    display: grid;
    align-content: start;
    gap: 7px;
    padding: 16px 14px;
    background: #4a4c54;
    transform: translateX(-78%);
  }
  .s1 i {
    height: 5px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.12);
  }
  .s1 i:nth-child(2) {
    width: 70%;
  }
  .s1 i:nth-child(3) {
    width: 45%;
  }
  .s2 {
    top: 22px;
    padding: 14px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.55);
    transform: translateX(-34%);
    font: 400 10px/1.3 var(--font-sans);
  }
  :global(.card:hover) .s1,
  :global(.card:focus-visible) .s1 {
    transform: translate(-80%, -10px);
  }
  :global(.card:hover) .s2,
  :global(.card:focus-visible) .s2 {
    transform: translate(-32%, -20px);
  }
  .front {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 40%;
    border-radius: 14px;
    background: var(--f-front);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 -6px 14px -10px rgb(0 0 0 / 0.45),
      0 16px 20px -12px rgb(20 20 24 / 0.3);
    transition: box-shadow 0.45s;
  }
  :global(.card:hover) .front,
  :global(.card:focus-visible) .front {
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 -6px 14px -10px rgb(0 0 0 / 0.45),
      0 24px 28px -14px rgb(20 20 24 / 0.38);
  }
  .seam {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .mark {
    position: absolute;
    right: 16px;
    bottom: 14px;
    color: rgb(255 255 255 / 0.22);
    transition: color 0.45s;
  }
  :global(.card:hover) .mark,
  :global(.card:focus-visible) .mark {
    color: rgb(255 255 255 / 0.5);
  }

  /* One moment per product. */
  small {
    display: block;
    font-size: 8.5px;
    color: var(--mute);
  }
  b {
    font-weight: 600;
  }
  .seg {
    display: flex;
    padding: 2px;
    border-radius: 7px;
    background: #f1f0ec;
  }
  .seg > * {
    flex: 1;
    padding: 4px 0;
    border-radius: 5px;
    text-align: center;
    font-size: 9px;
    color: var(--mute);
  }
  .seg b {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  /* Pilgrim */
  .pg {
    display: grid;
    gap: 8px;
  }
  .route {
    display: grid;
    gap: 6px;
    padding: 8px 9px;
    border-radius: 7px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 500;
  }
  .line {
    display: flex;
    justify-content: space-between;
    color: var(--mute);
  }
  .line b {
    color: #0f3d2a;
  }
  /* Therapy */
  .th {
    list-style: none;
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
  }
  .th li {
    display: grid;
    grid-template-columns: 12px 1fr;
    align-items: center;
    column-gap: 7px;
    padding: 7px 8px;
    border-radius: 7px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .th i {
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px #cfccc4;
  }
  .th .done i {
    background: #4b4fd6;
    box-shadow: none;
    color: #fff;
  }
  .th .warn i {
    box-shadow: inset 0 0 0 1.2px #b45309;
  }
  .th b {
    font-weight: 500;
  }
  .th em {
    grid-column: 2;
    font-size: 8.5px;
    font-style: normal;
    color: #b45309;
  }
  .th em.ok {
    color: #1f7a45;
  }
  .th .lock {
    color: var(--mute);
  }
  .th .lock em {
    color: var(--mute);
  }
  /* Copilot: the frosted overlay */
  .s2.glass {
    background: #7b7d83;
    color: #fff;
  }
  .cp {
    display: grid;
    justify-items: center;
    gap: 7px;
  }
  .cp p {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
  }
  .cp .who {
    width: 100%;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 8px;
    border-radius: 9px;
    background: #fff;
    color: var(--ink);
    font-weight: 500;
  }
  .who > b {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #efeee9;
    font-size: 8px;
  }
  .who > span {
    flex: 1;
  }
  .acts {
    display: flex;
    gap: 5px;
  }
  .acts span {
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: 99px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6);
    font-size: 9px;
    font-weight: 500;
  }
  .acts .yes {
    background: #fff;
    color: var(--ink);
    box-shadow: none;
  }
  /* Claims */
  .cl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: 7px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cl > span {
    display: grid;
    gap: 3px;
    padding: 10px 8px;
  }
  .cl > span + span {
    border-left: 1px solid var(--line);
  }
  .cl b {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .cl i {
    height: 2px;
    margin-top: 6px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--ink) var(--w), #eeede9 var(--w));
  }
  /* Clicker */
  .ck {
    display: grid;
    gap: 9px;
  }
  .ck p {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin: 0;
  }
  .ck p b {
    font-size: 13px;
  }
  .ck p small {
    display: inline;
  }
  .ck .bar {
    display: flex;
    gap: 2px;
    height: 5px;
  }
  .ck .bar i {
    border-radius: 2px;
    background: color-mix(in srgb, #5b4fd6 calc(18% + var(--k) * 16%), #efedfb);
  }
  .kv {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }
  .kv small {
    font-size: 9px;
  }
  .kv .red {
    color: #b42318;
  }
  /* isTyme */
  .is p {
    margin: 0 0 7px;
    font-size: 11px;
    font-weight: 600;
  }
  .offer {
    display: grid;
    gap: 7px;
    padding: 7px;
    border-radius: 9px;
    box-shadow: inset 0 0 0 1.2px var(--ink);
  }
  .offer .who {
    padding: 0;
  }
  .offer em {
    font-style: normal;
    font-weight: 600;
  }
  .hire {
    padding: 5px 0;
    border-radius: 99px;
    background: #1f8a4c;
    color: #fff;
    text-align: center;
    font-size: 9px;
    font-weight: 600;
  }
  /* HH Global */
  .hh {
    display: grid;
    gap: 9px;
    justify-items: start;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 8.5px;
    font-weight: 600;
  }
  .logo i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, #111 50%, #c9a24a 50%);
  }
  .hh p {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .hh .btn {
    padding: 5px 10px;
    border-radius: 99px;
    background: var(--ink);
    color: #fff;
    font-size: 8.5px;
    font-weight: 600;
  }
  /* Quick-service */
  .qs {
    display: grid;
    gap: 9px;
  }
  .at {
    font-size: 12px;
    font-weight: 600;
  }
  .ready {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 8px;
    border-radius: 7px;
    background: #f6f5f1;
    font-weight: 500;
  }
  .ready i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #1f8a4c;
  }
  @media (prefers-reduced-motion: reduce) {
    .folder,
    .sheet {
      transition: none;
    }
  }
</style>
