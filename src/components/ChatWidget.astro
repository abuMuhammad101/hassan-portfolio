---
/* "Message Hassan": a one-way note that lands in his inbox, set out like a
   chat. The visitor writes, then leaves an email; Hassan answers by email.
   Sent through Web3Forms when PUBLIC_WEB3FORMS_KEY is set; without a key it
   falls back to the visitor's mail app, so it never breaks. */
import Icon from "./Icon.astro";
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const email = "hassank.uiux@gmail.com";
const starts = [
  ["I'm hiring", "Hi Hassan, I'm hiring for a role: "],
  ["I have a product", "Hi Hassan, I have a product that needs a designer: "],
  ["Just saying hi", "Hi Hassan, "],
];
---

<div class="chat" data-chat data-state="closed" data-step="message" data-key={key} data-email={email}>
  <section class="panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-h" hidden>
    <header class="ph">
      <span class="av" aria-hidden="true">H<i></i></span>
      <div class="who">
        <h2 id="chat-h">Hassan Khan</h2>
        <p><i aria-hidden="true"></i>Replies by email</p>
      </div>
      <button type="button" class="x" data-chat-close aria-label="Close"><Icon name="x" size={15} /></button>
    </header>

    <div class="thread" data-thread role="log" aria-live="polite">
      <p class="day">Today</p>
      <div class="msg in">
        <p>Hi, I'm Hassan.</p>
        <p>Tell me about the role, the product or the question. It goes straight to my inbox and I answer by email.</p>
      </div>
      <div class="starts" data-starts>
        {starts.map(([label, text]) => <button type="button" data-start={text}>{label}</button>)}
      </div>
    </div>

    <form class="composer" data-chat-form novalidate>
      <label class="sr-only" for="chat-input" data-label>Message</label>
      <textarea id="chat-input" name="message" rows="1" maxlength="2000" placeholder="Write a message…" data-input></textarea>
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button type="submit" class="send" aria-label="Send" disabled><Icon name="arrow-up" size={16} weight="bold" /></button>
    </form>
    <p class="foot" data-foot>Enter to send · Shift + Enter for a new line</p>
  </section>

  <button type="button" class="fab" data-chat-open aria-expanded="false" aria-controls="chat-panel">
    <span class="av sm" aria-hidden="true">H<i></i></span>
    <span class="lbl">Message me</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-chat]").forEach((root) => {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const panel = $("#chat-panel"),
      fab = $<HTMLButtonElement>("[data-chat-open]"),
      form = $<HTMLFormElement>("[data-chat-form]"),
      thread = $("[data-thread]"),
      starts = $("[data-starts]"),
      input = $<HTMLTextAreaElement>("[data-input]"),
      label = $("[data-label]"),
      foot = $("[data-foot]"),
      send = form.querySelector<HTMLButtonElement>(".send")!;
    const draftKey = "chat-draft";
    let message = "";

    const set = (open: boolean) => {
      root.dataset.state = open ? "open" : "closed";
      panel.hidden = !open;
      fab.setAttribute("aria-expanded", String(open));
      if (open) {
        input.focus({ preventScroll: true });
        thread.scrollTop = thread.scrollHeight;
      } else fab.focus({ preventScroll: true });
    };
    fab.addEventListener("click", () => set(root.dataset.state !== "open"));
    $("[data-chat-close]").addEventListener("click", () => set(false));
    root.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape" && root.dataset.state === "open") set(false);
    });
    // Any "contact" link on the page can open it too.
    document.querySelectorAll<HTMLElement>("[data-open-chat]").forEach((a) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        set(true);
      }),
    );

    // The composer grows with the text, up to a few lines.
    const fit = () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 132)}px`;
      send.disabled = !input.value.trim();
    };
    input.addEventListener("input", () => {
      fit();
      if (root.dataset.step === "message") {
        try {
          localStorage.setItem(draftKey, input.value);
        } catch {}
      }
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
    try {
      input.value = localStorage.getItem(draftKey) ?? "";
    } catch {}
    fit();

    // Quick starts fill the composer; the visitor finishes the sentence.
    starts.querySelectorAll<HTMLButtonElement>("[data-start]").forEach((b) =>
      b.addEventListener("click", () => {
        input.value = b.dataset.start!;
        fit();
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      }),
    );

    const bubble = (side: "in" | "out", text: string, cls = "") => {
      const el = document.createElement("div");
      el.className = `msg ${side} ${cls}`.trim();
      text.split(/\n+/).forEach((line) => {
        const p = document.createElement("p");
        p.textContent = line;
        el.append(p);
      });
      thread.append(el);
      thread.scrollTop = thread.scrollHeight;
      return el;
    };
    const typing = () => {
      const el = document.createElement("div");
      el.className = "msg in typing";
      el.setAttribute("aria-label", "Hassan is typing");
      el.innerHTML = "<i></i><i></i><i></i>";
      thread.append(el);
      thread.scrollTop = thread.scrollHeight;
      return el;
    };
    const reply = (text: string, cls = "") =>
      new Promise<HTMLElement>((done) => {
        const t = typing();
        setTimeout(() => {
          t.remove();
          done(bubble("in", text, cls));
        }, 650);
      });
    const mode = (step: "message" | "email" | "done") => {
      root.dataset.step = step;
      if (step === "email") {
        input.value = "";
        input.setAttribute("inputmode", "email");
        input.setAttribute("autocomplete", "email");
        input.placeholder = "you@company.com";
        label.textContent = "Your email";
        foot.textContent = "Only used to reply to you";
      } else {
        input.removeAttribute("inputmode");
        input.removeAttribute("autocomplete");
        input.placeholder = "Write a message…";
        label.textContent = "Message";
        foot.textContent = "Enter to send · Shift + Enter for a new line";
      }
      fit();
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (!value || form.querySelector<HTMLInputElement>(".hp")!.checked) return;

      if (root.dataset.step === "message") {
        message = value;
        starts.remove();
        bubble("out", value);
        mode("email");
        await reply("Got it. Where should I reply?");
        input.focus();
        return;
      }

      if (root.dataset.step === "email") {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
          await reply("That doesn't look like an email address. Could you check it?");
          return;
        }
        bubble("out", value);
        input.value = "";
        fit();
        const key = root.dataset.key;
        if (!key) {
          // No key configured: hand over to the visitor's mail app.
          const body = encodeURIComponent(`${message}\n\n${value}`);
          location.href = `mailto:${root.dataset.email}?subject=${encodeURIComponent("Hello from hassank.space")}&body=${body}`;
          await reply("Your mail app should open with the message ready to send.");
          return;
        }
        root.dataset.sending = "true";
        const status = bubble("in", "Sending…", "note");
        try {
          const res = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({
              access_key: key,
              subject: `New message from ${value} via hassank.space`,
              from_name: "hassank.space",
              email: value,
              replyto: value,
              message,
              page: location.pathname,
            }),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok || json.success === false) throw new Error();
          status.remove();
          await reply(`Sent. Thanks, I'll reply to ${value}.`, "ok");
          try {
            localStorage.removeItem(draftKey);
          } catch {}
          mode("done");
          const again = document.createElement("div");
          again.className = "starts";
          again.innerHTML = '<button type="button">Write another</button>';
          again.querySelector("button")!.addEventListener("click", () => {
            again.remove();
            mode("message");
            input.focus();
          });
          thread.append(again);
          thread.scrollTop = thread.scrollHeight;
        } catch {
          status.remove();
          await reply(`It didn't go through. Send your email again to retry, or write to ${root.dataset.email}.`, "err");
        } finally {
          delete root.dataset.sending;
        }
      }
    });
  });
</script>

<style>
  .chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    display: grid;
    justify-items: end;
    gap: 12px;
    font-family: var(--font-sans);
    pointer-events: none;
  }
  .chat > * {
    pointer-events: auto;
  }
  .fab {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 16px 0 6px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font: inherit;
    font-size: 14px;
    font-weight: 550;
    box-shadow: var(--lift-2);
    cursor: pointer;
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s;
    animation: fab-in 0.5s 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes fab-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .fab:hover {
    transform: translateY(-2px);
    box-shadow: var(--lift-3);
  }
  .fab:focus-visible,
  .x:focus-visible,
  .send:focus-visible,
  .thread :global(.starts button:focus-visible) {
    outline: 2px solid var(--accent-site);
    outline-offset: 2px;
  }
  .chat[data-state="open"] .fab .lbl {
    display: none;
  }
  .chat[data-state="open"] .fab {
    padding: 0 6px;
  }
  .av {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f1e3c8;
    color: #6b4a10;
    font-family: var(--font-hand);
    font-size: 20px;
    font-weight: 600;
  }
  .av.sm {
    width: 32px;
    height: 32px;
    font-size: 18px;
  }
  .av i {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2f9e5b;
    box-shadow: 0 0 0 2px var(--ink);
  }
  .panel .av i {
    box-shadow: 0 0 0 2px var(--bg-raised);
  }

  /* The window. */
  .panel {
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 32px));
    height: min(560px, calc(100dvh - 110px));
    border-radius: 22px;
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ink) 7%, transparent),
      0 24px 60px -20px rgb(20 18 12 / 0.35),
      0 8px 20px -10px rgb(20 18 12 / 0.18);
    overflow: hidden;
    transform-origin: 100% 100%;
    animation: pop 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel[hidden] {
    display: none;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
  }
  .ph {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 14px 14px 12px 16px;
    border-bottom: 1px solid var(--rule);
  }
  .who {
    flex: 1;
  }
  h2 {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
  }
  .who p {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 1px 0 0;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .who p i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2f9e5b;
  }
  .x {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: background 0.2s;
  }
  .x:hover {
    background: var(--bg-sunk);
  }

  /* The conversation. */
  .thread {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 14px 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .day {
    align-self: center;
    margin: 0 0 4px;
    font-size: 11px;
    color: var(--ink-muted);
  }
  .thread :global(.msg) {
    display: grid;
    gap: 6px;
    max-width: 84%;
    padding: 9px 13px;
    border-radius: 18px;
    font-size: 14px;
    line-height: 1.45;
    overflow-wrap: anywhere;
    animation: rise 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .thread :global(.msg p) {
    margin: 0;
  }
  .thread :global(.msg.in) {
    align-self: flex-start;
    border-bottom-left-radius: 6px;
    background: var(--bg-sunk);
    color: var(--ink);
  }
  .thread :global(.msg.out) {
    align-self: flex-end;
    border-bottom-right-radius: 6px;
    background: var(--ink);
    color: var(--bg);
  }
  .thread :global(.msg.note) {
    color: var(--ink-muted);
  }
  .thread :global(.msg.ok) {
    background: color-mix(in srgb, #2f9e5b 12%, var(--bg-raised));
  }
  .thread :global(.msg.err) {
    background: color-mix(in srgb, #c0392b 10%, var(--bg-raised));
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .thread :global(.typing) {
    display: flex;
    gap: 4px;
    padding: 13px 14px;
  }
  .thread :global(.typing i) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-muted);
    animation: dot 1s infinite ease-in-out;
  }
  .thread :global(.typing i:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .thread :global(.typing i:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes dot {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: none;
    }
    40% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }
  .thread :global(.starts) {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
  .thread :global(.starts button) {
    padding: 7px 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition:
      background 0.2s,
      box-shadow 0.2s;
  }
  .thread :global(.starts button:hover) {
    background: var(--bg-sunk);
    box-shadow: inset 0 0 0 1px transparent;
  }

  /* The composer: one pill, a round send button inside it. */
  .composer {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    margin: 0 12px;
    padding: 6px 6px 6px 14px;
    border-radius: 22px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: box-shadow 0.2s;
  }
  .composer:focus-within {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--ink) 40%, transparent),
      0 0 0 3px color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .composer textarea {
    flex: 1;
    min-height: 32px;
    max-height: 132px;
    padding: 6px 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14.5px;
    line-height: 20px;
    resize: none;
    outline: none;
  }
  .composer textarea::placeholder {
    color: var(--ink-muted);
  }
  .send {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    cursor: pointer;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .send:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .send:not(:disabled):hover {
    transform: scale(1.06);
  }
  .chat[data-sending] .send {
    opacity: 0.25;
    pointer-events: none;
  }
  .chat[data-step="done"] .composer,
  .chat[data-step="done"] .foot {
    visibility: hidden;
  }
  .foot {
    margin: 0;
    padding: 7px 0 10px;
    text-align: center;
    font-size: 11px;
    color: var(--ink-muted);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .chat {
      right: 12px;
      bottom: 12px;
      left: 12px;
    }
    .panel {
      width: 100%;
      height: min(560px, calc(100dvh - 90px));
    }
    .fab .lbl {
      display: none;
    }
    .fab {
      padding: 0 6px;
    }
    .composer textarea {
      font-size: 16px;
    }
  }
  /* On touch there is no Enter key hint to give. */
  @media (pointer: coarse) {
    .chat[data-step="message"] .foot {
      visibility: hidden;
      padding: 0 0 6px;
      font-size: 0;
    }
  }
  @media print {
    .chat {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .fab,
    .thread :global(.msg),
    .thread :global(.typing i) {
      animation: none;
    }
    .fab,
    .send {
      transition: none;
    }
  }
</style>
