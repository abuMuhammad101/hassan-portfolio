---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import CaseStudy from "../../components/CaseStudy.astro";
import Icon from "../../components/Icon.astro";
import InventoryMock from "../../components/widgets/InventoryMock.astro";
import LandlordMock from "../../components/widgets/LandlordMock.astro";
import ExamMock from "../../components/widgets/ExamMock.astro";
import MealWalletMock from "../../components/widgets/MealWalletMock.astro";
import CookiyaMock from "../../components/widgets/CookiyaMock.astro";
import "../../styles/story.css";

export async function getStaticPaths() {
  const work = await getCollection("work");
  const cases = (await getCollection("cases")).sort((x, y) => x.data.order - y.data.order);
  return [
    ...work.map((entry) => ({ params: { slug: entry.slug }, props: { entry, study: null, next: null } })),
    ...cases.map((c, i) => {
      const n = cases[(i + 1) % cases.length];
      return {
        params: { slug: c.id },
        props: {
          entry: null,
          study: c.data,
          next: { slug: n.id, title: [n.data.title, n.data.titleRest].filter(Boolean).join(" ") },
        },
      };
    }),
  ];
}

const { entry, study, next } = Astro.props as any;
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;
const { title, kicker, highlight, accentVar, status, stack, link, linkLabel, image, imageAlt, nda, widget } = entry?.data ?? {};
// The other earlier projects, for the way out at the bottom.
const siblings = entry
  ? (await getCollection("work")).filter((w) => w.slug !== entry.slug && w.slug !== "motions").sort((x, y) => x.data.order - y.data.order)
  : [];
---

{study ? (
  <Base title={`${[study.title, study.titleRest].filter(Boolean).join(" ")} — Hassan Khan`} description={study.angle}>
    <Header showBack wide />
    <CaseStudy data={study} next={next} />
    <Footer />
  </Base>
) : (
  <Base title={`${title} — Hassan Khan`} description={highlight}>
    <Header showBack wide />
    <main class="wrap-wide early" style={`--accent: var(${accentVar})`}>
      <header class="hero">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/#work">Work</a>
          <span aria-hidden="true">/</span>
          <span>Earlier projects</span>
        </nav>
        <h1 style={`view-transition-name: t-${entry.slug}`}>{title}</h1>
        <p class="angle">{highlight}</p>
        <p class="nda">{nda ? <><Icon name="lock-simple" size={13} />Under NDA. Re-created with a stand-in brand and data.</> : "Side project, no NDA."}</p>
        <dl class="facts">
          <div><dt>Type</dt><dd>{kicker}</dd></div>
          <div><dt>When</dt><dd>{status}</dd></div>
          <div><dt>Tools</dt><dd>{stack.join(" · ")}</dd></div>
          {link && <div><dt>Live</dt><dd><a href={link} target="_blank" rel="noopener noreferrer">{linkLabel ?? "Visit"} ↗</a></dd></div>}
        </dl>
      </header>

      <section class="show" style={`--story-accent: var(${accentVar})`}>
        {widget === "inventory" && <InventoryMock />}
        {widget === "landlord" && <LandlordMock />}
        {widget === "exam" && <ExamMock />}
        {widget === "meal" && <MealWalletMock />}
        {widget === "cookiya" && <CookiyaMock />}
        {!widget && image && (
          <figure class="frame">
            <span class="s-h tl" aria-hidden="true"></span><span class="s-h tr" aria-hidden="true"></span>
            <span class="s-h bl" aria-hidden="true"></span><span class="s-h br" aria-hidden="true"></span>
            <img src={image} alt={imageAlt ?? ""} loading="eager" decoding="async" />
          </figure>
        )}
      </section>

      <div class="prose">
        <Content />
      </div>

      <nav class="more" aria-label="More earlier work">
        <p>More earlier work</p>
        <ul>
          {siblings.map((w) => (
            <li><a href={`/work/${w.slug}/`}><span>{w.data.title}</span><small>{w.data.kicker}</small><Icon name="arrow-up-right" size={14} /></a></li>
          ))}
        </ul>
      </nav>
    </main>
    <Footer />
  </Base>
)}

<style>
  .early {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 var(--space-4);
    font-size: 13.5px;
    color: var(--ink-muted);
  }
  .crumbs a {
    color: var(--ink-secondary);
    text-decoration: none;
  }
  .nda {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 18px 0 0;
    font-size: 13.5px;
    color: var(--ink-muted);
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .slash {
    color: var(--construct);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    margin-left: auto;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--bg-raised);
    box-shadow: var(--lift-1);
    font-size: 12px;
    color: var(--ink-secondary);
  }
  .badge i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  h1 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 380;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }
  .angle {
    max-width: 46ch;
    margin: var(--space-3) 0 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-secondary);
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    margin: var(--space-6) 0 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .facts dd {
    margin: 2px 0 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .facts div + div {
      padding-left: 24px;
      border-left: 1px solid var(--rule);
    }
  }

  .show {
    margin: var(--space-8) 0 var(--space-6);
  }
  .frame {
    position: relative;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 1px solid var(--rule);
    background: var(--bg-sunk);
  }
  .frame img,
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: var(--lift-3);
  }

  .prose {
    max-width: var(--content-width);
    margin: 0 auto;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--ink-secondary);
  }
  .prose :global(h2) {
    margin: var(--space-6) 0 var(--space-1);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
  }
  .prose :global(p) {
    margin: 0 0 1em;
  }
  .prose :global(p:has(img)) {
    margin: var(--space-4) calc(50% - min(50vw - 24px, 540px));
    padding: clamp(14px, 3vw, 36px);
    border: 1px solid var(--rule);
    background: var(--bg-sunk);
  }
  .prose :global(hr) {
    display: none;
  }

  .more {
    max-width: var(--content-width);
    margin: var(--space-8) auto 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }
  .more p {
    margin: 0 0 var(--space-2);
    font-size: 12.5px;
    color: var(--ink-muted);
  }
  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .more a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .more small {
    margin-left: auto;
    color: var(--ink-muted);
    font-size: 12.5px;
  }
  .more a :global(svg) {
    align-self: center;
    color: var(--ink-muted);
    transition: transform 0.25s;
  }
  .more a:hover :global(svg) {
    transform: translate(2px, -2px);
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .crumbs .slash,
    .crumbs .slash + span {
      display: none;
    }
    .more small {
      display: none;
    }
  }
</style>
