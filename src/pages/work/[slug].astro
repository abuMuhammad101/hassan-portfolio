---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, kicker, accentVar, status, stack, link, linkLabel } = entry.data;
---

<Base title={`${title} — Hassan Khan`} description={entry.data.highlight}>
  <Header showBack />
  <main class="wrap case" style={`--accent: var(${accentVar})`}>
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="status tabular-nums">{status}</p>
    <div class="stack-tags">
      {stack.map((s) => (
        <span class="tag">{s}</span>
      ))}
    </div>
    {link && (
      <a class="external" href={link} target="_blank" rel="noopener noreferrer">
        {linkLabel ?? "Visit"} ↗
      </a>
    )}

    <div class="body reveal">
      <Content />
    </div>
  </main>
  <Footer />
</Base>

<style>
  .case {
    padding-top: var(--space-2);
    padding-bottom: var(--space-4);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    margin: 0 0 10px;
  }
  h1 {
    font-size: var(--text-2xl);
    line-height: 1.25;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .status {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0 0 var(--space-3);
  }
  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-2);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 3px 8px;
  }
  .external {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
  }
  .external:hover {
    text-decoration: underline;
  }
  .body {
    margin-top: var(--space-6);
    max-width: 62ch;
  }
  .body :global(h2) {
    font-size: var(--text-xl);
    margin: var(--space-6) 0 var(--space-2);
    color: var(--ink);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }
  .body :global(h2:first-child) {
    border-top: none;
    padding-top: 0;
  }
  .body :global(p) {
    color: var(--ink-secondary);
    margin: 0 0 var(--space-2);
  }
  .body :global(ul) {
    color: var(--ink-secondary);
    padding-left: 1.2em;
  }
  .body :global(li) {
    margin-bottom: 8px;
  }
  .body :global(strong) {
    color: var(--ink);
  }
  .body :global(a) {
    color: var(--accent);
  }
  .body :global(img) {
    border-radius: 10px;
    border: 1px solid var(--rule);
    margin: var(--space-3) 0;
    max-width: 100%;
  }
</style>
