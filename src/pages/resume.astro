---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { resume } from "../data/resume";
import { workIndex } from "../data/work-index";

const linkText = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const selected = workIndex.filter((w) => w.page);
const site = "hassan-portfolio-bice.vercel.app";
---

<Base title={`${resume.name}, Resume`} description={resume.summary}>
  <Header showBack />
  <main class="wrap-wide resume">
    <div class="actions no-print">
      <a class="btn" href="/resume.pdf" download><Icon name="download-simple" size={15} />Download PDF</a>
      <span>One column, plain text, built to be read by people and by applicant tracking systems.</span>
    </div>

    <article class="sheet" id="print-target">
      <header class="top">
        <h1><span class="name">{resume.name}</span><span class="title">{resume.title}</span></h1>
        <p class="contact">
          <span>{resume.location}</span>
          <a href={`mailto:${resume.email}`}>{resume.email}</a>
          <span>{resume.phone}</span>
          {resume.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{linkText(l.url)}</a>)}
        </p>
        <p class="summary">{resume.summary}</p>
      </header>

      <div class="body">
        <section class="main" aria-labelledby="exp-h">
          <h2 id="exp-h" class="section-label">Experience</h2>
          <ol class="jobs">
            {resume.experience.map((job) => (
              <li class="job">
                <div class="job-head">
                  <h3><span class="role">{job.role}</span><span class="at">, {job.company}</span></h3>
                  <p class="dates tabular-nums">{job.start} – {job.end}</p>
                </div>
                <ul class="points">
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </li>
            ))}
          </ol>

          <h2 class="section-label">Selected work</h2>
          <ul class="work">
            {selected.map((w) => (
              <li>
                <a href={`https://${site}/work/${w.page}/`}>{w.name}</a>
                <span>{w.tags.join(", ")}. {w.angle}</span>
              </li>
            ))}
          </ul>
          <p class="more print-only">Case studies: {site}</p>
        </section>

        <aside class="side">
          <h2 class="section-label">Skills</h2>
          <ul class="tags">
            {resume.skills["Core competencies"].map((s) => <li>{s}</li>)}
          </ul>

          <h2 class="section-label">Tools</h2>
          <ul class="tags">
            {resume.skills["Tools & systems"].map((s) => <li>{s}</li>)}
          </ul>

          <h2 class="section-label">Education</h2>
          {resume.education.map((e) => (
            <p class="edu"><b>{e.degree}</b><span>{e.school}, {e.location}. Completed {e.end}.</span></p>
          ))}

          <h2 class="section-label">Languages</h2>
          <ul class="langs">
            {resume.languages.map((l) => <li><b>{l.name}</b><span>{l.level}</span></li>)}
          </ul>
        </aside>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .resume {
    padding-top: var(--space-3);
    padding-bottom: var(--space-8);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: var(--space-4);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .sheet {
    padding: clamp(22px, 5vw, 56px);
    border-radius: 22px;
    background: var(--bg-raised);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ink) 7%, transparent),
      0 30px 60px -40px rgb(0 0 0 / 0.35);
  }

  h1 {
    margin: 0;
    display: grid;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .name {
    color: var(--ink);
  }
  .title {
    color: var(--ink-muted);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 18px 0 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
  .contact > *:not(:last-child)::after {
    content: "·";
    margin: 0 10px;
    color: var(--ink-muted);
    display: inline-block;
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .contact {
      flex-direction: column;
      gap: 6px;
    }
    .contact > *:not(:last-child)::after {
      content: none;
    }
  }
  .contact a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
    text-underline-offset: 3px;
  }
  .summary {
    max-width: 68ch;
    margin: 22px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    margin-top: 36px;
  }
  @media (min-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 56px;
    }
  }
  h2.section-label {
    margin: 0 0 14px;
  }
  .side h2.section-label {
    margin-top: 28px;
  }
  .side h2.section-label:first-child {
    margin-top: 0;
  }

  .jobs {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .job {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
  }
  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .at {
    color: var(--ink-muted);
    font-weight: 400;
  }
  .dates {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .points {
    margin: 10px 0 0;
    padding-left: 18px;
    color: var(--ink-secondary);
    line-height: 1.55;
  }
  .points li + li {
    margin-top: 5px;
  }
  .points li::marker {
    color: var(--ink-muted);
  }

  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .work li {
    display: grid;
    gap: 2px;
  }
  .work a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
    text-underline-offset: 3px;
  }
  .work a:hover {
    text-decoration-color: var(--accent-warm);
  }
  .work span {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
  .print-only {
    display: none;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg-sunk);
    font-size: 12.5px;
    color: var(--ink-secondary);
  }
  .edu {
    margin: 0;
    display: grid;
    gap: 2px;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
  .edu b,
  .langs b {
    color: var(--ink);
    font-weight: 500;
  }
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: var(--text-sm);
  }
  .langs li {
    display: flex;
    justify-content: space-between;
    color: var(--ink-secondary);
  }

  /* PDF: one column in reading order, light colours, no page chrome. */
  @media print {
    :global(header.header),
    :global(footer.footer),
    :global(body::after),
    .no-print {
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
      --ink: #161616;
      --ink-secondary: #3d3d3a;
      --ink-muted: #75736c;
      --rule: #e3e1da;
      --bg-sunk: #f1efe9;
      --bg-raised: #fff;
    }
    .resume {
      max-width: none;
      padding: 0;
    }
    .sheet {
      padding: 0;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
    }
    h1 {
      font-size: 26pt;
    }
    .summary {
      font-size: 10.5pt;
      margin-top: 12px;
      padding-top: 12px;
    }
    .body {
      display: block;
      margin-top: 18px;
    }
    .side {
      margin-top: 18px;
    }
    .job {
      padding: 8px 0;
      break-inside: avoid;
    }
    .points {
      margin-top: 5px;
    }
    .points li + li {
      margin-top: 2px;
    }
    .points {
      font-size: 9.5pt;
    }
    h2.section-label {
      break-after: avoid;
    }
    .print-only {
      display: block;
      margin: 8px 0 0;
      font-size: 9pt;
      color: var(--ink-muted);
    }
    .tags {
      display: block;
      font-size: 9.5pt;
      color: var(--ink-secondary);
    }
    .tags li {
      display: inline;
      padding: 0;
      background: none;
      font-size: inherit;
    }
    .tags li:not(:last-child)::after {
      content: ", ";
    }
    .work {
      display: block;
    }
    .work li {
      display: block;
      font-size: 9.5pt;
    }
    .work span {
      display: none;
    }
    .work li {
      display: inline;
    }
    .work li:not(:last-child)::after {
      content: " · ";
      color: var(--ink-muted);
    }
    .work a {
      text-decoration: none;
    }
    .side h2.section-label {
      margin-top: 14px;
    }
    .langs {
      display: block;
    }
    .langs li {
      display: inline;
      font-size: 9.5pt;
    }
    .langs li:not(:last-child)::after {
      content: " · ";
    }
    .langs li span::before {
      content: " ";
    }
    .edu {
      display: block;
      font-size: 9.5pt;
    }
    .edu b::after {
      content: ", ";
    }
    .jobs {
      margin-bottom: 16px;
    }
    .contact {
      font-size: 9pt;
      margin-top: 10px;
    }
    h2.section-label {
      font-size: 10pt;
      margin-bottom: 8px;
    }
    a {
      color: inherit !important;
    }
  }
</style>
