---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resume } from "../data/resume";

const initials = resume.name.split(" ").map((n) => n[0]).join("");
---

<Base title={`${resume.name} — Resume`} description={resume.summary}>
  <Header showBack />
  <main class="wrap resume">
    <div class="paper" id="print-target">
      <header class="r-header">
        <div class="r-mark">{initials}</div>
        <div>
          <h1>{resume.name}</h1>
          <p class="r-title">{resume.title}</p>
        </div>
      </header>
      <p class="r-contact">
        {resume.email} | {resume.phone} | {resume.location}
        {resume.links.map((l) => <> | {l.url.replace(/^https?:\/\//, "")}</>)}
      </p>

      <section class="r-section">
        <h2>Summary</h2>
        <p class="r-summary">{resume.summary}</p>
      </section>

      <section class="r-section">
        <h2>Experience</h2>
        <div class="r-timeline">
          {resume.experience.map((job) => (
            <article class="r-job">
              <div class="r-job-head">
                <span class="r-role">{job.role}, <span class="r-company">{job.company}</span></span>
                <span class="r-dates tabular-nums">{job.start} – {job.end}</span>
              </div>
              <ul>
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="r-section">
        <h2>Skills</h2>
        {Object.entries(resume.skills).map(([group, items]) => (
          <div class="r-skill-group">
            <span class="r-skill-label">{group}</span>
            <div class="r-pills">
              {items.map((item) => <span class="r-pill">{item}</span>)}
            </div>
          </div>
        ))}
      </section>

      <div class="r-two-col">
        <section class="r-section">
          <h2>Education</h2>
          {resume.education.map((e) => (
            <p>{e.degree}, {e.school} — {e.end}, {e.location}</p>
          ))}
        </section>

        <section class="r-section">
          <h2>Languages</h2>
          <p>{resume.languages.map((l) => `${l.name} (${l.level})`).join(" | ")}</p>
        </section>
      </div>
    </div>

    <a class="download no-print" href="/resume.pdf" download>Download PDF</a>
  </main>
  <Footer />
</Base>

<style>
  .resume {
    padding-top: var(--space-2);
    padding-bottom: var(--space-8);
    max-width: 760px;
  }
  .download {
    display: inline-block;
    margin-top: var(--space-6);
    padding: 10px 20px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .download:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .paper {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--ara);
    border-radius: 14px;
    padding: var(--space-6) var(--space-4);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  }

  .r-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }
  .r-mark {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ara) 14%, var(--bg-raised));
    color: var(--ara);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-lg);
  }
  .r-header h1 {
    font-size: var(--text-2xl);
    margin: 0 0 2px;
    color: var(--ink);
  }
  .r-title {
    margin: 0;
    color: var(--ara);
    font-size: var(--text-base);
    font-weight: 500;
  }
  .r-contact {
    margin: var(--space-2) 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  .r-section {
    margin-bottom: var(--space-4);
  }
  .r-section h2 {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ara);
    font-weight: 600;
    margin: 0 0 var(--space-2);
    padding-bottom: 6px;
    border-bottom: 1px solid color-mix(in srgb, var(--ara) 25%, var(--rule));
  }
  .r-summary {
    color: var(--ink-secondary);
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .r-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .r-job {
    position: relative;
    padding-left: var(--space-3);
    border-left: 2px solid var(--rule);
  }
  .r-job::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ara);
  }
  .r-job-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .r-role {
    font-weight: 600;
    color: var(--ink);
  }
  .r-company {
    font-weight: 400;
    color: var(--ink-muted);
  }
  .r-dates {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .r-job ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--ink-secondary);
  }
  .r-job li {
    margin-bottom: 4px;
  }

  .r-skill-group {
    margin-bottom: var(--space-2);
  }
  .r-skill-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .r-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .r-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    background: color-mix(in srgb, var(--ara) 8%, var(--bg-raised));
    border: 1px solid color-mix(in srgb, var(--ara) 18%, var(--rule));
    border-radius: 999px;
    padding: 3px 10px;
  }

  .r-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .r-two-col p {
    color: var(--ink-secondary);
    margin: 0;
  }
  @media (max-width: 560px) {
    .r-two-col {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  /* Print / PDF output: strip all visual styling back to plain,
     single-column, black-on-white text for genuine ATS parseability. */
  @media print {
    :global(header.header),
    :global(footer.footer),
    .no-print {
      display: none !important;
    }
    .resume {
      max-width: none;
      padding: 0;
    }
    .paper {
      background: #fff;
      border: none;
      box-shadow: none;
      padding: 0;
      border-radius: 0;
    }
    .r-mark {
      display: none;
    }
    .r-title,
    .r-job::before,
    .r-section h2 {
      color: #000 !important;
    }
    .r-section h2 {
      border-bottom-color: #000;
    }
    .r-job {
      border-left-color: #ccc;
    }
    .r-job::before {
      background: #000;
    }
    .r-pill {
      background: #fff;
      border-color: #999;
      color: #000;
    }
    body {
      background: #fff;
      color: #000;
    }
  }
</style>
