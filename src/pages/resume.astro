---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resume } from "../data/resume";

const portfolioLinks = resume.links.filter((l) => l.label !== "LinkedIn");
const linkedin = resume.links.find((l) => l.label === "LinkedIn");
---

<Base title={`${resume.name} — Resume`} description={resume.summary}>
  <Header showBack />
  <main class="wrap resume">
    <div class="paper" id="print-target">
      <header class="r-header">
        <h1>{resume.name}</h1>
        <p class="r-role-title">{resume.title}</p>
        <p class="r-tagline">{resume.summary}</p>
      </header>

      <div class="r-contact-band">
        <span class="r-contact-item">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M2 6l10 7 10-7" /></svg>
          {resume.email}
        </span>
        {linkedin && (
          <span class="r-contact-item">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M6.94 5a2 2 0 11-4-.002 2 2 0 014 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.68-2.91V8.48z" /></svg>
            {linkedin.url.replace(/^https?:\/\//, "")}
          </span>
        )}
        <span class="r-contact-item">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
          {resume.location}
        </span>
        <span class="r-contact-item">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg>
          {resume.phone}
        </span>
      </div>

      <div class="r-columns">
        <section class="r-col-left">
          <h2>Work Experience</h2>
          <div class="r-jobs">
            {resume.experience.map((job) => (
              <article class="r-job">
                <p class="r-job-line"><span class="r-company">{job.company}</span> <span class="r-sep">|</span> <span class="r-role">{job.role}</span></p>
                <p class="r-dates tabular-nums">{job.start} – {job.end}</p>
                <p class="r-job-desc">{job.bullets.join(" ")}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="r-col-right">
          <h2>Education</h2>
          {resume.education.map((e) => (
            <>
              <p class="r-edu-degree">{e.degree}</p>
              <p class="r-edu-school">at {e.school}</p>
              <p class="r-edu-meta">Completed: {e.end} | {e.location}</p>
            </>
          ))}

          <h2>Portfolio</h2>
          <div class="r-links">
            {portfolioLinks.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
            ))}
          </div>

          <h2>Core Competencies</h2>
          <p class="r-inline-list">{resume.skills["Core competencies"].join(", ")}.</p>

          <h2>Tools &amp; Systems</h2>
          <p class="r-inline-list">{resume.skills["Tools & systems"].join(" | ")}</p>

          <h2>Languages</h2>
          <div class="r-languages">
            {resume.languages.map((l) => <p>{l.name} – {l.level}</p>)}
          </div>
        </section>
      </div>
    </div>

    <a class="download no-print" href="/resume.pdf" download>Download PDF</a>
  </main>
  <Footer />
</Base>

<style>
  .resume {
    padding-top: var(--space-2);
    padding-bottom: var(--space-8);
    max-width: 900px;
  }
  .download {
    display: inline-block;
    margin-top: var(--space-6);
    padding: 10px 20px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }
  .download:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .paper {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-family: var(--font-serif-body);
  }

  /* ---- Header ---- */
  .r-header {
    text-align: center;
    padding: var(--space-6) var(--space-4) var(--space-3);
  }
  .r-header h1 {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(2rem, 5vw, 2.75rem);
    color: var(--resume-accent);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .r-role-title {
    font-family: var(--font-serif-body);
    font-size: var(--text-xl);
    color: var(--ink);
    margin: 0 0 10px;
  }
  .r-tagline {
    font-family: var(--font-serif-body);
    font-size: var(--text-base);
    color: var(--ink-secondary);
    max-width: 62ch;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ---- Contact band ---- */
  .r-contact-band {
    background: color-mix(in srgb, var(--resume-accent) 6%, var(--bg-raised));
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
  }
  .r-contact-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-serif-body);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    white-space: nowrap;
  }
  .r-contact-item svg {
    flex-shrink: 0;
    color: var(--resume-accent);
  }

  /* ---- Two-column body ---- */
  .r-columns {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 0 var(--space-5);
    padding: var(--space-4);
  }
  .r-col-right {
    border-left: 1px dashed var(--rule-strong, var(--rule));
    padding-left: var(--space-5);
  }
  .r-columns h2 {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ink);
    margin: var(--space-4) 0 var(--space-2);
  }
  .r-col-left > h2:first-child,
  .r-col-right > h2:first-child {
    margin-top: 0;
  }

  .r-jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .r-job-line {
    margin: 0;
    font-size: var(--text-base);
    color: var(--ink);
  }
  .r-company {
    font-weight: 600;
  }
  .r-sep {
    color: var(--ink-muted);
  }
  .r-role {
    color: var(--ink);
  }
  .r-dates {
    margin: 2px 0 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .r-job-desc {
    margin: 0;
    color: var(--ink-secondary);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .r-edu-degree {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
    font-size: var(--text-base);
  }
  .r-edu-school {
    margin: 2px 0 0;
    color: var(--ink);
  }
  .r-edu-meta {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .r-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .r-links a {
    color: var(--resume-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--resume-accent) 30%, transparent);
    font-size: var(--text-sm);
  }

  .r-inline-list {
    margin: 0;
    color: var(--ink-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .r-languages p {
    margin: 0 0 2px;
    color: var(--ink-secondary);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .r-columns {
      grid-template-columns: 1fr;
    }
    .r-col-right {
      border-left: none;
      padding-left: 0;
      border-top: 1px dashed var(--rule-strong, var(--rule));
      padding-top: var(--space-3);
      margin-top: var(--space-2);
    }
  }

  /* Print / PDF: same typography and color carry through. Only the
     two-column body flattens to one column, since a genuine multi-column
     layout is the one pattern ATS parsers reliably get reading-order
     wrong on — everything else here is just color/type, safe to keep. */
  @media print {
    :global(header.header),
    :global(footer.footer),
    .no-print {
      display: none !important;
    }
    .resume {
      max-width: none;
      padding: 0;
    }
    .paper {
      border: none;
    }
    .r-columns {
      display: block;
      padding: var(--space-3) 0 0;
    }
    .r-col-right {
      border-left: none;
      padding-left: 0;
      border-top: 1px dashed var(--rule);
      padding-top: var(--space-2);
      margin-top: var(--space-2);
    }
    .r-header {
      padding: 0 0 var(--space-2);
    }
    .r-jobs {
      gap: var(--space-2);
    }
    .r-job {
      break-inside: avoid;
    }
    .r-columns h2 {
      margin: var(--space-2) 0 6px;
      break-after: avoid;
    }
    .r-col-left > h2:first-child,
    .r-col-right > h2:first-child {
      margin-top: 0;
    }
  }
</style>
