---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resume } from "../data/resume";

const initials = resume.name.split(" ").map((n) => n[0]).join("");
---

<Base title={`${resume.name} — Resume`} description={resume.summary}>
  <Header showBack />
  <main class="wrap resume">
    <div class="paper" id="print-target">
      <header class="r-header">
        <div class="r-mark">{initials}</div>
        <div class="r-header-text">
          <h1>{resume.name}</h1>
          <span class="r-title-tag">{resume.title}</span>
        </div>
      </header>

      <div class="r-contact-row">
        <span class="r-chip">{resume.email}</span>
        <span class="r-chip">{resume.phone}</span>
        <span class="r-chip">{resume.location}</span>
        {resume.links.map((l) => (
          <span class="r-chip">{l.url.replace(/^https?:\/\//, "")}</span>
        ))}
      </div>

      <section class="r-card">
        <h2><span class="r-dot"></span>Summary</h2>
        <p class="r-summary">{resume.summary}</p>
      </section>

      <section class="r-section">
        <h2><span class="r-dot"></span>Experience</h2>
        <div class="r-jobs">
          {resume.experience.map((job, i) => (
            <article class={`r-job-card${i === 0 ? " r-job-current" : ""}`}>
              <div class="r-job-head">
                <div>
                  <p class="r-role">{job.role}</p>
                  <p class="r-company">{job.company}</p>
                </div>
                <span class="r-date-pill tabular-nums">{job.start} – {job.end}</span>
              </div>
              <ul>
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="r-card">
        <h2><span class="r-dot"></span>Skills</h2>
        {Object.entries(resume.skills).map(([group, items]) => (
          <div class="r-skill-group">
            <span class="r-skill-label">{group}</span>
            <div class="r-pills">
              {items.map((item) => <span class="r-pill">{item}</span>)}
            </div>
          </div>
        ))}
      </section>

      <div class="r-two-col">
        <section class="r-card r-card-sm">
          <h2><span class="r-dot"></span>Education</h2>
          {resume.education.map((e) => (
            <p class="r-plain">{e.degree}, {e.school} — {e.end}, {e.location}</p>
          ))}
        </section>

        <section class="r-card r-card-sm">
          <h2><span class="r-dot"></span>Languages</h2>
          <p class="r-plain">{resume.languages.map((l) => `${l.name} (${l.level})`).join(" | ")}</p>
        </section>
      </div>
    </div>

    <a class="download no-print" href="/resume.pdf" download>Download PDF</a>
  </main>
  <Footer />
</Base>

<style>
  .resume {
    padding-top: var(--space-2);
    padding-bottom: var(--space-8);
    max-width: 760px;
  }
  .download {
    display: inline-block;
    margin-top: var(--space-6);
    padding: 10px 20px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .download:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .paper {
    background: color-mix(in srgb, var(--ara) 4%, var(--bg));
    border: 1px solid var(--rule);
    border-radius: 24px;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ---- Header ---- */
  .r-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 4px var(--space-2);
  }
  .r-mark {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 22px;
    background: linear-gradient(135deg, var(--ara), color-mix(in srgb, var(--ara) 60%, var(--medexa)));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-xl);
    box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--ara) 55%, transparent);
  }
  .r-header-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .r-header h1 {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--ink);
    line-height: 1.15;
  }
  .r-title-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ara);
    background: color-mix(in srgb, var(--ara) 12%, var(--bg-raised));
    border-radius: 999px;
    padding: 4px 12px;
  }

  /* ---- Contact chips ---- */
  .r-contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 var(--space-2);
  }
  .r-chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 6px 12px;
  }

  /* ---- Cards ---- */
  .r-card,
  .r-job-card {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 18px;
    padding: var(--space-3) var(--space-3);
  }
  .r-card-sm {
    padding: var(--space-2) var(--space-3);
  }
  .r-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .r-section > h2 {
    padding: 0 var(--space-2);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 var(--space-2);
  }
  .r-card > h2 {
    margin-bottom: var(--space-2);
  }
  .r-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ara);
    flex-shrink: 0;
  }
  .r-summary {
    color: var(--ink-secondary);
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.65;
  }
  .r-plain {
    color: var(--ink-secondary);
    margin: 0;
  }

  /* ---- Job cards ---- */
  .r-jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .r-job-current {
    border-color: color-mix(in srgb, var(--ara) 30%, var(--rule));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ara) 12%, transparent) inset;
  }
  .r-job-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .r-role {
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    font-size: var(--text-base);
  }
  .r-company {
    font-weight: 400;
    color: var(--ink-muted);
    margin: 2px 0 0;
    font-size: var(--text-sm);
  }
  .r-date-pill {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ara);
    background: color-mix(in srgb, var(--ara) 10%, var(--bg-raised));
    border-radius: 999px;
    padding: 5px 12px;
    white-space: nowrap;
  }
  .r-job-card ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--ink-secondary);
  }
  .r-job-card li {
    margin-bottom: 5px;
    line-height: 1.55;
  }

  /* ---- Skills ---- */
  .r-skill-group {
    margin-bottom: var(--space-2);
  }
  .r-skill-group:last-child {
    margin-bottom: 0;
  }
  .r-skill-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .r-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .r-pill {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ara);
    background: color-mix(in srgb, var(--ara) 10%, var(--bg-raised));
    border-radius: 999px;
    padding: 5px 12px;
  }

  .r-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  @media (max-width: 560px) {
    .r-two-col {
      grid-template-columns: 1fr;
    }
    .r-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Print / PDF output: same card/pill design carries through — none of it
     touches text extraction. Only the two-column Education/Languages grid
     flattens for print, since a genuine multi-column layout is the one
     pattern ATS parsers reliably get reading-order wrong on. */
  @media print {
    :global(header.header),
    :global(footer.footer),
    .no-print {
      display: none !important;
    }
    .resume {
      max-width: none;
      padding: 0;
    }
    .paper {
      border-radius: 0;
    }
    .r-two-col {
      display: block;
    }
    .r-two-col .r-card-sm {
      margin-bottom: var(--space-2);
    }
  }
</style>
