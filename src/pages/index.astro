---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TwoToneHeading from "../components/TwoToneHeading.astro";
import CaseThumb from "../components/CaseThumb.astro";
import Icon from "../components/Icon.astro";
import { beliefs, workIndex } from "../data/work-index";
import { resume } from "../data/resume";

const nameOf = (id: string) => workIndex.find((w) => w.id === id)?.name ?? id;
const featured = workIndex.filter((w) => w.page);
// The hero shows the work: three products, as they look in use.
const stage = [
  { id: "hh-global", name: "HH Global", what: "Wholesale e-commerce", src: "/media/hh/home.webp", cls: "w-left" },
  { id: "clicker", name: "Clicker", what: "ERP, my own product", src: "/media/clicker/w-aging-light.webp", cls: "w-mid" },
  { id: "istyme", name: "isTyme", what: "Local marketplace", src: "/media/istyme/en-offers.webp", cls: "w-right", phone: true },
];
const rest = workIndex.filter((w) => !featured.includes(w));
const ways = [
  { icon: "user", title: "Start with the person", body: "And the rules they live under, before any screen." },
  { icon: "list-checks", title: "Map what nobody asked for", body: "Empty, error, partial failure and the edge cases." },
  { icon: "steering-wheel", title: "Direct the agents", body: "They draft at speed. I decide what's right." },
  { icon: "rocket-launch", title: "Ship in small steps", body: "Reversible changes, and a seat in the architecture conversation." },
  { icon: "signature", title: "Own what ships", body: "Including what goes wrong afterwards." },
];
const earlier = [
  ["Inventory Management Tool", "/work/inventory-management/"],
  ["Online Exam Preparation Platform", "/work/online-exam-prep/"],
  ["Landlord Mobile App", "/work/landlord-app/"],
  ["Meal Purchase E-Wallet", "/work/meal-wallet/"],
  ["Cookiya", "/work/cookiya/"],
  ["Motion starter kit", "/work/motions/"],
];
---

<Base
  title="Muhammad Hassan Khan — Senior Product Designer"
  description="Less noise. Real products. Owned end to end. Senior product designer in Karachi working on healthcare compliance, AI copilots, dense business software and local marketplaces."
>
  <Header />

  <section class="hero">
    <div class="frame wrap-wide">
      <div class="top">
        <TwoToneHeading as="h1" size="hero" lead="Less noise." rest="Real products, owned end to end." />
        <div class="intro">
          <p>
            I'm Hassan, a senior product designer in Karachi. Healthcare compliance, AI copilots, dense business
            software and local marketplaces: I decide what's right for the people using them, ship it, and own
            what happens next.
          </p>
          <div class="cta">
            <a class="btn" href="#work">See the work <Icon name="arrow-right" size={16} /></a>
            <a class="btn ghost" href="/resume/">Resume</a>
          </div>
        </div>
      </div>

      <span class="rule" aria-hidden="true"></span>

      <figure class="stage" aria-label="Three of the products">
        {stage.map((w) => (
          <a class={`win ${w.cls}`} href={`/work/${w.id}/`} aria-label={`${w.name}, ${w.what}`}>
            <span class="chip"><b>{w.name}</b>{w.what}</span>
            <span class:list={["screen", { phone: w.phone }]}>
              {!w.phone && <span class="bar" aria-hidden="true"><i></i><i></i><i></i></span>}
              <img src={w.src} alt="" loading="eager" decoding="async" />
            </span>
          </a>
        ))}
      </figure>

      <span class="rule" aria-hidden="true"></span>

      <ol class="facts">
        <li><span>01 — Now</span><p><b>Senior Product Designer</b> at AST since June 2026, on healthcare compliance and AI agents.</p></li>
        <li><span>02 — Experience</span><p><b>5+ years</b> in SaaS and mobile, research to production, for teams in the US, the GCC and Pakistan.</p></li>
        <li><span>03 — On this site</span><p><b>8 products,</b> 5 of them under NDA and re-created with stand-in names and data.</p></li>
      </ol>

      <span class="rule" aria-hidden="true"></span>
    </div>
  </section>

  <main>
    <section class="wrap-wide band" aria-labelledby="beliefs-h">
      <div class="band-head">
        <h2 id="beliefs-h" class="band-title">Four things I don't trade away.</h2>
      </div>
      <ol class="beliefs">
        {beliefs.map((b, i) => (
          <li class="reveal" style={`--i:${i}`} data-belief>
            <span class="b-top">
              <span class="b-num tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <span class="b-art"><Icon name={b.icon} weight="duotone" size={26} /></span>
            </span>
            <p class="belief">{b.text}</p>
            <p class="note">{b.note}</p>
            <p class="proof-links"><span>Seen in</span>
              {b.proof.map((id) => <a href={`#work-${id}`}>{nameOf(id)}</a>)}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap-wide band" id="work" aria-labelledby="work-h">
      <div class="band-head">
        <h2 id="work-h" class="band-title">Eight products, one way of working.</h2>
      </div>
      <div class="cards">
        {featured.map((w, i) => (
          <a class="card reveal" href={`/work/${w.page}/`} id={`work-${w.id}`}>
            <CaseThumb kind={w.id} />
            <span class="card-top">
              <span class="card-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="card-tags">{w.tags.join(" · ")}</span>
            </span>
            <span class="card-name" style={`view-transition-name: t-${w.page}`}>{w.name}</span>
            <span class="card-angle">{w.angle}</span>
            <span class="card-link">Read the case study <Icon name="arrow-up-right" size={15} /></span>
          </a>
        ))}
      </div>
      <ol class="rows" start={featured.length + 1}>
        {rest.map((w, i) => (
          <li class="reveal" id={`work-${w.id}`}>
            <span class="row-num">{String(featured.length + i + 1).padStart(2, "0")}</span>
            <span class="row-name">{w.name}</span>
            <span class="row-leader" aria-hidden="true"></span>
            <span class="row-tags">{w.tags.join(" · ")}</span>
            {w.page ? (
              <a class="row-status link" href={`/work/${w.page}/`}>Read <Icon name="arrow-up-right" size={14} /></a>
            ) : (
              <span class="row-status">Coming soon</span>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap-wide band split" aria-labelledby="how-h">
      <div class="band-head">
        <h2 id="how-h" class="band-title">The same five moves, every time.</h2>
        <p class="tools">Tools change. Right now: Figma, Claude Code, Framer, Webflow and GitHub.</p>
      </div>
      <ol class="ways">
        {ways.map((w, i) => (
          <li class="reveal">
            <span class="way-num">{i + 1}</span>
            <span class="way-text"><b>{w.title}</b><span>{w.body}</span></span>
            <Icon name={w.icon} size={20} />
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap-wide band split" aria-labelledby="exp-h">
      <div class="band-head">
        <h2 id="exp-h" class="band-title">Where I've worked.</h2>
      </div>
      <ul class="jobs">
        {resume.experience.map((job) => (
          <li class="reveal">
            <span class="job-role">{job.role}</span>
            <span class="job-co">{job.company}</span>
            <span class="job-dates tabular-nums">{job.start} – {job.end}</span>
          </li>
        ))}
        <li class="earlier">
          <span>Earlier projects</span>
          <span class="earlier-links">
            {earlier.map(([label, href]) => <a href={href}>{label}</a>)}
          </span>
        </li>
      </ul>
    </section>

    <section class="wrap-wide band" id="contact" aria-labelledby="contact-h">
      <div class="contact">
        <TwoToneHeading as="h2" size="3xl" lead="Have a product that needs an owner?" rest="Let's talk." />
        <div class="cta">
          <a class="btn" href="mailto:hassank.uiux@gmail.com"><Icon name="envelope-simple" size={16} /> hassank.uiux@gmail.com</a>
          <a class="btn ghost" href="#message" data-open-chat><Icon name="chat-circle-text" size={16} /> Send a message</a>
          <a class="btn ghost" href="/resume/"><Icon name="read-cv-logo" size={16} /> Resume</a>
          <a class="btn ghost" href="https://www.linkedin.com/in/muhammad-hassan-khan-ui-ux-designer/" target="_blank" rel="noopener noreferrer"><Icon name="linkedin-logo" size={16} /> LinkedIn</a>
          <a class="btn ghost" href="https://github.com/abuMuhammad101" target="_blank" rel="noopener noreferrer"><Icon name="github-logo" size={16} /> GitHub</a>
          <a class="btn ghost" href="https://layers.to/hassankuiux" target="_blank" rel="noopener noreferrer">layers.to <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Hero ------------------------------------------------------------------
     A ruled frame, like a page in a design file: two rails down the sides,
     hairlines across, a + where they meet. Title and intro side by side,
     then the work itself, then three facts. */
  .hero {
    overflow: clip;
  }
  .frame {
    position: relative;
    --rail: 32px;
  }
  .frame::before,
  .frame::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--rule);
  }
  .frame::before {
    left: calc(var(--space-3) - var(--rail));
  }
  .frame::after {
    right: calc(var(--space-3) - var(--rail));
  }
  .rule {
    position: relative;
    display: block;
    height: 1px;
    margin: 0 -100vw;
    background: var(--rule);
  }
  /* The + marks where a hairline crosses a rail. */
  .rule::before,
  .rule::after {
    content: "";
    position: absolute;
    top: -5px;
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--ink-muted), var(--ink-muted)) center / 11px 1px no-repeat,
      linear-gradient(var(--ink-muted), var(--ink-muted)) center / 1px 11px no-repeat;
  }
  .rule::before {
    left: calc(100vw - var(--rail) - 5px);
  }
  .rule::after {
    right: calc(100vw - var(--rail) - 5px);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 32px 64px;
    align-items: end;
    padding: clamp(48px, 7vw, 96px) 0 clamp(36px, 4vw, 48px);
  }
  .top :global(h1) {
    font-size: clamp(2.5rem, 4.8vw, 3.9rem);
    line-height: 1.04;
  }
  .intro p {
    max-width: 46ch;
    margin: 0 0 24px;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--ink-secondary);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* The work, on a dotted board. */
  .stage {
    position: relative;
    height: clamp(300px, 36vw, 440px);
    margin: 0 calc(-1 * var(--rail) + 0px);
    overflow: hidden;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--ink) 13%, transparent) 1px, transparent 1.3px);
    background-size: 14px 14px;
    background-position: 7px 7px;
  }
  .stage::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 56px;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .win {
    position: absolute;
    display: grid;
    gap: 10px;
    justify-items: start;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s;
  }
  .stage:hover .win:not(:hover) {
    opacity: 0.55;
  }
  .win:hover {
    transform: translateY(-6px);
  }
  .w-left {
    left: 4%;
    top: 22%;
    width: 40%;
  }
  .w-mid {
    left: 25%;
    top: 12%;
    width: 52%;
    z-index: 2;
  }
  .w-right {
    right: 5%;
    top: 17%;
    width: 15%;
    z-index: 3;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--bg-raised);
    box-shadow: var(--lift-1);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .chip b {
    font-weight: 500;
    color: var(--ink);
  }
  .screen {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 10px;
    background: #fff;
    box-shadow: var(--lift-3);
  }
  .screen .bar {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    background: #f3f2ef;
    border-bottom: 1px solid #e7e5df;
  }
  .screen .bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d6d3cb;
  }
  .screen img {
    display: block;
    width: 100%;
    height: auto;
  }
  .screen.phone {
    border-radius: 22px;
    padding: 5px;
    background: #1c1c1e;
  }
  .screen.phone img {
    border-radius: 17px;
  }

  /* Three facts, read like a numbered list. */
  .facts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 48px;
    margin: 0;
    padding: 28px 0 32px;
  }
  .facts span {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .facts p {
    margin: 0;
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }
  .facts b {
    font-weight: 500;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .facts {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 760px) {
    .frame::before,
    .frame::after,
    .rule::before,
    .rule::after {
      display: none;
    }
    .stage {
      height: 280px;
      margin: 0 calc(-1 * var(--space-3));
    }
    .w-left {
      display: none;
    }
    .w-mid {
      left: 5%;
      width: 84%;
      top: 10%;
    }
    .w-right {
      right: 4%;
      width: 32%;
      top: 26%;
    }
    .chip {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .win {
      transition: none;
    }
  }

  .band {
    padding-top: var(--space-12);
  }
  .band-head {
    margin-bottom: var(--space-4);
  }
  .band-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  @media (min-width: 900px) {
    .split {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-8);
      align-items: start;
    }
    .split .band-head {
      position: sticky;
      top: 96px;
    }
  }

  .beliefs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px;
  }
  .beliefs li {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 22px 22px 20px;
    border-radius: 22px;
    background:
      radial-gradient(120% 70% at 100% 0%, color-mix(in srgb, var(--accent-warm) 7%, transparent), transparent 60%),
      var(--bg-raised);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 6%, transparent), 0 1px 2px rgb(0 0 0 / 0.04);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s;
  }
  .beliefs li:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 9%, transparent), 0 24px 44px -28px rgb(0 0 0 / 0.35);
  }
  .b-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: auto;
  }
  .b-num {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--ink-muted);
  }
  .b-art {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    color: var(--ink);
    background: linear-gradient(160deg, var(--bg-raised), var(--bg-sunk));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent),
      0 8px 18px -12px rgb(0 0 0 / 0.35);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s;
  }
  .beliefs li:hover .b-art {
    transform: rotate(-6deg) scale(1.04);
    color: var(--accent-warm);
  }
  .belief {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 28px 0 8px;
  }
  .note {
    margin: 0 0 18px;
    color: var(--ink-secondary);
    font-size: var(--text-sm);
  }
  .proof-links {
    margin: 0;
    padding-top: 14px;
    border-top: 1px dashed color-mix(in srgb, var(--ink) 14%, transparent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 12.5px;
  }
  .proof-links span {
    color: var(--ink-muted);
    width: 100%;
    font-size: 11.5px;
  }
  .proof-links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
    text-underline-offset: 3px;
  }
  .proof-links a:hover {
    text-decoration-color: var(--accent-warm);
  }
  /* Phone: the beliefs stack like a deck. Each card sticks below the
     header, and the next one slides up over it. */
  @media (max-width: 700px) {
    .beliefs {
      display: block;
    }
    .beliefs li {
      position: sticky;
      top: calc(92px + var(--i) * 10px);
      min-height: 280px;
      margin-bottom: 18px;
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--ink) 7%, transparent),
        0 -10px 30px -18px rgb(0 0 0 / 0.28);
      transform-origin: 50% 0;
    }
    .beliefs li:last-child {
      margin-bottom: 0;
    }
    /* The card underneath fades toward the page, but stays solid, so the
       deck never shows through itself. */
    .beliefs li::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--bg);
      opacity: calc(var(--dim, 0) * 0.6);
      pointer-events: none;
    }
    .beliefs li:hover {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beliefs li, .beliefs li:hover { transition: none; transform: none; }
    .beliefs li:hover .b-art { transform: none; }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 44px 32px;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 0;
    text-decoration: none;
    color: var(--ink);
    scroll-margin-top: 96px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover {
    transform: none;
  }
  .card > span {
    padding: 0 2px;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .card-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    margin-top: 6px;
  }
  .card-angle {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    margin: 6px 0 var(--space-2);
  }
  .card-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .rows {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .rows li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 96px;
  }
  .row-num {
    font-size: 12px;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .row-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .row-leader {
    flex: 1;
    min-width: 16px;
    border-bottom: 1px dotted var(--ink-muted);
    opacity: 0.6;
    transform: translateY(-4px);
  }
  .row-tags {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .row-status {
    font-size: 12px;
    color: var(--ink-secondary);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 2px 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    white-space: nowrap;
  }
  .row-status.link {
    color: var(--ink);
    border-color: var(--ink);
  }
  @media (max-width: 620px) {
    .rows li {
      flex-wrap: wrap;
      row-gap: 4px;
    }
    .row-leader {
      display: none;
    }
    .row-name {
      flex: 1;
    }
    .row-tags {
      order: 5;
      flex-basis: 100%;
      padding-left: 30px;
    }
  }

  .tools {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
