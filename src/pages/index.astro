---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TwoToneHeading from "../components/TwoToneHeading.astro";
import ConstructionLines from "../components/ConstructionLines.astro";
import CaseThumb from "../components/CaseThumb.astro";
import Icon from "../components/Icon.astro";
import { beliefs, workIndex } from "../data/work-index";
import { resume } from "../data/resume";

const nameOf = (id: string) => workIndex.find((w) => w.id === id)?.name ?? id;
const featured = workIndex.filter((w) => w.page && w.id !== "hh-global");
const rest = workIndex.filter((w) => !featured.includes(w));
const markets = [
  { name: "United States", tz: "America/New_York", off: -5 },
  { name: "GCC", tz: "Asia/Dubai", off: 4 },
  { name: "Pakistan", tz: "Asia/Karachi", off: 5, home: true },
];
const ways = [
  { icon: "user", title: "Start with the person", body: "And the rules they live under, before any screen." },
  { icon: "list-checks", title: "Map what nobody asked for", body: "Empty, error, partial failure and the edge cases." },
  { icon: "steering-wheel", title: "Direct the agents", body: "They draft at speed. I decide what's right." },
  { icon: "rocket-launch", title: "Ship in small steps", body: "Reversible changes, and a seat in the architecture conversation." },
  { icon: "signature", title: "Own what ships", body: "Including what goes wrong afterwards." },
];
const earlier = [
  ["Inventory Management Tool", "/work/inventory-management/"],
  ["Online Exam Preparation Platform", "/work/online-exam-prep/"],
  ["Landlord Mobile App", "/work/landlord-app/"],
  ["Meal Purchase E-Wallet", "/work/meal-wallet/"],
  ["Cookiya", "/work/cookiya/"],
  ["Motion starter kit", "/work/motions/"],
];
---

<Base
  title="Muhammad Hassan Khan — Senior Product Designer"
  description="Less noise. Real products. Owned end to end. Senior product designer in Karachi working on healthcare compliance, AI copilots, dense business software and local marketplaces."
>
  <Header />

  <section class="hero">
    <div class="hero-inner wrap-wide">
      <div class="headline">
        <ConstructionLines />
        <TwoToneHeading as="h1" size="hero" lead="Less noise." rest="Real products. Owned end to end." />
      </div>
      <div class="hero-grid">
        <div class="intro">
          <p>
            I'm Hassan, a senior product designer in Karachi. Healthcare compliance, AI copilots, dense business
            software and local marketplaces: I decide what's right for the people using them, ship it, and own
            what happens next.
          </p>
          <div class="cta">
            <a class="btn" href="#work">See the work <Icon name="arrow-right" size={16} /></a>
            <a class="btn ghost" href="/resume/">Resume</a>
          </div>
        </div>
        <aside class="ledger" aria-label="At a glance">
          <p class="ledger-line"><b>8</b> products <i aria-hidden="true"></i> <b>5+</b> years in SaaS and mobile</p>
          <div class="zones" data-zones>
            {markets.map((m) => (
              <div class={`zone ${m.home ? "home" : ""}`} data-tz={m.tz} data-off={m.off}>
                <span class="z-name">{m.name}{m.home && <em>Based here</em>}</span>
                <span class="z-bar" aria-hidden="true">{Array.from({ length: 24 }).map(() => <i></i>)}</span>
                <time class="z-time tabular-nums">--:--</time>
              </div>
            ))}
            <span class="z-now" aria-hidden="true"></span>
          </div>
          <p class="z-key"><i aria-hidden="true"></i> Working hours, 9 to 6 local. The line is now.</p>
        </aside>
      </div>
    </div>
  </section>

  <main>
    <section class="wrap-wide band" aria-labelledby="beliefs-h">
      <div class="band-head">
        <p class="section-label">What I believe</p>
        <h2 id="beliefs-h" class="band-title">Four things I don't trade away.</h2>
      </div>
      <ol class="beliefs">
        {beliefs.map((b, i) => (
          <li class="reveal">
            <span class="b-top">
              <span class="b-num tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <svg class="b-art" viewBox="0 0 72 72" aria-hidden="true">
                {i === 0 && (<g><path class="soft" d="M6 50c10-18 20 8 30-10s20 6 30-12" /><circle cx="36" cy="36" r="14" /><circle cx="36" cy="36" r="3.5" class="fill" /><path d="M36 14v8M36 50v8M14 36h8M50 36h8" /></g>)}
                {i === 1 && (<g><path class="soft" d="M14 20h18M14 36h18M14 52h18" /><circle cx="12" cy="20" r="3" /><circle cx="12" cy="36" r="3" /><circle cx="12" cy="52" r="3" /><path d="M32 20c10 0 10 16 22 16M32 52c10 0 10-16 22-16M32 36h22" /><circle cx="58" cy="36" r="6" class="fill" /></g>)}
                {i === 2 && (<g>{[[10,14],[22,22],[16,34],[30,12],[28,40],[40,26],[12,52],[36,54]].map(([x,y]) => <circle cx={x} cy={y} r="2" class="soft-dot" />)}<path d="M38 38c6-6 12-6 18-14" /><path d="M50 22l6 2-2 6" /></g>)}
                {i === 3 && (<g><path d="M10 44c6-14 10-20 12-12s-6 16 2 10 8-14 12-6 4 8 10 2" /><path class="soft" d="M8 56h56" /><circle cx="62" cy="56" r="3" class="fill" /></g>)}
              </svg>
            </span>
            <p class="belief">{b.text}</p>
            <p class="note">{b.note}</p>
            <p class="proof-links"><span>Seen in</span>
              {b.proof.map((id) => <a href={`#work-${id}`}>{nameOf(id)}</a>)}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap-wide band" id="work" aria-labelledby="work-h">
      <div class="band-head">
        <p class="section-label">Selected work</p>
        <h2 id="work-h" class="band-title">Eight products, one way of working.</h2>
      </div>
      <div class="cards">
        {featured.map((w, i) => (
          <a class="card reveal" href={`/work/${w.page}/`} id={`work-${w.id}`}>
            <CaseThumb kind={w.id} />
            <span class="card-top">
              <span class="card-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="card-tags">{w.tags.join(" · ")}</span>
            </span>
            <span class="card-name">{w.name}</span>
            <span class="card-angle">{w.angle}</span>
            <span class="card-link">Read the case study <Icon name="arrow-up-right" size={15} /></span>
          </a>
        ))}
      </div>
      <ol class="rows" start={featured.length + 1}>
        {rest.map((w, i) => (
          <li class="reveal" id={`work-${w.id}`}>
            <span class="row-num">{String(featured.length + i + 1).padStart(2, "0")}</span>
            <span class="row-name">{w.name}</span>
            <span class="row-leader" aria-hidden="true"></span>
            <span class="row-tags">{w.tags.join(" · ")}</span>
            {w.page ? (
              <a class="row-status link" href={`/work/${w.page}/`}>Read <Icon name="arrow-up-right" size={14} /></a>
            ) : (
              <span class="row-status">Coming soon</span>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap-wide band split" aria-labelledby="how-h">
      <div class="band-head">
        <p class="section-label">How I work</p>
        <h2 id="how-h" class="band-title">The same five moves, every time.</h2>
        <p class="tools">Tools change. Right now: Figma, Claude Code, Framer, Webflow and GitHub.</p>
      </div>
      <ol class="ways">
        {ways.map((w, i) => (
          <li class="reveal">
            <span class="way-num">{i + 1}</span>
            <span class="way-text"><b>{w.title}</b><span>{w.body}</span></span>
            <Icon name={w.icon} size={20} />
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap-wide band split" aria-labelledby="exp-h">
      <div class="band-head">
        <p class="section-label">Experience</p>
        <h2 id="exp-h" class="band-title">Where I've worked.</h2>
      </div>
      <ul class="jobs">
        {resume.experience.map((job) => (
          <li class="reveal">
            <span class="job-role">{job.role}</span>
            <span class="job-co">{job.company}</span>
            <span class="job-dates tabular-nums">{job.start} – {job.end}</span>
          </li>
        ))}
        <li class="earlier">
          <span>Earlier projects</span>
          <span class="earlier-links">
            {earlier.map(([label, href]) => <a href={href}>{label}</a>)}
          </span>
        </li>
      </ul>
    </section>

    <section class="wrap-wide band" id="contact" aria-labelledby="contact-h">
      <div class="contact">
        <p class="section-label">Contact</p>
        <TwoToneHeading as="h2" size="3xl" lead="Have a product that needs an owner?" rest="Let's talk." />
        <div class="cta">
          <a class="btn" href="mailto:hassank.uiux@gmail.com"><Icon name="envelope-simple" size={16} /> hassank.uiux@gmail.com</a>
          <a class="btn ghost" href="/resume/"><Icon name="read-cv-logo" size={16} /> Resume</a>
          <a class="btn ghost" href="https://linkedin.com/in/muhammad-hassan-khan" target="_blank" rel="noopener noreferrer"><Icon name="linkedin-logo" size={16} /> LinkedIn</a>
          <a class="btn ghost" href="https://github.com/abuMuhammad101" target="_blank" rel="noopener noreferrer"><Icon name="github-logo" size={16} /> GitHub</a>
          <a class="btn ghost" href="https://layers.to/hassankuiux" target="_blank" rel="noopener noreferrer">layers.to <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
<script>
  // Each bar is the same 24 hours in UTC; filled cells are 9:00-18:00 local.
  const offsetOf = (tz: string) => {
    const d = new Date();
    const local = new Date(d.toLocaleString("en-US", { timeZone: tz }));
    const utc = new Date(d.toLocaleString("en-US", { timeZone: "UTC" }));
    return Math.round((local.getTime() - utc.getTime()) / 3600000);
  };
  const draw = () => {
    const now = new Date();
    document.querySelectorAll<HTMLElement>("[data-zones] .zone").forEach((z) => {
      const tz = z.dataset.tz!;
      const off = offsetOf(tz);
      z.querySelectorAll("i").forEach((cell, h) => {
        const local = (((h + off) % 24) + 24) % 24;
        cell.classList.toggle("on", local >= 9 && local < 18);
      });
      z.querySelector("time")!.textContent = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: tz }).format(now);
    });
    const zones = document.querySelector<HTMLElement>("[data-zones]");
    if (zones) zones.style.setProperty("--now", `${((now.getUTCHours() + now.getUTCMinutes() / 60) / 24) * 100}%`);
  };
  draw();
  setInterval(draw, 30000);
</script>
</Base>

<style>
  .hero {
    overflow: clip;
  }
  .hero-inner {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }
  .headline {
    position: relative;
    padding: var(--space-6) 0 var(--space-6);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }
  .intro p {
    font-size: var(--text-lg);
    color: var(--ink-secondary);
    margin: 0 0 var(--space-3);
    max-width: 52ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ledger {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .ledger-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    color: var(--ink-secondary);
    font-size: var(--text-sm);
  }
  .ledger-line b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .ledger-line i {
    width: 4px;
    height: 4px;
    margin: 0 8px;
    border-radius: 50%;
    background: var(--ink-muted);
    align-self: center;
  }
  .zones {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 16px 0 4px;
    border-top: 1px solid var(--rule);
  }
  .zone {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 7px 12px;
    align-items: baseline;
  }
  .z-name {
    grid-row: 1;
    font-size: var(--text-sm);
    color: var(--ink);
    font-weight: 500;
  }
  .z-name em {
    font-style: normal;
    font-weight: 400;
    color: var(--ink-muted);
    margin-left: 8px;
  }
  .z-time {
    grid-row: 1;
    grid-column: 2;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
  }
  .z-bar {
    grid-row: 2;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 2px;
  }
  .z-bar i {
    height: 6px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .z-bar i.on {
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  .home .z-bar i.on {
    background: var(--accent-warm);
  }
  .z-now {
    position: absolute;
    top: 10px;
    bottom: 0;
    left: var(--now, 50%);
    width: 1px;
    background: var(--ink);
    opacity: 0.7;
  }
  .z-now::before {
    content: "";
    position: absolute;
    top: -3px;
    left: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }
  .z-key {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .z-key i {
    width: 14px;
    height: 6px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  .band {
    padding-top: var(--space-12);
  }
  .band-head {
    margin-bottom: var(--space-4);
  }
  .band-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  @media (min-width: 900px) {
    .split {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-8);
      align-items: start;
    }
    .split .band-head {
      position: sticky;
      top: 96px;
    }
  }

  .beliefs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px;
  }
  .beliefs li {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 22px 22px 20px;
    border-radius: 22px;
    background:
      radial-gradient(120% 70% at 100% 0%, color-mix(in srgb, var(--accent-warm) 7%, transparent), transparent 60%),
      var(--bg-raised);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 6%, transparent), 0 1px 2px rgb(0 0 0 / 0.04);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s;
  }
  .beliefs li:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 9%, transparent), 0 24px 44px -28px rgb(0 0 0 / 0.35);
  }
  .b-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: auto;
  }
  .b-num {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--ink-muted);
  }
  .b-art {
    width: 72px;
    height: 72px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .b-art .soft {
    stroke: var(--ink-muted);
    stroke-dasharray: 2 4;
  }
  .b-art .fill {
    fill: var(--accent-warm);
    stroke: none;
  }
  .b-art .soft-dot {
    fill: var(--ink-muted);
    stroke: none;
    opacity: 0.55;
  }
  .beliefs li:hover .b-art .soft {
    animation: dash 1.6s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -12;
    }
  }
  .belief {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 28px 0 8px;
  }
  .note {
    margin: 0 0 18px;
    color: var(--ink-secondary);
    font-size: var(--text-sm);
  }
  .proof-links {
    margin: 0;
    padding-top: 14px;
    border-top: 1px dashed color-mix(in srgb, var(--ink) 14%, transparent);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 12.5px;
  }
  .proof-links span {
    color: var(--ink-muted);
    width: 100%;
    font-size: 11.5px;
  }
  .proof-links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 25%, transparent);
    text-underline-offset: 3px;
  }
  .proof-links a:hover {
    text-decoration-color: var(--accent-warm);
  }
  @media (prefers-reduced-motion: reduce) {
    .beliefs li, .beliefs li:hover { transition: none; transform: none; }
    .beliefs li:hover .b-art .soft { animation: none; }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 36px 28px;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 0;
    text-decoration: none;
    color: var(--ink);
    scroll-margin-top: 96px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .card:hover {
    transform: none;
  }
  .card > span {
    padding: 0 2px;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .card-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
    margin-top: 6px;
  }
  .card-angle {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    margin: 6px 0 var(--space-2);
  }
  .card-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .rows {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .rows li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 96px;
  }
  .row-num {
    font-size: 12px;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .row-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }
  .row-leader {
    flex: 1;
    min-width: 16px;
    border-bottom: 1px dotted var(--ink-muted);
    opacity: 0.6;
    transform: translateY(-4px);
  }
  .row-tags {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .row-status {
    font-size: 12px;
    color: var(--ink-secondary);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 2px 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    white-space: nowrap;
  }
  .row-status.link {
    color: var(--ink);
    border-color: var(--ink);
  }
  @media (max-width: 620px) {
    .rows li {
      flex-wrap: wrap;
      row-gap: 4px;
    }
    .row-leader {
      display: none;
    }
    .row-name {
      flex: 1;
    }
    .row-tags {
      order: 5;
      flex-basis: 100%;
      padding-left: 30px;
    }
  }

  .tools {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: 34ch;
  }
  .ways,
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .ways li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-muted);
  }
  .way-num {
    width: 28px;
    height: 28px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--bg-raised);
    font-size: 12px;
    color: var(--ink);
  }
  .way-text {
    flex: 1;
    display: grid;
  }
  .way-text b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lg);
    color: var(--ink);
  }
  .way-text span {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
  .jobs li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .job-role {
    color: var(--ink);
    font-weight: 500;
  }
  .job-co {
    grid-column: 1;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }
  .job-dates {
